package com.edgechains.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.ComprehendClientBuilder;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Objects;

/**
 * Utility service using AWS Comprehend to detect and redact Personally Identifiable Information (PII).
 */
public class AwsComprehendRedactor implements AutoCloseable {

    public enum RedactionStrategy {
        /** Replaces PII with generic placeholder: [REDACTED] */
        GENERIC_MASK,
        /** Replaces PII with entity type placeholder: e.g., [NAME], [EMAIL], [SSN] */
        ENTITY_TYPE,
        /** Masks each character with asterisks (e.g., 'John' -> '****') */
        CHARACTER_MASK
    }

    private static final double DEFAULT_MIN_CONFIDENCE_SCORE = 0.5;
    private static final LanguageCode DEFAULT_LANGUAGE_CODE = LanguageCode.EN;

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "ComprehendClient must not be null");
        this.manageClientLifecycle = false;
    }

    public AwsComprehendRedactor(Region region) {
        this.comprehendClient = ComprehendClient.builder().region(region).build();
        this.manageClientLifecycle = true;
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        ComprehendClientBuilder builder = ComprehendClient.builder().region(region);
        if (credentialsProvider != null) {
            builder.credentialsProvider(credentialsProvider);
        }
        this.comprehendClient = builder.build();
        this.manageClientLifecycle = true;
    }

    /**
     * Redacts PII entities from the given text using default settings.
     *
     * @param text The source text containing sensitive data.
     * @return Redacted text.
     */
    public String redactPii(String text) {
        return redactPii(text, DEFAULT_LANGUAGE_CODE, DEFAULT_MIN_CONFIDENCE_SCORE, RedactionStrategy.GENERIC_MASK);
    }

    /**
     * Redacts PII entities from the given text using a specified redaction strategy.
     *
     * @param text     The source text containing sensitive data.
     * @param strategy The redaction replacement strategy.
     * @return Redacted text.
     */
    public String redactPii(String text, RedactionStrategy strategy) {
        return redactPii(text, DEFAULT_LANGUAGE_CODE, DEFAULT_MIN_CONFIDENCE_SCORE, strategy);
    }

    /**
     * Redacts PII entities from the text with customizable language, confidence threshold, and strategy.
     *
     * @param text               The source text containing sensitive data.
     * @param languageCode       The language code of the text (e.g., LanguageCode.EN).
     * @param minConfidenceScore Minimum entity detection score (0.0 to 1.0) required to apply redaction.
     * @param strategy           The replacement strategy.
     * @return Redacted text.
     */
    public String redactPii(String text, LanguageCode languageCode, double minConfidenceScore, RedactionStrategy strategy) {
        if (text == null || text.isBlank()) {
            return text;
        }

        List<PiiEntity> detectedEntities = detectPiiEntities(text, languageCode);
        if (detectedEntities.isEmpty()) {
            return text;
        }

        List<PiiEntity> sortedEntities = new ArrayList<>(detectedEntities);
        // Sort descending by begin offset to prevent offset shifting during replacements
        sortedEntities.sort((a, b) -> Integer.compare(b.beginOffset(), a.beginOffset()));

        StringBuilder redacted = new StringBuilder(text);
        int lastStart = Integer.MAX_VALUE;

        for (PiiEntity entity : sortedEntities) {
            if (entity.score() != null && entity.score() < minConfidenceScore) {
                continue;
            }

            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Guard against invalid or overlapping entity bounds
            if (start >= 0 && end <= redacted.length() && start <= end && end <= lastStart) {
                String replacement = resolveReplacement(entity, text.substring(start, end), strategy);
                redacted.replace(start, end, replacement);
                lastStart = start;
            }
        }

        return redacted.toString();
    }

    /**
     * Detects PII entities without modifying the text.
     *
     * @param text         The input text.
     * @param languageCode The language of the input text.
     * @return An unmodifiable list of detected PiiEntity records.
     */
    public List<PiiEntity> detectPiiEntities(String text, LanguageCode languageCode) {
        if (text == null || text.isBlank()) {
            return Collections.emptyList();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : DEFAULT_LANGUAGE_CODE)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.hasEntities() ? response.entities() : Collections.emptyList();
    }

    private String resolveReplacement(PiiEntity entity, String originalSubstring, RedactionStrategy strategy) {
        RedactionStrategy strat = strategy != null ? strategy : RedactionStrategy.GENERIC_MASK;
        return switch (strat) {
            case ENTITY_TYPE -> "[" + (entity.typeAsString() != null ? entity.typeAsString() : "PII") + "]";
            case CHARACTER_MASK -> "*".repeat(originalSubstring.length());
            case GENERIC_MASK -> "[REDACTED]";
        };
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
