#### `src/test/java/com/edgechains/lib/aws/AwsComprehendRedactorTest.java`
```java
package com.edgechains.lib.aws;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.*;

import java.util.List;
import java.util.Set;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class AwsComprehendRedactorTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        redactor = new AwsComprehendRedactor(comprehendClient);
    }

    @Test
    void testRedactWithEntityTag() {
        String input = "Contact John Doe at john@example.com for help.";
        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(8)
                .endOffset(16)
                .score(0.99f)
                .build();
        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(20)
                .endOffset(36)
                .score(0.95f)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(nameEntity, emailEntity)).build());

        String result = redactor.redact(input);
        assertEquals("Contact [NAME] at [EMAIL] for help.", result);
    }

    @Test
    void testRedactWithCustomPlaceholder() {
        String input = "Call 555-1234.";
        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(5)
                .endOffset(13)
                .score(0.90f)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(phoneEntity)).build());

        AwsComprehendRedactor.RedactionConfig config = AwsComprehendRedactor.RedactionConfig.builder()
                .maskStrategy(AwsComprehendRedactor.MaskStrategy.PLACEHOLDER)
                .defaultPlaceholder("[HIDDEN]")
                .build();

        String result = redactor.redact(input, config);
        assertEquals("Call [HIDDEN].", result);
    }

    @Test
    void testFilterByConfidenceScore() {
        String input = "Maybe SSN 123-45-6789.";
        PiiEntity lowConfidence = PiiEntity.builder()
                .type(PiiEntityType.SSN)
                .beginOffset(10)
                .endOffset(21)
                .score(0.40f)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(lowConfidence)).build());

        AwsComprehendRedactor.RedactionConfig config = AwsComprehendRedactor.RedactionConfig.builder()
                .minConfidenceScore(0.80f)
                .build();

        String result = redactor.redact(input, config);
        assertEquals(input, result);
    }

    @Test
    void testFilterByTargetEntityType() {
        String input = "John at john@example.com";
        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(0)
                .endOffset(4)
                .score(0.95f)
                .build();
        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(8)
                .endOffset(24)
                .score(0.95f)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(nameEntity, emailEntity)).build());

        AwsComprehendRedactor.RedactionConfig config = AwsComprehendRedactor.RedactionConfig.builder()
                .targetEntityTypes(Set.of(PiiEntityType.EMAIL))
                .build();

        String result = redactor.redact(input, config);
        assertEquals("John at [EMAIL]", result);
    }

    @Test
    void testNullAndEmptyText() {
        assertNull(redactor.redact(null));
        assertEquals("", redactor.redact(""));
        assertEquals("   ", redactor.redact("   "));
        verifyNoInteractions(comprehendClient);
    }
}
