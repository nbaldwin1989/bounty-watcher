// src/main/java/com/edgechains/lib/aws/comprehend/MaskingStrategy.java
package com.edgechains.lib.aws.comprehend;

public enum MaskingStrategy {
    /** Replaces entity with its type tag, e.g. [EMAIL], [NAME], [PHONE] */
    ENTITY_TAG,
    /** Replaces entity with generic [REDACTED] tag */
    REDACTED_TAG,
    /** Replaces entity characters with asterisks matching length, e.g. **** */
    ASTERISKS,
    /** Replaces entity with fixed '***' */
    FIXED_MASK
}
