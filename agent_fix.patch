package com.edgechains.lib.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean ownsClient;
    private final float scoreThreshold;

    public enum RedactionMode {
        ENTITY_TYPE, // Replaces with entity type tag, e.g., [EMAIL], [NAME]
        FIXED_MASK,   // Replaces with fixed string, e.g., [REDACTED]
        ASTERISKS     // Replaces matching characters with asterisks, e.g., ****
    }

    public AwsComprehendRedactor() {
        this(Region.US_EAST_1, DefaultCredentialsProvider.create(), 0.5f);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider, float scoreThreshold) {
        this.comprehendClient = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build();
        this.ownsClient = true;
        this.scoreThreshold = scoreThreshold;
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, float scoreThreshold) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.ownsClient = false;
        this.scoreThreshold = scoreThreshold;
    }

    /**
     * Redacts PII from text using default EN language and ENTITY_TYPE mode.
     */
    public String redact(String text) {
        return redact(text, LanguageCode.EN, RedactionMode.ENTITY_TYPE, "[REDACTED]");
    }

    /**
     * Redacts PII with specified language code and redaction mode.
     */
    public String redact(String text, LanguageCode languageCode, RedactionMode mode) {
        return redact(text, languageCode, mode, "[REDACTED]");
    }

    /**
     * Redacts PII with full configuration.
     *
     * @param text         Raw input text containing potential PII.
     * @param languageCode Language of the input text.
     * @param mode         Strategy to use for replacing detected entities.
     * @param customMask   Fallback mask string when FIXED_MASK mode is used.
     * @return Redacted text.
     */
    public String redact(String text, LanguageCode languageCode, RedactionMode mode, String customMask) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = new ArrayList<>(response.entities());

        // Filter entities by confidence threshold
        entities.removeIf(entity -> entity.score() != null && entity.score() < this.scoreThreshold);

        // Sort descending by beginOffset to safely replace substrings without shifting indices
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder redacted = new StringBuilder(text);
        int lastProcessedBeginOffset = Integer.MAX_VALUE;

        for (PiiEntity entity : entities) {
            int begin = entity.beginOffset();
            int end = entity.endOffset();

            // Guard against out-of-bounds or overlapping spans
            if (begin < 0 || end > redacted.length() || begin >= end) {
                continue;
            }
            if (end > lastProcessedBeginOffset) {
                continue; // Skip overlapping entities to avoid corrupting text
            }

            String replacement;
            switch (mode) {
                case ENTITY_TYPE:
                    replacement = "[" + entity.typeAsString() + "]";
                    break;
                case ASTERISKS:
                    replacement = "*".repeat(end - begin);
                    break;
                case FIXED_MASK:
                default:
                    replacement = (customMask != null) ? customMask : "[REDACTED]";
                    break;
            }

            redacted.replace(begin, end, replacement);
            lastProcessedBeginOffset = begin;
        }

        return redacted.toString();
    }

    @Override
    public void close() {
        if (ownsClient && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
