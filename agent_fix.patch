package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.ComprehendException;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.io.Closeable;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;

/**
 * Utility service to detect and redact Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactionService implements Closeable {

    public enum RedactionMode {
        REDACTED_LABEL, // Replaces with [REDACTED]
        ENTITY_TYPE,    // Replaces with [NAME], [EMAIL], [SSN], etc.
        MASK_CHARACTER  // Replaces characters with maskChar (e.g. *)
    }

    private final ComprehendClient comprehendClient;
    private final LanguageCode defaultLanguageCode;
    private final float defaultScoreThreshold;

    public AwsComprehendRedactionService() {
        this(Region.US_EAST_1);
    }

    public AwsComprehendRedactionService(Region region) {
        this(region, DefaultCredentialsProvider.create());
    }

    public AwsComprehendRedactionService(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build());
    }

    public AwsComprehendRedactionService(ComprehendClient comprehendClient) {
        this(comprehendClient, LanguageCode.EN, 0.75f);
    }

    public AwsComprehendRedactionService(ComprehendClient comprehendClient, LanguageCode languageCode, float scoreThreshold) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.defaultLanguageCode = Objects.requireNonNull(languageCode, "languageCode must not be null");
        this.defaultScoreThreshold = scoreThreshold;
    }

    /**
     * Redacts PII entities in the given text using default entity type labels.
     *
     * @param text The source text containing potential PII.
     * @return Redacted text.
     */
    public String redactPii(String text) {
        return redactPii(text, this.defaultLanguageCode, RedactionMode.ENTITY_TYPE, '*', this.defaultScoreThreshold);
    }

    /**
     * Redacts PII entities in the given text with configurable options.
     *
     * @param text           Source text.
     * @param languageCode   Language of the text (e.g., LanguageCode.EN).
     * @param mode           Redaction replacement strategy.
     * @param maskChar       Character to use if MASK_CHARACTER mode is selected.
     * @param scoreThreshold Minimum confidence score (0.0 to 1.0) to qualify for redaction.
     * @return Redacted text.
     */
    public String redactPii(String text, LanguageCode languageCode, RedactionMode mode, char maskChar, float scoreThreshold) {
        if (text == null || text.isBlank()) {
            return text;
        }

        try {
            DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                    .text(text)
                    .languageCode(languageCode)
                    .build();

            DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
            List<PiiEntity> entities = response.entities();

            if (entities == null || entities.isEmpty()) {
                return text;
            }

            // Filter by confidence score and sort in descending order of beginOffset
            // to preserve character offsets while applying replacements.
            List<PiiEntity> sortedEntities = new ArrayList<>(entities.stream()
                    .filter(e -> e.score() != null && e.score() >= scoreThreshold)
                    .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                    .toList());

            StringBuilder sb = new StringBuilder(text);
            int lastRedactedBegin = Integer.MAX_VALUE;

            for (PiiEntity entity : sortedEntities) {
                int start = entity.beginOffset();
                int end = entity.endOffset();

                // Prevent index out of bounds or overlapping entity corruption
                if (start < 0 || end > sb.length() || start >= end || end > lastRedactedBegin) {
                    continue;
                }

                String replacement;
                switch (mode) {
                    case REDACTED_LABEL -> replacement = "[REDACTED]";
                    case ENTITY_TYPE -> replacement = "[" + entity.typeAsString() + "]";
                    case MASK_CHARACTER -> replacement = String.valueOf(maskChar).repeat(end - start);
                    default -> replacement = "[REDACTED]";
                }

                sb.replace(start, end, replacement);
                lastRedactedBegin = start;
            }

            return sb.toString();
        } catch (ComprehendException e) {
            throw new RuntimeException("AWS Comprehend PII detection failed: " + e.awsErrorDetails().errorMessage(), e);
        }
    }

    @Override
    public void close() {
        if (comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
