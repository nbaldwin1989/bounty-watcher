package com.edgechains.lib.aws;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Arrays;
import java.util.Set;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactionUtilTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactionUtil redactionUtil;
    private AutoCloseable mocks;

    @BeforeEach
    void setUp() {
        mocks = MockitoAnnotations.openMocks(this);
        redactionUtil = new AwsComprehendRedactionUtil(comprehendClient);
    }

    @AfterEach
    void tearDown() throws Exception {
        mocks.close();
    }

    @Test
    void testRedactWithEntityTypeMask() {
        String input = "My email is test@example.com and phone is 123-456-7890.";

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(12)
                .endOffset(28)
                .score(0.99f)
                .build();

        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(42)
                .endOffset(54)
                .score(0.95f)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder()
                        .entities(Arrays.asList(emailEntity, phoneEntity))
                        .build());

        String result = redactionUtil.redact(input);
        assertEquals("My email is [EMAIL] and phone is [PHONE].", result);
    }

    @Test
    void testRedactFilteredTypesOnly() {
        String input = "Contact John Doe at john@example.com.";

        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(8)
                .endOffset(16)
                .score(0.98f)
                .build();

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(20)
                .endOffset(36)
                .score(0.99f)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder()
                        .entities(Arrays.asList(nameEntity, emailEntity))
                        .build());

        String result = redactionUtil.redact(input, LanguageCode.EN, Set.of(PiiEntityType.EMAIL), 0.5,
                AwsComprehendRedactionUtil.RedactionMode.GENERIC_LABEL);

        assertEquals("Contact John Doe at [REDACTED].", result);
    }
}
