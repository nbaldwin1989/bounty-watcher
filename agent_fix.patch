```javascript
// index.js
import { Octokit } from "@octokit/rest";

const GITHUB_TOKEN = process.env.GITHUB_TOKEN;
const GITHUB_REPOSITORY = process.env.GITHUB_REPOSITORY;
const USERNAME = process.env.ALGORA_USER || process.env.GITHUB_USER || GITHUB_REPOSITORY?.split("/")[0];
const ALGORA_API_URL = process.env.ALGORA_API_URL || "https://api.algora.io/bounties";

if (!GITHUB_TOKEN || !GITHUB_REPOSITORY) {
  console.error("Missing required environment variables: GITHUB_TOKEN, GITHUB_REPOSITORY");
  process.exit(1);
}

const [owner, repo] = GITHUB_REPOSITORY.split("/");
const octokit = new Octokit({ auth: GITHUB_TOKEN });

const TAG_REGEX = /<!--\s*algora:([a-zA-Z0-9_\-]+)\s*-->/g;

async function fetchTrackedBountyIds() {
  const trackedIds = new Set();
  let page = 1;
  const perPage = 100;

  // Retrieve all existing issues (open and closed) to prevent duplicates
  while (true) {
    const { data: issues } = await octokit.rest.issues.listForRepo({
      owner,
      repo,
      state: "all",
      per_page: perPage,
      page,
    });

    for (const issue of issues) {
      if (issue.pull_request) continue;
      if (!issue.body) continue;

      let match;
      while ((match = TAG_REGEX.exec(issue.body)) !== null) {
        trackedIds.add(match[1]);
      }
    }

    if (issues.length < perPage) break;
    page++;
  }

  return trackedIds;
}

async function fetchOpenBounties() {
  const response = await fetch(ALGORA_API_URL);
  if (!response.ok) {
    throw new Error(`Failed to fetch bounties from Algora: ${response.status} ${response.statusText}`);
  }
  const data = await response.json();
  const bounties = Array.isArray(data) ? data : data.items || data.bounties || [];
  return bounties.filter((b) => b.status === "open" || b.state === "open" || !b.status);
}

function formatReward(bounty) {
  if (bounty.reward_formatted) return bounty.reward_formatted;
  if (typeof bounty.amount === "number") return `$${bounty.amount / 100}`;
  if (bounty.amount) return `$${bounty.amount}`;
  return "Bounty";
}

function getBountyId(bounty) {
  return String(bounty.id || bounty.slug || bounty.issue_id);
}

function getBountyUrl(bounty) {
  return bounty.url || bounty.html_url || bounty.issue_url || "";
}

async function run() {
  const trackedIds = await fetchTrackedBountyIds();
  const openBounties = await fetchOpenBounties();

  const isFirstRun = trackedIds.size === 0;

  if (isFirstRun) {
    if (openBounties.length === 0) {
      console.log("First run, but no open bounties found.");
      return;
    }

    console.log(`First run: Initializing with ${openBounties.length} open bounties.`);

    const bountyLines = openBounties.map((b) => {
      const reward = formatReward(b);
      const url = getBountyUrl(b);
      return `- 🔴 **${reward}** · [${b.title}](${url})`;
    });

    const tags = openBounties.map((b) => `<!-- algora:${getBountyId(b)} -->`);
    const mention = USERNAME ? `\n\ncc @${USERNAME}` : "";

    const body = [
      "Bounties that were already open when the watcher started. From now on, each new one gets its own issue.\n",
      bountyLines.join("\n"),
      mention,
      "\n" + tags.join("\n"),
    ].join("");

    await octokit.rest.issues.create({
      owner,
      repo,
      title: "Open bounties",
      body,
    });

    console.log("Created initial summary issue.");
    return;
  }

  // Subsequent runs: Create individual issues for newly discovered bounties
  const newBounties = openBounties.filter((b) => !trackedIds.has(getBountyId(b)));

  console.log(`Found ${newBounties.length} new bounties.`);

  for (const bounty of newBounties) {
    const reward = formatReward(bounty);
    const url = getBountyUrl(bounty);
    const id = getBountyId(bounty);
    const mention = USERNAME ? `\n\ncc @${USERNAME}` : "";

    const title = `[${reward}] ${bounty.title}`;
    const body = [
      `### [${bounty.title}](${url})\n`,
      `Reward: **${reward}**\n`,
      bounty.description ? `${bounty.description}\n` : "",
      mention,
      `\n<!-- algora:${id} -->`,
    ].join("");

    await octokit.rest.issues.create({
      owner,
      repo,
      title,
      body,
    });

    console.log(`Created issue for bounty: ${title}`);
  }
}

run().catch((error) => {
  console.error("Watcher failed:", error);
  process.exit(1);
});
