package com.edgechains.lib.aws;

import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.io.Closeable;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.stream.Collectors;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements Closeable {

    private final ComprehendClient comprehendClient;
    private final RedactionConfig config;
    private final boolean ownsClient;

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder().region(Region.US_EAST_1).build(), RedactionConfig.defaultConfig(), true);
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), RedactionConfig.defaultConfig(), true);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, RedactionConfig.defaultConfig(), false);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, RedactionConfig config) {
        this(comprehendClient, config, false);
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, RedactionConfig config, boolean ownsClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.config = config != null ? config : RedactionConfig.defaultConfig();
        this.ownsClient = ownsClient;
    }

    /**
     * Redacts PII from text using the default configured language.
     *
     * @param text Raw input text
     * @return Redacted text
     */
    public String redact(String text) {
        return redact(text, config.getDefaultLanguageCode(), this.config);
    }

    /**
     * Redacts PII from text with explicit language code.
     *
     * @param text         Raw input text
     * @param languageCode ISO language code (e.g., "en", "es")
     * @return Redacted text
     */
    public String redact(String text, String languageCode) {
        return redact(text, languageCode, this.config);
    }

    /**
     * Redacts PII from text using custom redaction configuration.
     *
     * @param text            Raw input text
     * @param languageCode    ISO language code
     * @param overrideConfig  Per-request configuration overrides
     * @return Redacted text
     */
    public String redact(String text, String languageCode, RedactionConfig overrideConfig) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        RedactionConfig activeConfig = overrideConfig != null ? overrideConfig : this.config;
        List<PiiEntity> entities = detectEntities(text, languageCode);
        return applyRedaction(text, entities, activeConfig);
    }

    /**
     * Detects PII entities without modifying the input text.
     *
     * @param text         Raw input text
     * @param languageCode ISO language code
     * @return Detected entities matching criteria
     */
    public List<PiiEntity> detectEntities(String text, String languageCode) {
        if (text == null || text.isEmpty()) {
            return List.of();
        }

        String lang = (languageCode != null && !languageCode.isBlank())
                ? languageCode
                : config.getDefaultLanguageCode();

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(lang)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.entities();
    }

    private String applyRedaction(String text, List<PiiEntity> entities, RedactionConfig cfg) {
        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by confidence threshold and specified entity types
        List<PiiEntity> filtered = entities.stream()
                .filter(e -> e.score() != null && e.score() >= cfg.getMinScoreThreshold())
                .filter(e -> cfg.getTargetEntityTypes().isEmpty() || cfg.getTargetEntityTypes().contains(e.type()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset))
                .collect(Collectors.toList());

        if (filtered.isEmpty()) {
            return text;
        }

        // Merge overlapping or nested spans
        List<PiiEntity> nonOverlapping = resolveOverlaps(filtered);

        StringBuilder sb = new StringBuilder();
        int currentIndex = 0;

        for (PiiEntity entity : nonOverlapping) {
            int start = Math.max(0, entity.beginOffset());
            int end = Math.min(text.length(), entity.endOffset());

            if (start > currentIndex) {
                sb.append(text, currentIndex, start);
            }

            int entityLength = end - start;
            String replacement = createMask(entity, entityLength, cfg);
            sb.append(replacement);
            currentIndex = end;
        }

        if (currentIndex < text.length()) {
            sb.append(text.substring(currentIndex));
        }

        return sb.toString();
    }

    private List<PiiEntity> resolveOverlaps(List<PiiEntity> sortedEntities) {
        List<PiiEntity> result = new ArrayList<>();
        PiiEntity previous = null;

        for (PiiEntity current : sortedEntities) {
            if (previous == null) {
                result.add(current);
                previous = current;
                continue;
            }

            if (current.beginOffset() >= previous.endOffset()) {
                result.add(current);
                previous = current;
            } else if (current.score() > previous.score()) {
                // Higher confidence replaces previous overlapping entity
                result.remove(result.size() - 1);
                result.add(current);
                previous = current;
            }
        }
        return result;
    }

    private String createMask(PiiEntity entity, int length, RedactionConfig cfg) {
        switch (cfg.getMode()) {
            case FIXED_MASK:
                return cfg.getCustomMask();
            case ASTERISK:
                return "*".repeat(Math.max(1, length));
            case ENTITY_TYPE:
            default:
                String typeName = entity.typeAsString() != null ? entity.typeAsString() : "PII";
                return "[" + typeName + "]";
        }
    }

    @Override
    public void close() {
        if (ownsClient && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
