package com.edgechains.lib.aws;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;
import java.util.Set;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class AwsComprehendRedactorTest {

    @Mock
    private ComprehendClient mockClient;

    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        redactor = new AwsComprehendRedactor(mockClient, RedactionConfig.defaultConfig());
    }

    @Test
    void testRedactWithEntityTypeMode() {
        String input = "My name is John Doe and my email is john@example.com.";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(11).endOffset(19).score(0.99f).type(PiiEntityType.NAME).build(),
                PiiEntity.builder().beginOffset(36).endOffset(52).score(0.98f).type(PiiEntityType.EMAIL).build()
        );

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        String result = redactor.redact(input);
        assertEquals("My name is [NAME] and my email is [EMAIL].", result);
    }

    @Test
    void testRedactWithFixedMask() {
        String input = "Contact: john@example.com";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(9).endOffset(25).score(0.95f).type(PiiEntityType.EMAIL).build()
        );

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        RedactionConfig config = RedactionConfig.builder()
                .mode(RedactionMode.FIXED_MASK)
                .customMask("###REDACTED###")
                .build();

        String result = redactor.redact(input, "en", config);
        assertEquals("Contact: ###REDACTED###", result);
    }

    @Test
    void testFilterByConfidenceScore() {
        String input = "Call 555-0199 or visit website.";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(5).endOffset(13).score(0.40f).type(PiiEntityType.PHONE_NUMBER).build()
        );

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        RedactionConfig config = RedactionConfig.builder().minScoreThreshold(0.80f).build();
        String result = redactor.redact(input, "en", config);

        // Low confidence entity should remain untouched
        assertEquals(input, result);
    }

    @Test
    void testTargetEntityTypesOnly() {
        String input = "Alice's SSN is 000-12-3456.";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(0).endOffset(5).score(0.95f).type(PiiEntityType.NAME).build(),
                PiiEntity.builder().beginOffset(15).endOffset(26).score(0.99f).type(PiiEntityType.SSN).build()
        );

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        RedactionConfig config = RedactionConfig.builder()
                .targetEntityTypes(Set.of(PiiEntityType.SSN))
                .build();

        String result = redactor.redact(input, "en", config);
        assertEquals("Alice's SSN is [SSN].", result);
    }
}
