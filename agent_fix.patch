package com.edgechains.lib.aws.comprehend;

import java.util.Collections;
import java.util.List;

public class RedactionResult {

    private final String originalText;
    private final String redactedText;
    private final List<RedactedEntityInfo> redactedEntities;

    public RedactionResult(String originalText, String redactedText, List<RedactedEntityInfo> redactedEntities) {
        this.originalText = originalText;
        this.redactedText = redactedText;
        this.redactedEntities = Collections.unmodifiableList(redactedEntities);
    }

    public String getOriginalText() {
        return originalText;
    }

    public String getRedactedText() {
        return redactedText;
    }

    public List<RedactedEntityInfo> getRedactedEntities() {
        return redactedEntities;
    }

    public boolean hasRedactions() {
        return !redactedEntities.isEmpty();
    }
}
