### 1. Solution for `arakoodev/EdgeChains#290`: AWS Comprehend Data Redaction Utility

#### `edgechains/libraries/com.edgechains.lib/src/main/java/com/edgechains/lib/aws/AWSComprehendRedactor.java`
```java
package com.edgechains.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.stream.Collectors;

public class AWSComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;

    public enum RedactionMaskMode {
        MASK_CHAR,     // Replace characters with a mask character (e.g., ***)
        ENTITY_TYPE,   // Replace entity with [TYPE] (e.g., [EMAIL], [SSN])
        FIXED_LABEL    // Replace entity with fixed string (e.g., [REDACTED])
    }

    public AWSComprehendRedactor() {
        this(DefaultCredentialsProvider.create(), Region.US_EAST_1);
    }

    public AWSComprehendRedactor(Region region) {
        this(DefaultCredentialsProvider.create(), region);
    }

    public AWSComprehendRedactor(AwsCredentialsProvider credentialsProvider, Region region) {
        this.comprehendClient = ComprehendClient.builder()
                .credentialsProvider(credentialsProvider)
                .region(region)
                .build();
    }

    public AWSComprehendRedactor(ComprehendClient comprehendClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
    }

    public List<PiiEntity> detectPiiEntities(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return List.of();
        }
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : LanguageCode.EN)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.entities();
    }

    public String redactPii(String text) {
        return redactPii(text, LanguageCode.EN, RedactionMaskMode.ENTITY_TYPE, '*');
    }

    public String redactPii(String text, LanguageCode languageCode, RedactionMaskMode mode, char maskChar) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        List<PiiEntity> entities = detectPiiEntities(text, languageCode);
        if (entities.isEmpty()) {
            return text;
        }

        // Sort descending by beginOffset so string replacements do not affect earlier offsets
        List<PiiEntity> sortedEntities = entities.stream()
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder redacted = new StringBuilder(text);

        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start < 0 || end > redacted.length() || start >= end) {
                continue;
            }

            String replacement;
            switch (mode) {
                case ENTITY_TYPE:
                    replacement = "[" + entity.typeAsString() + "]";
                    break;
                case FIXED_LABEL:
                    replacement = "[REDACTED]";
                    break;
                case MASK_CHAR:
                default:
                    replacement = String.valueOf(maskChar).repeat(end - start);
                    break;
            }

            redacted.replace(start, end, replacement);
        }

        return redacted.toString();
    }

    @Override
    public void close() {
        if (this.comprehendClient != null) {
            this.comprehendClient.close();
        }
    }
}
```

#### `edgechains/libraries/com.edgechains.lib/src/test/java/com/edgechains/lib/aws/AWSComprehendRedactorTest.java`
```java
package com.edgechains.lib.aws;

import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

public class AWSComprehendRedactorTest {

    @Test
    public void testRedactPiiWithEntityType() {
        ComprehendClient mockClient = Mockito.mock(ComprehendClient.class);
        String input = "Hello, my email is test@example.com and phone is 555-0199.";

        PiiEntity emailEntity = PiiEntity.builder()
                .beginOffset(19)
                .endOffset(35)
                .type(PiiEntityType.EMAIL)
                .build();

        PiiEntity phoneEntity = PiiEntity.builder()
                .beginOffset(50)
                .endOffset(58)
                .type(PiiEntityType.PHONE)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(emailEntity, phoneEntity))
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        AWSComprehendRedactor redactor = new AWSComprehendRedactor(mockClient);
        String result = redactor.redactPii(input, LanguageCode.EN, AWSComprehendRedactor.RedactionMaskMode.ENTITY_TYPE, '*');

        assertEquals("Hello, my email is [EMAIL] and phone is [PHONE].", result);
    }
}
