package com.edgechains.lib.utils.aws;

public enum RedactionStrategy {
    /** Replaces entity with generic "[REDACTED]" */
    GENERIC_LABEL,
    /** Replaces entity with entity type label, e.g., "[NAME]", "[SSN]", "[EMAIL]" */
    ENTITY_TYPE_LABEL,
    /** Replaces entity characters with asterisks matching original length */
    ASTERISKS
}
