"""
AWS Comprehend PII Redaction Utility & Bounty Watcher Individual Issue Splitter
"""

import re
from typing import Optional, List, Dict
import boto3
from botocore.config import Config


class ComprehendRedactor:
    """Utility to redact sensitive / PII data using AWS Comprehend."""

    def __init__(self, region_name: str = "us-east-1", language_code: str = "en"):
        self.language_code = language_code
        self.client = boto3.client(
            "comprehend",
            region_name=region_name,
            config=Config(retries={"max_attempts": 3, "mode": "standard"}),
        )

    def redact(self, text: str, mask: Optional[str] = "[REDACTED]") -> str:
        if not text or not text.strip():
            return text

        response = self.client.detect_pii_entities(
            Text=text,
            LanguageCode=self.language_code,
        )

        entities = response.get("Entities", [])
        if not entities:
            return text

        # Sort descending by BeginOffset to replace without invalidating remaining offsets
        entities.sort(key=lambda e: e["BeginOffset"], reverse=True)

        redacted = list(text)
        for entity in entities:
            start = entity["BeginOffset"]
            end = entity["EndOffset"]
            replacement = mask if mask is not None else f"[{entity['Type']}]"
            redacted[start:end] = list(replacement)

        return "".join(redacted)


class BountyWatcher:
    """
    Parses bundled watcher issues and emits separate individual issues per bounty.
    """

    BOUNTY_REGEX = re.compile(
        r"[-*]\s*(?:🔴|🟢|🟡)?\s*\*\*([^\*]+)\*\*\s*[·-]\s*\[([^\]]+)\]\((https?://[^\)]+)\)",
        re.MULTILINE,
    )

    @staticmethod
    def extract_bounties(issue_body: str) -> List[Dict[str, str]]:
        bounties = []
        for match in BountyWatcher.BOUNTY_REGEX.finditer(issue_body):
            reward, title, url = match.groups()
            bounties.append({
                "reward": reward.strip(),
                "title": title.strip(),
                "url": url.strip(),
            })
        return bounties

    @staticmethod
    def create_individual_issue_payload(bounty: Dict[str, str], cc_handle: Optional[str] = None) -> Dict[str, str]:
        title = f"{bounty['reward']} · {bounty['title']}"
        body = f"### Bounty Details\n\n- **Reward:** {bounty['reward']}\n- **Original Issue:** {bounty['url']}\n"
        if cc_handle:
            body += f"\ncc @{cc_handle.lstrip('@')}\n"
        return {"title": title, "body": body}
