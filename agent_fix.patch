package com.edgechains.lib.utils.aws;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class AwsComprehendRedactorTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        redactor = new AwsComprehendRedactor(comprehendClient);
    }

    @AfterEach
    void tearDown() {
        redactor.close();
    }

    @Test
    void shouldRedactPiiWithDefaultEntityTypeTag() {
        String input = "Contact John Doe at john.doe@example.com immediately.";

        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .score(0.99f)
                .beginOffset(8)
                .endOffset(16)
                .build();

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .score(0.99f)
                .beginOffset(20)
                .endOffset(40)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder()
                        .entities(List.of(nameEntity, emailEntity))
                        .build());

        String result = redactor.redact(input);
        assertEquals("Contact [NAME] at [EMAIL] immediately.", result);
    }

    @Test
    void shouldRedactWithCustomFixedMask() {
        String input = "My phone is 555-0199.";

        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .score(0.95f)
                .beginOffset(12)
                .endOffset(20)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder()
                        .entities(List.of(phoneEntity))
                        .build());

        AwsComprehendRedactor.RedactionConfig config = AwsComprehendRedactor.RedactionConfig.defaultConfig()
                .maskMode(AwsComprehendRedactor.RedactionMaskMode.FIXED_STRING)
                .fixedMask("###");

        String result = redactor.redact(input, config);
        assertEquals("My phone is ###.", result);
    }

    @Test
    void shouldIgnoreEntitiesBelowThreshold() {
        String input = "Low confidence token.";

        PiiEntity lowConfidence = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .score(0.35f)
                .beginOffset(0)
                .endOffset(14)
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder()
                        .entities(List.of(lowConfidence))
                        .build());

        AwsComprehendRedactor.RedactionConfig config = AwsComprehendRedactor.RedactionConfig.defaultConfig()
                .minScoreThreshold(0.80f);

        String result = redactor.redact(input, config);
        assertEquals(input, result);
    }
}
