package com.edgechains.lib.aws;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;
import java.util.Set;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

public class AwsComprehendRedactorTest {

    private ComprehendClient mockClient;
    private AwsComprehendRedactor redactor;

    @BeforeEach
    public void setUp() {
        mockClient = Mockito.mock(ComprehendClient.class);
        redactor = new AwsComprehendRedactor(mockClient);
    }

    @AfterEach
    public void tearDown() {
        redactor.close();
    }

    @Test
    public void testRedactWithEntityType() {
        String input = "My email is test@example.com and phone is 123-456-7890.";

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(12)
                .endOffset(28)
                .score(0.99f)
                .build();

        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(42)
                .endOffset(54)
                .score(0.98f)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(emailEntity, phoneEntity)).build());

        String result = redactor.redact(input);
        assertEquals("My email is [EMAIL] and phone is [PHONE].", result);
    }

    @Test
    public void testRedactWithFixedMask() {
        String input = "Hello John Doe!";

        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(6)
                .endOffset(14)
                .score(0.95f)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(nameEntity)).build());

        String result = redactor.redact(input, "[REDACTED]");
        assertEquals("Hello [REDACTED]!", result);
    }

    @Test
    public void testFilterByTargetEntityType() {
        String input = "John at test@example.com";

        PiiEntity name = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(0)
                .endOffset(4)
                .score(0.99f)
                .build();

        PiiEntity email = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(8)
                .endOffset(24)
                .score(0.99f)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(name, email)).build());

        String result = redactor.redact(
                input,
                null,
                AwsComprehendRedactor.MaskMode.FIXED_STRING,
                "***",
                Set.of("EMAIL")
        );

        assertEquals("John at ***", result);
    }
}
