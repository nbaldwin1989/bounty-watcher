```java
package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.ComprehendException;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.function.Function;
import java.util.stream.Collectors;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactionUtil implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean managesClientLifecycle;
    private final float defaultConfidenceThreshold;

    public enum RedactionMaskMode {
        /** Replaces PII with generic tag: [REDACTED] */
        GENERIC_TAG,
        /** Replaces PII with entity type tag: [NAME], [EMAIL], [SSN], etc. */
        ENTITY_TYPE_TAG,
        /** Masks characters with asterisks: ***** */
        ASTERISK_MASK
    }

    public AwsComprehendRedactionUtil(ComprehendClient comprehendClient) {
        this(comprehendClient, 0.5f, false);
    }

    public AwsComprehendRedactionUtil(Region region, String accessKeyId, String secretAccessKey) {
        this(
            ComprehendClient.builder()
                .region(region)
                .credentialsProvider(StaticCredentialsProvider.create(
                    AwsBasicCredentials.create(accessKeyId, secretAccessKey)
                ))
                .build(),
            0.5f,
            true
        );
    }

    public AwsComprehendRedactionUtil(ComprehendClient comprehendClient, float defaultConfidenceThreshold, boolean managesClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "ComprehendClient must not be null");
        this.defaultConfidenceThreshold = defaultConfidenceThreshold;
        this.managesClientLifecycle = managesClientLifecycle;
    }

    /**
     * Redacts PII in the given text using default English language, 0.5 threshold, and ENTITY_TYPE_TAG mode.
     */
    public String redact(String text) {
        return redact(text, LanguageCode.EN, RedactionMaskMode.ENTITY_TYPE_TAG, this.defaultConfidenceThreshold);
    }

    /**
     * Redacts PII in the given text using the specified mask mode and language.
     */
    public String redact(String text, LanguageCode languageCode, RedactionMaskMode maskMode, float minConfidence) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        Function<PiiEntity, String> maskFunction = entity -> {
            switch (maskMode) {
                case GENERIC_TAG:
                    return "[REDACTED]";
                case ASTERISK_MASK:
                    int length = entity.endOffset() - entity.beginOffset();
                    return String.join("", Collections.nCopies(Math.max(1, length), "*"));
                case ENTITY_TYPE_TAG:
                default:
                    return "[" + entity.typeAsString() + "]";
            }
        };

        return redactWithCustomMask(text, languageCode, minConfidence, maskFunction);
    }

    /**
     * Redacts PII using a custom masking function.
     */
    public String redactWithCustomMask(String text, LanguageCode languageCode, float minConfidence, Function<PiiEntity, String> maskFunction) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        List<PiiEntity> detectedEntities = detectPiiEntities(text, languageCode, minConfidence);
        if (detectedEntities.isEmpty()) {
            return text;
        }

        // Sort descending by beginOffset to replace from end to beginning without invalidating character indices
        List<PiiEntity> sortedEntities = detectedEntities.stream()
            .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
            .collect(Collectors.toList());

        StringBuilder redacted = new StringBuilder(text);
        int previousStart = Integer.MAX_VALUE;

        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Validate boundaries and prevent overlapping replacements
            if (start >= 0 && end <= redacted.length() && start <= end && end <= previousStart) {
                String replacement = maskFunction.apply(entity);
                redacted.replace(start, end, replacement);
                previousStart = start;
            }
        }

        return redacted.toString();
    }

    /**
     * Detects PII entities exceeding the minimum confidence score.
     */
    public List<PiiEntity> detectPiiEntities(String text, LanguageCode languageCode, float minConfidence) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }

        try {
            DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

            DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
            if (!response.hasEntities()) {
                return Collections.emptyList();
            }

            return response.entities().stream()
                .filter(entity -> entity.score() != null && entity.score() >= minConfidence)
                .collect(Collectors.toList());
        } catch (ComprehendException e) {
            throw new RuntimeException("Failed to detect PII entities via AWS Comprehend: " + e.awsErrorDetails().errorMessage(), e);
        }
    }

    @Override
    public void close() {
        if (managesClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
