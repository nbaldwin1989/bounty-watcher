### 1. EdgeChains: AWS Comprehend PII Data Redaction Utility

#### `pom.xml` (Dependency Addition)
```xml
<dependency>
    <groupId>software.amazon.awssdk</groupId>
    <artifactId>comprehend</artifactId>
    <version>2.25.16</version>
</dependency>
```

#### `src/main/java/com/edgechains/lib/utils/AwsComprehendRedactor.java`
```java
package com.edgechains.lib.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Comparator;
import java.util.List;
import java.util.stream.Collectors;

public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final float minScoreThreshold;

    public enum MaskMode {
        TAG_NAME,    // Replaces with [EMAIL], [NAME], etc.
        ASTERISK,    // Replaces with *******
        FIXED_MASK   // Replaces with [REDACTED]
    }

    public AwsComprehendRedactor() {
        this(Region.US_EAST_1, DefaultCredentialsProvider.create(), 0.8f);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider, float minScoreThreshold) {
        this.comprehendClient = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build();
        this.minScoreThreshold = minScoreThreshold;
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, float minScoreThreshold) {
        this.comprehendClient = comprehendClient;
        this.minScoreThreshold = minScoreThreshold;
    }

    public String redact(String text) {
        return redact(text, LanguageCode.EN, MaskMode.TAG_NAME);
    }

    public String redact(String text, LanguageCode languageCode, MaskMode maskMode) {
        if (text == null || text.isBlank()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);

        List<PiiEntity> entities = response.entities().stream()
                .filter(entity -> entity.score() != null && entity.score() >= minScoreThreshold)
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder redacted = new StringBuilder(text);

        for (PiiEntity entity : entities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start < 0 || end > redacted.length() || start >= end) {
                continue;
            }

            String replacement;
            switch (maskMode) {
                case ASTERISK:
                    replacement = "*".repeat(end - start);
                    break;
                case FIXED_MASK:
                    replacement = "[REDACTED]";
                    break;
                case TAG_NAME:
                default:
                    replacement = "[" + entity.typeAsString() + "]";
                    break;
            }

            redacted.replace(start, end, replacement);
        }

        return redacted.toString();
    }

    @Override
    public void close() {
        if (comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
```

