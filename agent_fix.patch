// File: src/main/java/com/edgechains/lib/comprehend/AwsComprehendRedactor.java

package com.edgechains.lib.comprehend;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.*;
import java.util.stream.Collectors;

/**
 * Utility to detect and redact Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final float defaultMinScore;
    private final LanguageCode defaultLanguage;

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(Region.US_EAST_1)
                .build(), 0.5f, LanguageCode.EN);
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(region)
                .build(), 0.5f, LanguageCode.EN);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .credentialsProvider(credentialsProvider)
                .region(region)
                .build(), 0.5f, LanguageCode.EN);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, float defaultMinScore, LanguageCode defaultLanguage) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.defaultMinScore = defaultMinScore;
        this.defaultLanguage = Objects.requireNonNull(defaultLanguage, "defaultLanguage must not be null");
    }

    public enum RedactionStrategy {
        LABEL,          // Replace with [REDACTED_TYPE], e.g. [REDACTED_SSN]
        MASK,           // Replace with fixed mask '***'
        CHARACTER_MASK  // Replace characters with '*' keeping the same length
    }

    public static class RedactionOptions {
        private float minConfidence = 0.5f;
        private LanguageCode languageCode = LanguageCode.EN;
        private RedactionStrategy strategy = RedactionStrategy.LABEL;
        private Set<PiiEntityType> targetTypes = Collections.emptySet(); // Empty = redact all detected
        private String customMask = null;

        public static RedactionOptions create() {
            return new RedactionOptions();
        }

        public RedactionOptions minConfidence(float minConfidence) {
            this.minConfidence = minConfidence;
            return this;
        }

        public RedactionOptions languageCode(LanguageCode languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public RedactionOptions strategy(RedactionStrategy strategy) {
            this.strategy = strategy;
            return this;
        }

        public RedactionOptions targetTypes(Set<PiiEntityType> targetTypes) {
            this.targetTypes = targetTypes == null ? Collections.emptySet() : targetTypes;
            return this;
        }

        public RedactionOptions customMask(String customMask) {
            this.customMask = customMask;
            return this;
        }
    }

    /**
     * Redacts PII in the input text with default settings.
     *
     * @param text The input string to redact.
     * @return The redacted string.
     */
    public String redact(String text) {
        return redact(text, RedactionOptions.create().minConfidence(this.defaultMinScore).languageCode(this.defaultLanguage));
    }

    /**
     * Redacts PII in the input text with custom options.
     *
     * @param text The input string to redact.
     * @param options Redaction options.
     * @return The redacted string.
     */
    public String redact(String text, RedactionOptions options) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(options.languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by confidence score and target entity types
        List<PiiEntity> filtered = entities.stream()
                .filter(e -> e.score() >= options.minConfidence)
                .filter(e -> options.targetTypes.isEmpty() || options.targetTypes.contains(e.type()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        // Redact in reverse offset order to preserve string indices
        StringBuilder sb = new StringBuilder(text);
        int lastEnd = Integer.MAX_VALUE;

        for (PiiEntity entity : filtered) {
            int begin = entity.beginOffset();
            int end = entity.endOffset();

            // Guard against invalid bounds or overlapping entities
            if (begin < 0 || end > sb.length() || begin >= end || end > lastEnd) {
                continue;
            }

            String replacement = generateReplacement(entity, options, end - begin);
            sb.replace(begin, end, replacement);
            lastEnd = begin;
        }

        return sb.toString();
    }

    /**
     * Detects all PII entities above the confidence threshold without redacting.
     */
    public List<PiiEntity> detect(String text, LanguageCode languageCode, float minConfidence) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : this.defaultLanguage)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.entities().stream()
                .filter(e -> e.score() >= minConfidence)
                .collect(Collectors.toList());
    }

    private String generateReplacement(PiiEntity entity, RedactionOptions options, int originalLength) {
        if (options.customMask != null) {
            return options.customMask;
        }

        switch (options.strategy) {
            case MASK:
                return "***";
            case CHARACTER_MASK:
                return "*".repeat(Math.max(1, originalLength));
            case LABEL:
            default:
                return "[REDACTED_" + entity.typeAsString() + "]";
        }
    }

    @Override
    public void close() {
        if (this.comprehendClient != null) {
            this.comprehendClient.close();
        }
    }
}
