package com.edgechains.lib.utils.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.ComprehendException;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.function.BiFunction;

/**
 * Utility to detect and redact Personally Identifiable Information (PII)
 * from text using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private static final int MAX_BYTE_SIZE = 100_000;
    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public enum RedactionMaskMode {
        /** Replace with entity type tag, e.g. [NAME], [EMAIL_ADDRESS], [PHONE_NUMBER] */
        ENTITY_TYPE_TAG,
        /** Replace with fixed static string, e.g. [REDACTED] */
        FIXED_STRING,
        /** Mask with repeating character (e.g. '*') matching span length */
        MASK_CHARACTERS,
        /** User-defined custom replacement function */
        CUSTOM
    }

    public static class RedactionConfig {
        private RedactionMaskMode maskMode = RedactionMaskMode.ENTITY_TYPE_TAG;
        private String fixedMask = "[REDACTED]";
        private char maskChar = '*';
        private float minScoreThreshold = 0.5f;
        private LanguageCode languageCode = LanguageCode.EN;
        private Set<PiiEntityType> includedEntityTypes = Collections.emptySet();
        private BiFunction<PiiEntity, String, String> customFormatter;

        public static RedactionConfig defaultConfig() {
            return new RedactionConfig();
        }

        public RedactionConfig maskMode(RedactionMaskMode maskMode) {
            this.maskMode = maskMode;
            return this;
        }

        public RedactionConfig fixedMask(String fixedMask) {
            this.fixedMask = fixedMask;
            return this;
        }

        public RedactionConfig maskChar(char maskChar) {
            this.maskChar = maskChar;
            return this;
        }

        public RedactionConfig minScoreThreshold(float minScoreThreshold) {
            this.minScoreThreshold = minScoreThreshold;
            return this;
        }

        public RedactionConfig languageCode(LanguageCode languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public RedactionConfig includedEntityTypes(Set<PiiEntityType> includedEntityTypes) {
            this.includedEntityTypes = includedEntityTypes == null ? Collections.emptySet() : includedEntityTypes;
            return this;
        }

        public RedactionConfig customFormatter(BiFunction<PiiEntity, String, String> customFormatter) {
            this.customFormatter = customFormatter;
            return this;
        }

        public RedactionMaskMode getMaskMode() { return maskMode; }
        public String getFixedMask() { return fixedMask; }
        public char getMaskChar() { return maskChar; }
        public float getMinScoreThreshold() { return minScoreThreshold; }
        public LanguageCode getLanguageCode() { return languageCode; }
        public Set<PiiEntityType> getIncludedEntityTypes() { return includedEntityTypes; }
        public BiFunction<PiiEntity, String, String> getCustomFormatter() { return customFormatter; }
    }

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(Region.US_EAST_1)
                .build(), true);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build(), true);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, boolean manageClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.manageClientLifecycle = manageClientLifecycle;
    }

    /**
     * Detects all PII entities in the provided text.
     */
    public List<PiiEntity> detectPiiEntities(String text, LanguageCode languageCode) {
        if (text == null || text.isBlank()) {
            return Collections.emptyList();
        }

        byte[] utf8Bytes = text.getBytes(StandardCharsets.UTF_8);
        if (utf8Bytes.length > MAX_BYTE_SIZE) {
            return detectPiiInChunks(text, languageCode);
        }

        try {
            DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                    .text(text)
                    .languageCode(languageCode)
                    .build();

            DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
            return response.entities();
        } catch (ComprehendException e) {
            throw new RuntimeException("AWS Comprehend PII detection failed: " + e.awsErrorDetails().errorMessage(), e);
        }
    }

    /**
     * Redacts PII from text using default configuration.
     */
    public String redact(String text) {
        return redact(text, RedactionConfig.defaultConfig());
    }

    /**
     * Redacts PII from text with specified mask mode.
     */
    public String redact(String text, RedactionMaskMode maskMode) {
        return redact(text, RedactionConfig.defaultConfig().maskMode(maskMode));
    }

    /**
     * Redacts PII from text according to provided configuration.
     */
    public String redact(String text, RedactionConfig config) {
        if (text == null || text.isBlank()) {
            return text;
        }

        Objects.requireNonNull(config, "config must not be null");
        List<PiiEntity> entities = detectPiiEntities(text, config.getLanguageCode());
        if (entities.isEmpty()) {
            return text;
        }

        List<PiiEntity> filtered = new ArrayList<>();
        for (PiiEntity entity : entities) {
            if (entity.score() != null && entity.score() >= config.getMinScoreThreshold()) {
                if (config.getIncludedEntityTypes().isEmpty() || config.getIncludedEntityTypes().contains(entity.type())) {
                    filtered.add(entity);
                }
            }
        }

        if (filtered.isEmpty()) {
            return text;
        }

        // Sort descending by beginOffset to replace from tail to head without offset corruption
        filtered.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder sb = new StringBuilder(text);
        int lastRedactedBegin = text.length();

        for (PiiEntity entity : filtered) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Avoid collisions with overlapping entities
            if (end > lastRedactedBegin) {
                end = lastRedactedBegin;
            }
            if (start >= end) {
                continue;
            }

            String originalSpan = text.substring(start, end);
            String replacement = formatReplacement(entity, originalSpan, config);

            sb.replace(start, end, replacement);
            lastRedactedBegin = start;
        }

        return sb.toString();
    }

    private String formatReplacement(PiiEntity entity, String originalSpan, RedactionConfig config) {
        switch (config.getMaskMode()) {
            case FIXED_STRING:
                return config.getFixedMask();
            case MASK_CHARACTERS:
                return String.valueOf(config.getMaskChar()).repeat(Math.max(1, originalSpan.length()));
            case CUSTOM:
                if (config.getCustomFormatter() != null) {
                    return config.getCustomFormatter().apply(entity, originalSpan);
                }
                return "[" + entity.typeAsString() + "]";
            case ENTITY_TYPE_TAG:
            default:
                return "[" + entity.typeAsString() + "]";
        }
    }

    private List<PiiEntity> detectPiiInChunks(String text, LanguageCode languageCode) {
        List<PiiEntity> combined = new ArrayList<>();
        int length = text.length();
        int chunkChars = 20_000;
        int start = 0;

        while (start < length) {
            int end = Math.min(start + chunkChars, length);
            if (end < length) {
                int lastSpace = text.lastIndexOf(' ', end);
                if (lastSpace > start) {
                    end = lastSpace;
                }
            }

            String chunk = text.substring(start, end);
            DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                    .text(chunk)
                    .languageCode(languageCode)
                    .build();

            DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
            final int chunkOffset = start;
            for (PiiEntity entity : response.entities()) {
                PiiEntity adjusted = PiiEntity.builder()
                        .type(entity.type())
                        .score(entity.score())
                        .beginOffset(entity.beginOffset() + chunkOffset)
                        .endOffset(entity.endOffset() + chunkOffset)
                        .build();
                combined.add(adjusted);
            }

            start = end;
        }

        return combined;
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
