package com.edgechains.lib.aws.comprehend;

public enum RedactionMaskStrategy {
    GENERIC,          // Replaces with "[REDACTED]"
    ENTITY_TYPE,      // Replaces with "[PII: TYPE]" (e.g., "[PII: EMAIL]")
    ASTERISKS,        // Replaces with fixed asterisks "***"
    ASTERISKS_LENGTH  // Replaces with asterisks matching original text length
}
