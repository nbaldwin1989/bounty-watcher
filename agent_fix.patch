```java
package com.edgechains.core.utils;

import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Arrays;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

public class AwsComprehendRedactionUtilTest {

    @Test
    public void testRedactPiiWithEntityType() {
        ComprehendClient mockClient = Mockito.mock(ComprehendClient.class);

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(20)
                .endOffset(36)
                .score(0.99f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(emailEntity)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        AwsComprehendRedactionUtil util = new AwsComprehendRedactionUtil(mockClient);
        String input = "Contact John Doe at john@example.com for info.";
        String result = util.redactPii(input);

        assertEquals("Contact John Doe at [EMAIL] for info.", result);
    }

    @Test
    public void testRedactPiiWithGenericMask() {
        ComprehendClient mockClient = Mockito.mock(ComprehendClient.class);

        PiiEntity ssnEntity = PiiEntity.builder()
                .type(PiiEntityType.SSN)
                .beginOffset(10)
                .endOffset(21)
                .score(0.98f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(ssnEntity)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        AwsComprehendRedactionUtil util = new AwsComprehendRedactionUtil(mockClient);
        AwsComprehendRedactionUtil.RedactionConfig config = new AwsComprehendRedactionUtil.RedactionConfig()
                .setMaskMode(AwsComprehendRedactionUtil.RedactionMaskMode.GENERIC_MASK);

        String input = "My SSN is 123-45-6789.";
        String result = util.redactPii(input, config);

        assertEquals("My SSN is [REDACTED].", result);
    }
}
