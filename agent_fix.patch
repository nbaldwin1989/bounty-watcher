// src/main/java/com/edgechains/lib/aws/comprehend/AwsComprehendRedactor.java
package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.nio.charset.StandardCharsets;
import java.util.*;
import java.util.stream.Collectors;

public class AwsComprehendRedactor {

    private static final int MAX_BYTE_SIZE = 100_000;
    private final ComprehendClient comprehendClient;

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
    }

    public RedactionResult redact(String text) {
        return redact(text, RedactionConfig.defaultConfig());
    }

    public RedactionResult redact(String text, RedactionConfig config) {
        if (text == null || text.isEmpty()) {
            return new RedactionResult(text, text, Collections.emptyList());
        }

        byte[] utf8Bytes = text.getBytes(StandardCharsets.UTF_8);
        if (utf8Bytes.length <= MAX_BYTE_SIZE) {
            return redactSingleChunk(text, config);
        }

        return redactLargeText(text, config);
    }

    private RedactionResult redactSingleChunk(String text, RedactionConfig config) {
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(config.getLanguageCode())
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        List<PiiEntity> filtered = entities.stream()
                .filter(e -> e.score() != null && e.score() >= config.getMinScoreThreshold())
                .filter(e -> config.getTargetEntityTypes().isEmpty() || config.getTargetEntityTypes().contains(e.type()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset))
                .collect(Collectors.toList());

        List<PiiEntity> nonOverlapping = filterOverlaps(filtered);

        List<RedactedEntityInfo> redactedInfoList = new ArrayList<>();
        StringBuilder sb = new StringBuilder(text);

        for (int i = nonOverlapping.size() - 1; i >= 0; i--) {
            PiiEntity entity = nonOverlapping.get(i);
            int begin = entity.beginOffset();
            int end = entity.endOffset();
            String originalPart = text.substring(begin, end);
            String replacement = generateMask(originalPart, entity, config);

            sb.replace(begin, end, replacement);
            redactedInfoList.add(new RedactedEntityInfo(
                    originalPart,
                    replacement,
                    entity.type(),
                    entity.score(),
                    begin,
                    end
            ));
        }

        Collections.reverse(redactedInfoList);
        return new RedactionResult(text, sb.toString(), redactedInfoList);
    }

    private RedactionResult redactLargeText(String text, RedactionConfig config) {
        String[] lines = text.split("(?<=\n)");
        StringBuilder chunkBuilder = new StringBuilder();
        StringBuilder overallRedacted = new StringBuilder();
        List<RedactedEntityInfo> allRedactedEntities = new ArrayList<>();
        int currentOffset = 0;

        for (String line : lines) {
            if ((chunkBuilder.toString() + line).getBytes(StandardCharsets.UTF_8).length > MAX_BYTE_SIZE) {
                if (chunkBuilder.length() > 0) {
                    processChunk(chunkBuilder.toString(), config, currentOffset, overallRedacted, allRedactedEntities);
                    currentOffset += chunkBuilder.length();
                    chunkBuilder.setLength(0);
                }
            }
            chunkBuilder.append(line);
        }

        if (chunkBuilder.length() > 0) {
            processChunk(chunkBuilder.toString(), config, currentOffset, overallRedacted, allRedactedEntities);
        }

        return new RedactionResult(text, overallRedacted.toString(), allRedactedEntities);
    }

    private void processChunk(String chunk, RedactionConfig config, int offsetDelta,
                              StringBuilder overallRedacted, List<RedactedEntityInfo> allRedactedEntities) {
        RedactionResult chunkResult = redactSingleChunk(chunk, config);
        overallRedacted.append(chunkResult.getRedactedText());
        for (RedactedEntityInfo info : chunkResult.getRedactedEntities()) {
            allRedactedEntities.add(new RedactedEntityInfo(
                    info.getOriginalText(),
                    info.getReplacementText(),
                    info.getEntityType(),
                    info.getScore(),
                    info.getBeginOffset() + offsetDelta,
                    info.getEndOffset() + offsetDelta
            ));
        }
    }

    private List<PiiEntity> filterOverlaps(List<PiiEntity> sortedEntities) {
        List<PiiEntity> result = new ArrayList<>();
        int lastEnd = -1;
        for (PiiEntity entity : sortedEntities) {
            if (entity.beginOffset() >= lastEnd) {
                result.add(entity);
                lastEnd = entity.endOffset();
            }
        }
        return result;
    }

    private String generateMask(String original, PiiEntity entity, RedactionConfig config) {
        switch (config.getMaskStrategy()) {
            case GENERIC:
                return config.getCustomMask() != null ? config.getCustomMask() : "[REDACTED]";
            case ENTITY_TYPE:
                return "[PII: " + entity.typeAsString() + "]";
            case ASTERISKS:
                return "***";
            case ASTERISKS_LENGTH:
                return "*".repeat(Math.max(1, original.length()));
            default:
                return "[REDACTED]";
        }
    }
}
