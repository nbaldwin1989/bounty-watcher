// ============================================================================

package com.edgechains.lib.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.*;
import java.util.stream.Collectors;

/**
 * Utility to detect and redact Personally Identifiable Information (PII)
 * from text using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public enum RedactionStrategy {
        MASK,               // Replaces characters with mask character (e.g., *******)
        ENTITY_TYPE,        // Replaces text with [ENTITY_TYPE] (e.g., [SSN], [NAME])
        REDACTED_LABEL      // Replaces text with a static [REDACTED] label
    }

    public static class RedactionConfig {
        private LanguageCode languageCode = LanguageCode.EN;
        private double minConfidenceScore = 0.5;
        private RedactionStrategy strategy = RedactionStrategy.ENTITY_TYPE;
        private char maskChar = '*';
        private Set<PiiEntityType> targetTypes = Collections.emptySet(); // Empty means redact all

        public static RedactionConfig defaultConfig() {
            return new RedactionConfig();
        }

        public RedactionConfig withLanguageCode(LanguageCode languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public RedactionConfig withMinConfidenceScore(double minConfidenceScore) {
            this.minConfidenceScore = minConfidenceScore;
            return this;
        }

        public RedactionConfig withStrategy(RedactionStrategy strategy) {
            this.strategy = strategy;
            return this;
        }

        public RedactionConfig withMaskChar(char maskChar) {
            this.maskChar = maskChar;
            return this;
        }

        public RedactionConfig withTargetTypes(Set<PiiEntityType> targetTypes) {
            this.targetTypes = targetTypes != null ? targetTypes : Collections.emptySet();
            return this;
        }

        public LanguageCode getLanguageCode() { return languageCode; }
        public double getMinConfidenceScore() { return minConfidenceScore; }
        public RedactionStrategy getStrategy() { return strategy; }
        public char getMaskChar() { return maskChar; }
        public Set<PiiEntityType> getTargetTypes() { return targetTypes; }
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), true);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build(), true);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, boolean manageClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.manageClientLifecycle = manageClientLifecycle;
    }

    /**
     * Redacts PII using default configuration.
     *
     * @param text Original text
     * @return Redacted text
     */
    public String redact(String text) {
        return redact(text, RedactionConfig.defaultConfig());
    }

    /**
     * Redacts PII using custom configuration options.
     *
     * @param text Original text
     * @param config Redaction configuration
     * @return Redacted text
     */
    public String redact(String text, RedactionConfig config) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(config.getLanguageCode())
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by confidence score and target entity types
        List<PiiEntity> filteredEntities = entities.stream()
                .filter(e -> e.score() >= config.getMinConfidenceScore())
                .filter(e -> config.getTargetTypes().isEmpty() || config.getTargetTypes().contains(e.type()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder sb = new StringBuilder(text);
        int lastProcessedBegin = Integer.MAX_VALUE;

        // Iterate backwards from end to begin to maintain string offset validity
        for (PiiEntity entity : filteredEntities) {
            int begin = entity.beginOffset();
            int end = entity.endOffset();

            // Validate boundaries and prevent overlapping replacements
            if (begin < 0 || end > sb.length() || begin >= end) {
                continue;
            }
            if (end > lastProcessedBegin) {
                // Skip overlapping entity
                continue;
            }

            String replacement = getReplacement(entity, end - begin, config);
            sb.replace(begin, end, replacement);
            lastProcessedBegin = begin;
        }

        return sb.toString();
    }

    private String getReplacement(PiiEntity entity, int length, RedactionConfig config) {
        switch (config.getStrategy()) {
            case MASK:
                char[] chars = new char[length];
                Arrays.fill(chars, config.getMaskChar());
                return new String(chars);
            case REDACTED_LABEL:
                return "[REDACTED]";
            case ENTITY_TYPE:
            default:
                return "[" + entity.typeAsString() + "]";
        }
    }

    public List<PiiEntity> detectPii(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();
        return comprehendClient.detectPiiEntities(request).entities();
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
