package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Collections;
import java.util.HashSet;
import java.util.Set;

public class RedactionConfig {

    private final String languageCode;
    private final float minScoreThreshold;
    private final RedactionMaskStrategy maskStrategy;
    private final String customMask;
    private final Set<PiiEntityType> targetEntityTypes;

    private RedactionConfig(Builder builder) {
        this.languageCode = builder.languageCode;
        this.minScoreThreshold = builder.minScoreThreshold;
        this.maskStrategy = builder.maskStrategy;
        this.customMask = builder.customMask;
        this.targetEntityTypes = Collections.unmodifiableSet(builder.targetEntityTypes);
    }

    public static Builder builder() {
        return new Builder();
    }

    public static RedactionConfig defaultConfig() {
        return builder().build();
    }

    public String getLanguageCode() {
        return languageCode;
    }

    public float getMinScoreThreshold() {
        return minScoreThreshold;
    }

    public RedactionMaskStrategy getMaskStrategy() {
        return maskStrategy;
    }

    public String getCustomMask() {
        return customMask;
    }

    public Set<PiiEntityType> getTargetEntityTypes() {
        return targetEntityTypes;
    }

    public static class Builder {
        private String languageCode = "en";
        private float minScoreThreshold = 0.5f;
        private RedactionMaskStrategy maskStrategy = RedactionMaskStrategy.ENTITY_TYPE;
        private String customMask = "[REDACTED]";
        private Set<PiiEntityType> targetEntityTypes = new HashSet<>();

        public Builder languageCode(String languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public Builder minScoreThreshold(float minScoreThreshold) {
            this.minScoreThreshold = minScoreThreshold;
            return this;
        }

        public Builder maskStrategy(RedactionMaskStrategy maskStrategy) {
            this.maskStrategy = maskStrategy;
            return this;
        }

        public Builder customMask(String customMask) {
            this.customMask = customMask;
            return this;
        }

        public Builder targetEntityTypes(Set<PiiEntityType> entityTypes) {
            this.targetEntityTypes = entityTypes != null ? new HashSet<>(entityTypes) : new HashSet<>();
            return this;
        }

        public Builder addTargetEntityType(PiiEntityType entityType) {
            this.targetEntityTypes.add(entityType);
            return this;
        }

        public RedactionConfig build() {
            return new RedactionConfig(this);
        }
    }
}
