package com.edgechains.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.ComprehendClientBuilder;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.stream.Collectors;

/**
 * Utility to detect and redact sensitive PII (Personally Identifiable Information)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final LanguageCode defaultLanguageCode;
    private final float minScoreThreshold;

    public enum MaskMode {
        ENTITY_TYPE, // e.g., "[SSN]", "[EMAIL]"
        FIXED_STRING, // e.g., "[REDACTED]"
        CHARACTER_MASK // e.g., "********"
    }

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder().build(), LanguageCode.EN, 0.5f);
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), LanguageCode.EN, 0.5f);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this(
                ComprehendClient.builder()
                        .region(region)
                        .credentialsProvider(credentialsProvider)
                        .build(),
                LanguageCode.EN,
                0.5f);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, LanguageCode.EN, 0.5f);
    }

    public AwsComprehendRedactor(
            ComprehendClient comprehendClient,
            LanguageCode defaultLanguageCode,
            float minScoreThreshold) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.defaultLanguageCode = Objects.requireNonNull(defaultLanguageCode, "defaultLanguageCode must not be null");
        this.minScoreThreshold = minScoreThreshold;
    }

    /**
     * Redacts all detected PII entities replacing them with their entity type (e.g. [NAME], [EMAIL]).
     *
     * @param text Input text containing sensitive information.
     * @return Redacted text.
     */
    public String redact(String text) {
        return redact(text, this.defaultLanguageCode, MaskMode.ENTITY_TYPE, "[REDACTED]", null);
    }

    /**
     * Redacts all detected PII entities replacing them with a fixed mask string.
     *
     * @param text Input text containing sensitive information.
     * @param mask Replacement token (e.g., "[REDACTED]" or "***").
     * @return Redacted text.
     */
    public String redact(String text, String mask) {
        return redact(text, this.defaultLanguageCode, MaskMode.FIXED_STRING, mask, null);
    }

    /**
     * Redacts sensitive data with full customization options.
     *
     * @param text Input text to redact.
     * @param languageCode Language of the input text.
     * @param maskMode How PII entities should be masked.
     * @param customMask Custom string to use if MaskMode.FIXED_STRING is selected.
     * @param targetEntityTypes Optional set of entity types to redact (null or empty redacts all).
     * @return Redacted text string.
     */
    public String redact(
            String text,
            LanguageCode languageCode,
            MaskMode maskMode,
            String customMask,
            Set<String> targetEntityTypes) {

        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : this.defaultLanguageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by confidence threshold and specified entity types
        List<PiiEntity> filteredEntities = entities.stream()
                .filter(e -> e.score() != null && e.score() >= this.minScoreThreshold)
                .filter(e -> targetEntityTypes == null || targetEntityTypes.isEmpty()
                        || targetEntityTypes.contains(e.typeAsString()))
                // Sort descending by beginOffset so earlier indices stay valid during replacements
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder sb = new StringBuilder(text);

        for (PiiEntity entity : filteredEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start < 0 || end > sb.length() || start >= end) {
                continue;
            }

            String replacement;
            switch (maskMode) {
                case FIXED_STRING:
                    replacement = customMask != null ? customMask : "[REDACTED]";
                    break;
                case CHARACTER_MASK:
                    replacement = "*".repeat(end - start);
                    break;
                case ENTITY_TYPE:
                default:
                    replacement = "[" + entity.typeAsString() + "]";
                    break;
            }

            sb.replace(start, end, replacement);
        }

        return sb.toString();
    }

    /**
     * Inspects text and returns list of detected PII entities.
     *
     * @param text Input text.
     * @return List of detected PII entities.
     */
    public List<PiiEntity> detectPii(String text) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(this.defaultLanguageCode)
                .build();

        return comprehendClient.detectPiiEntities(request).entities();
    }

    public ComprehendClient getComprehendClient() {
        return comprehendClient;
    }

    @Override
    public void close() {
        if (this.comprehendClient != null) {
            this.comprehendClient.close();
        }
    }
}
