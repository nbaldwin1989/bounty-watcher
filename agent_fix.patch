package com.edgechains.lib.aws;

public enum RedactionMode {
    /** Replaces entity with a fixed mask, e.g., "[REDACTED]" */
    FIXED_MASK,
    /** Replaces entity with its detected PII type, e.g., "[SSN]", "[EMAIL]" */
    ENTITY_TYPE,
    /** Replaces entity characters with asterisks preserving length */
    ASTERISK
}
