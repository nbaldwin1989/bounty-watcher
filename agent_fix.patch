```java
package org.arakoodev.edgechains.utils;

import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

/**
 * Utility to detect and redact Personally Identifiable Information (PII)
 * using AWS Comprehend before passing text into EdgeChains prompts or chains.
 */
public class AwsComprehendRedactor {

    private final ComprehendClient comprehendClient;
    private final String defaultLanguageCode;

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(Region.US_EAST_1)
                .build(), "en");
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(region)
                .build(), "en");
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, String defaultLanguageCode) {
        this.comprehendClient = comprehendClient;
        this.defaultLanguageCode = defaultLanguageCode;
    }

    /**
     * Redacts PII entities by masking each detected entity with its type, e.g., [SSN], [EMAIL].
     *
     * @param text Raw input text.
     * @return Redacted text.
     */
    public String redact(String text) {
        return redact(text, this.defaultLanguageCode);
    }

    /**
     * Redacts PII entities using a custom mask format with the entity type name.
     *
     * @param text         Raw input text.
     * @param languageCode Language code (e.g., "en", "es").
     * @return Redacted text.
     */
    public String redact(String text, String languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        List<PiiEntity> entities = detectEntities(text, languageCode);
        return applyRedaction(text, entities, null);
    }

    /**
     * Redacts PII entities using a static placeholder mask across all entity types.
     *
     * @param text Raw input text.
     * @param mask Custom replacement string (e.g. "[REDACTED]" or "***").
     * @return Redacted text.
     */
    public String redactWithMask(String text, String mask) {
        return redactWithMask(text, this.defaultLanguageCode, mask);
    }

    /**
     * Redacts PII entities using a static placeholder mask for a specified language.
     *
     * @param text         Raw input text.
     * @param languageCode Language code.
     * @param mask         Custom replacement string.
     * @return Redacted text.
     */
    public String redactWithMask(String text, String languageCode, String mask) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        List<PiiEntity> entities = detectEntities(text, languageCode);
        return applyRedaction(text, entities, mask);
    }

    /**
     * Fetches all detected PII entities from AWS Comprehend.
     *
     * @param text         Input text.
     * @param languageCode Language code.
     * @return List of detected PiiEntity instances.
     */
    public List<PiiEntity> detectEntities(String text, String languageCode) {
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return new ArrayList<>(response.entities());
    }

    private String applyRedaction(String text, List<PiiEntity> entities, String customMask) {
        // Sort descending by beginOffset to safely replace substrings without invalidating offsets
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder sb = new StringBuilder(text);
        for (PiiEntity entity : entities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();
            String replacement = (customMask != null) ? customMask : "[" + entity.typeAsString() + "]";
            sb.replace(start, end, replacement);
        }

        return sb.toString();
    }
}
