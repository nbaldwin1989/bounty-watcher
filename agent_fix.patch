```java
package org.arakoodev.edgechains.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.stream.Collectors;

/**
 * Utility to detect and redact sensitive PII entities using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final float minScoreThreshold;
    private final RedactionStrategy strategy;
    private final Set<String> targetEntityTypes;

    public enum RedactionStrategy {
        MASK,           // Replaces sensitive text with fixed [REDACTED]
        ENTITY_TYPE,    // Replaces sensitive text with [NAME], [SSN], etc.
        CHARACTER_MASK  // Masks each character with '*'
    }

    private AwsComprehendRedactor(Builder builder) {
        if (builder.comprehendClient != null) {
            this.comprehendClient = builder.comprehendClient;
        } else {
            this.comprehendClient = ComprehendClient.builder()
                    .region(builder.region != null ? builder.region : Region.US_EAST_1)
                    .credentialsProvider(builder.credentialsProvider != null
                            ? builder.credentialsProvider
                            : DefaultCredentialsProvider.create())
                    .build();
        }
        this.minScoreThreshold = builder.minScoreThreshold;
        this.strategy = builder.strategy;
        this.targetEntityTypes = builder.targetEntityTypes;
    }

    public static Builder builder() {
        return new Builder();
    }

    public static AwsComprehendRedactor create() {
        return builder().build();
    }

    /**
     * Redacts PII entities in the input text using English as the default language.
     *
     * @param text Original text
     * @return Redacted text
     */
    public String redact(String text) {
        return redact(text, LanguageCode.EN.toString());
    }

    /**
     * Redacts PII entities in the input text for a specified language code.
     *
     * @param text         Original text
     * @param languageCode AWS Comprehend supported language code (e.g., "en", "es")
     * @return Redacted text
     */
    public String redact(String text, String languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by confidence threshold and target types, then sort descending by beginOffset
        List<PiiEntity> sortedEntities = entities.stream()
                .filter(e -> e.score() >= minScoreThreshold)
                .filter(e -> targetEntityTypes == null || targetEntityTypes.contains(e.typeAsString()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder redacted = new StringBuilder(text);
        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();
            String replacement = getReplacement(entity, text.substring(start, end));
            redacted.replace(start, end, replacement);
        }

        return redacted.toString();
    }

    private String getReplacement(PiiEntity entity, String originalSlice) {
        switch (strategy) {
            case ENTITY_TYPE:
                return "[" + entity.typeAsString() + "]";
            case CHARACTER_MASK:
                return "*".repeat(originalSlice.length());
            case MASK:
            default:
                return "[REDACTED]";
        }
    }

    @Override
    public void close() {
        if (this.comprehendClient != null) {
            this.comprehendClient.close();
        }
    }

    public static class Builder {
        private ComprehendClient comprehendClient;
        private Region region;
        private AwsCredentialsProvider credentialsProvider;
        private float minScoreThreshold = 0.70f;
        private RedactionStrategy strategy = RedactionStrategy.ENTITY_TYPE;
        private Set<String> targetEntityTypes = null;

        public Builder comprehendClient(ComprehendClient comprehendClient) {
            this.comprehendClient = comprehendClient;
            return this;
        }

        public Builder region(Region region) {
            this.region = region;
            return this;
        }

        public Builder credentialsProvider(AwsCredentialsProvider credentialsProvider) {
            this.credentialsProvider = credentialsProvider;
            return this;
        }

        public Builder minScoreThreshold(float minScoreThreshold) {
            this.minScoreThreshold = minScoreThreshold;
            return this;
        }

        public Builder strategy(RedactionStrategy strategy) {
            this.strategy = Objects.requireNonNull(strategy);
            return this;
        }

        public Builder targetEntityTypes(Set<String> targetEntityTypes) {
            this.targetEntityTypes = targetEntityTypes;
            return this;
        }

        public AwsComprehendRedactor build() {
            return new AwsComprehendRedactor(this);
        }
    }
}
