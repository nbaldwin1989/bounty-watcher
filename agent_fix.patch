package com.edgechains.lib.aws;

import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Collections;
import java.util.HashSet;
import java.util.Set;

public class RedactionConfig {
    private final float minScoreThreshold;
    private final RedactionMode mode;
    private final String customMask;
    private final Set<PiiEntityType> targetEntityTypes;
    private final String defaultLanguageCode;

    private RedactionConfig(Builder builder) {
        this.minScoreThreshold = builder.minScoreThreshold;
        this.mode = builder.mode;
        this.customMask = builder.customMask;
        this.targetEntityTypes = Collections.unmodifiableSet(builder.targetEntityTypes);
        this.defaultLanguageCode = builder.defaultLanguageCode;
    }

    public static Builder builder() {
        return new Builder();
    }

    public static RedactionConfig defaultConfig() {
        return builder().build();
    }

    public float getMinScoreThreshold() {
        return minScoreThreshold;
    }

    public RedactionMode getMode() {
        return mode;
    }

    public String getCustomMask() {
        return customMask;
    }

    public Set<PiiEntityType> getTargetEntityTypes() {
        return targetEntityTypes;
    }

    public String getDefaultLanguageCode() {
        return defaultLanguageCode;
    }

    public static class Builder {
        private float minScoreThreshold = 0.5f;
        private RedactionMode mode = RedactionMode.ENTITY_TYPE;
        private String customMask = "[REDACTED]";
        private Set<PiiEntityType> targetEntityTypes = new HashSet<>();
        private String defaultLanguageCode = "en";

        public Builder minScoreThreshold(float minScoreThreshold) {
            if (minScoreThreshold < 0.0f || minScoreThreshold > 1.0f) {
                throw new IllegalArgumentException("Confidence score must be between 0.0 and 1.0");
            }
            this.minScoreThreshold = minScoreThreshold;
            return this;
        }

        public Builder mode(RedactionMode mode) {
            this.mode = mode != null ? mode : RedactionMode.ENTITY_TYPE;
            return this;
        }

        public Builder customMask(String customMask) {
            this.customMask = customMask != null ? customMask : "[REDACTED]";
            return this;
        }

        public Builder targetEntityTypes(Set<PiiEntityType> targetEntityTypes) {
            this.targetEntityTypes = targetEntityTypes != null ? new HashSet<>(targetEntityTypes) : new HashSet<>();
            return this;
        }

        public Builder addTargetEntityType(PiiEntityType type) {
            if (type != null) {
                this.targetEntityTypes.add(type);
            }
            return this;
        }

        public Builder defaultLanguageCode(String defaultLanguageCode) {
            this.defaultLanguageCode = (defaultLanguageCode != null && !defaultLanguageCode.isBlank())
                    ? defaultLanguageCode
                    : "en";
            return this;
        }

        public RedactionConfig build() {
            return new RedactionConfig(this);
        }
    }
}
