#### Utility Class (`AwsComprehendRedactor.java`)
```java
package com.edgechains.lib.utils;

import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;

public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final String defaultLanguageCode;

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, "en");
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, String defaultLanguageCode) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.defaultLanguageCode = (defaultLanguageCode != null && !defaultLanguageCode.isBlank()) ? defaultLanguageCode : "en";
    }

    public static AwsComprehendRedactor create(Region region) {
        return new AwsComprehendRedactor(ComprehendClient.builder().region(region).build());
    }

    public static AwsComprehendRedactor create(String accessKeyId, String secretAccessKey, Region region) {
        ComprehendClient client = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(StaticCredentialsProvider.create(
                        AwsBasicCredentials.create(accessKeyId, secretAccessKey)))
                .build();
        return new AwsComprehendRedactor(client);
    }

    /**
     * Redacts all PII entities using the default [REDACTED] mask.
     */
    public String redact(String text) {
        return redact(text, defaultLanguageCode, "[REDACTED]", null);
    }

    /**
     * Redacts all PII entities using a custom mask string.
     */
    public String redact(String text, String mask) {
        return redact(text, defaultLanguageCode, mask, null);
    }

    /**
     * Redacts specific entity types using entity labels (e.g., [NAME], [EMAIL]).
     */
    public String redactWithLabels(String text) {
        return redact(text, defaultLanguageCode, null, null);
    }

    /**
     * Core redaction method.
     *
     * @param text               Input text.
     * @param languageCode       Language code (e.g. "en", "es").
     * @param mask               Custom mask or null to use entity type labels like [NAME].
     * @param targetEntityTypes  Specific entity types to redact, or null to redact all.
     * @return Redacted text.
     */
    public String redact(String text, String languageCode, String mask, Set<PiiEntityType> targetEntityTypes) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        String lang = (languageCode != null && !languageCode.isBlank()) ? languageCode : defaultLanguageCode;

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(lang)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Sort descending by offset to safely replace substring without recalculating indexes
        List<PiiEntity> sortedEntities = entities.stream()
                .filter(entity -> targetEntityTypes == null || targetEntityTypes.contains(entity.type()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .toList();

        StringBuilder builder = new StringBuilder(text);
        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();
            String replacement = (mask != null) ? mask : "[" + entity.typeAsString() + "]";
            builder.replace(start, end, replacement);
        }

        return builder.toString();
    }

    @Override
    public void close() {
        if (comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
```

#### Unit Tests (`AwsComprehendRedactorTest.java`)
```java
package com.edgechains.lib.utils;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactorTest {

    private ComprehendClient comprehendClient;
    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        comprehendClient = Mockito.mock(ComprehendClient.class);
        redactor = new AwsComprehendRedactor(comprehendClient);
    }

    @AfterEach
    void tearDown() {
        redactor.close();
    }

    @Test
    void testRedactWithDefaultMask() {
        String input = "My name is John Doe and my email is john@example.com";
        PiiEntity name = PiiEntity.builder().beginOffset(11).endOffset(19).type(PiiEntityType.NAME).build();
        PiiEntity email = PiiEntity.builder().beginOffset(36).endOffset(52).type(PiiEntityType.EMAIL).build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(name, email))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redact(input);
        assertEquals("My name is [REDACTED] and my email is [REDACTED]", result);
    }

    @Test
    void testRedactWithLabels() {
        String input = "Call me at 555-0199.";
        PiiEntity phone = PiiEntity.builder().beginOffset(11).endOffset(19).type(PiiEntityType.PHONE).build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(phone))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redactWithLabels(input);
        assertEquals("Call me at [PHONE].", result);
    }
}
```

