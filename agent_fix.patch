```java
package com.edgechains.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.stream.Collectors;

/**
 * Utility to detect and redact Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactionUtil implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;
    private static final double DEFAULT_CONFIDENCE_THRESHOLD = 0.5;

    public AwsComprehendRedactionUtil() {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(Region.US_EAST_1)
                .build(), true);
    }

    public AwsComprehendRedactionUtil(Region region) {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(region)
                .build(), true);
    }

    public AwsComprehendRedactionUtil(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .credentialsProvider(credentialsProvider)
                .region(region)
                .build(), true);
    }

    public AwsComprehendRedactionUtil(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactionUtil(ComprehendClient comprehendClient, boolean manageLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "ComprehendClient must not be null");
        this.manageClientLifecycle = manageLifecycle;
    }

    /**
     * Redacts all detected PII entities in the input text using default English language.
     * Replaces entities with "[PII_{TYPE}]".
     */
    public String redact(String text) {
        return redact(text, LanguageCode.EN, Collections.emptySet(), DEFAULT_CONFIDENCE_THRESHOLD, RedactionMode.MASK_WITH_TYPE);
    }

    /**
     * Redacts detected PII entities with configurable target types and confidence threshold.
     *
     * @param text                The raw input text to redact.
     * @param languageCode        The AWS Comprehend language code (e.g. LanguageCode.EN).
     * @param targetTypes         The specific PiiEntityTypes to redact. If empty, redacts all detected types.
     * @param minScoreThreshold  Minimum confidence threshold (0.0 to 1.0) to qualify for redaction.
     * @param mode                The redaction formatting mode.
     * @return The redacted text.
     */
    public String redact(String text,
                         LanguageCode languageCode,
                         Set<PiiEntityType> targetTypes,
                         double minScoreThreshold,
                         RedactionMode mode) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by score threshold and target types
        List<PiiEntity> filteredEntities = entities.stream()
                .filter(entity -> entity.score() != null && entity.score() >= minScoreThreshold)
                .filter(entity -> targetTypes == null || targetTypes.isEmpty() || targetTypes.contains(entity.type()))
                // Sort by beginOffset descending to avoid offset shifting during replacement
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder sb = new StringBuilder(text);

        for (PiiEntity entity : filteredEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start < 0 || end > sb.length() || start >= end) {
                continue;
            }

            String replacement;
            switch (mode) {
                case ASTERISKS:
                    replacement = "*".repeat(end - start);
                    break;
                case GENERIC_LABEL:
                    replacement = "[REDACTED]";
                    break;
                case MASK_WITH_TYPE:
                default:
                    replacement = "[" + entity.typeAsString() + "]";
                    break;
            }

            sb.replace(start, end, replacement);
        }

        return sb.toString();
    }

    public List<PiiEntity> detectEntities(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();
        return comprehendClient.detectPiiEntities(request).entities();
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }

    public enum RedactionMode {
        MASK_WITH_TYPE,  // e.g. [SSN], [PHONE], [EMAIL]
        GENERIC_LABEL,   // e.g. [REDACTED]
        ASTERISKS        // e.g. ********** matching original length
    }
}
