package com.edgechains.lib.aws;

import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AWSComprehendRedactor implements AutoCloseable {

    private static final int MAX_BYTE_LENGTH = 100_000; // AWS Comprehend limit per request
    private static final float DEFAULT_CONFIDENCE_THRESHOLD = 0.65f;

    public enum RedactionStrategy {
        MASK_WITH_TAG,       // Replaces with [NAME], [EMAIL], etc.
        MASK_WITH_LABEL,     // Replaces with [REDACTED]
        MASK_WITH_ASTERISKS  // Replaces text with matching length of '*'
    }

    public static class RedactionOptions {
        private final LanguageCode languageCode;
        private final float minConfidenceScore;
        private final RedactionStrategy strategy;
        private final List<String> targetEntityTypes; // null or empty means all

        public RedactionOptions(LanguageCode languageCode, float minConfidenceScore,
                                RedactionStrategy strategy, List<String> targetEntityTypes) {
            this.languageCode = languageCode != null ? languageCode : LanguageCode.EN;
            this.minConfidenceScore = minConfidenceScore;
            this.strategy = strategy != null ? strategy : RedactionStrategy.MASK_WITH_TAG;
            this.targetEntityTypes = targetEntityTypes;
        }

        public static RedactionOptions defaultOptions() {
            return new RedactionOptions(LanguageCode.EN, DEFAULT_CONFIDENCE_THRESHOLD, RedactionStrategy.MASK_WITH_TAG, null);
        }
    }

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public AWSComprehendRedactor() {
        this(ComprehendClient.builder().build(), true);
    }

    public AWSComprehendRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), true);
    }

    public AWSComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AWSComprehendRedactor(ComprehendClient comprehendClient, boolean manageClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.manageClientLifecycle = manageClientLifecycle;
    }

    /**
     * Redacts PII entities in the input text using default options.
     */
    public String redact(String text) {
        return redact(text, RedactionOptions.defaultOptions());
    }

    /**
     * Redacts PII entities in the input text using custom options.
     */
    public String redact(String text, RedactionOptions options) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        byte[] textBytes = text.getBytes(StandardCharsets.UTF_8);
        if (textBytes.length <= MAX_BYTE_LENGTH) {
            return redactChunk(text, options);
        }

        return redactLargeText(text, options);
    }

    private String redactChunk(String text, RedactionOptions options) {
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(options.languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = new ArrayList<>(response.entities());

        // Sort descending by beginOffset so replacements do not invalidate earlier offsets
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder redacted = new StringBuilder(text);

        for (PiiEntity entity : entities) {
            if (entity.score() < options.minConfidenceScore) {
                continue;
            }

            String entityType = entity.typeAsString();
            if (options.targetEntityTypes != null && !options.targetEntityTypes.isEmpty()
                    && !options.targetEntityTypes.contains(entityType)) {
                continue;
            }

            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start < 0 || end > redacted.length() || start >= end) {
                continue;
            }

            String replacement;
            switch (options.strategy) {
                case MASK_WITH_TAG:
                    replacement = "[" + entityType + "]";
                    break;
                case MASK_WITH_LABEL:
                    replacement = "[REDACTED]";
                    break;
                case MASK_WITH_ASTERISKS:
                    replacement = "*".repeat(end - start);
                    break;
                default:
                    replacement = "[REDACTED]";
            }

            redacted.replace(start, end, replacement);
        }

        return redacted.toString();
    }

    private String redactLargeText(String text, RedactionOptions options) {
        // Break by line boundaries to keep UTF-8 chunks safely under the 100KB limit
        String[] lines = text.split("(?<=\n)");
        StringBuilder currentChunk = new StringBuilder();
        StringBuilder totalRedacted = new StringBuilder();

        for (String line : lines) {
            byte[] lineBytes = line.getBytes(StandardCharsets.UTF_8);
            byte[] currentBytes = currentChunk.toString().getBytes(StandardCharsets.UTF_8);

            if (currentBytes.length + lineBytes.length > MAX_BYTE_LENGTH) {
                if (currentChunk.length() > 0) {
                    totalRedacted.append(redactChunk(currentChunk.toString(), options));
                    currentChunk.setLength(0);
                }
            }

            currentChunk.append(line);
        }

        if (currentChunk.length() > 0) {
            totalRedacted.append(redactChunk(currentChunk.toString(), options));
        }

        return totalRedacted.toString();
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
