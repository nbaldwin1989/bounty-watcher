package com.edgechains.lib.aws;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;
import java.util.Set;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactionUtilTest {

    private ComprehendClient comprehendClientMock;
    private AwsComprehendRedactionUtil redactionUtil;

    @BeforeEach
    void setUp() {
        comprehendClientMock = Mockito.mock(ComprehendClient.class);
        redactionUtil = new AwsComprehendRedactionUtil(comprehendClientMock);
    }

    @Test
    void testRedactPiiWithLabelStrategy() {
        String input = "My email is user@example.com and phone is 555-0199.";

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(12)
                .endOffset(28)
                .score(0.99f)
                .build();

        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(42)
                .endOffset(50)
                .score(0.95f)
                .build();

        when(comprehendClientMock.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(emailEntity, phoneEntity)).build());

        String result = redactionUtil.redactPii(input);
        assertEquals("My email is [EMAIL] and phone is [PHONE].", result);
    }

    @Test
    void testRedactPiiWithMaskStrategy() {
        String input = "User SSN is 000-00-0000.";

        PiiEntity ssnEntity = PiiEntity.builder()
                .type(PiiEntityType.SSN)
                .beginOffset(12)
                .endOffset(23)
                .score(0.98f)
                .build();

        when(comprehendClientMock.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(ssnEntity)).build());

        String result = redactionUtil.redactPii(
                input,
                LanguageCode.EN,
                AwsComprehendRedactionUtil.RedactionStrategy.MASK,
                Set.of(PiiEntityType.SSN),
                0.8f,
                '*'
        );
        assertEquals("User SSN is [REDACTED].", result);
    }

    @Test
    void testRedactPiiWithCharacterMaskStrategy() {
        String input = "Secret: 12345";

        PiiEntity entity = PiiEntity.builder()
                .type(PiiEntityType.PIN)
                .beginOffset(8)
                .endOffset(13)
                .score(0.90f)
                .build();

        when(comprehendClientMock.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(entity)).build());

        String result = redactionUtil.redactPii(
                input,
                LanguageCode.EN,
                AwsComprehendRedactionUtil.RedactionStrategy.CHARACTER,
                null,
                0.7f,
                '#'
        );
        assertEquals("Secret: #####", result);
    }

    @Test
    void testEmptyAndNullInputs() {
        assertEquals("", redactionUtil.redactPii(""));
        assertEquals(null, redactionUtil.redactPii(null));
    }
}
