```java
package org.arakoodev.edgechains.utils;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactorTest {

    private ComprehendClient mockClient;
    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        mockClient = Mockito.mock(ComprehendClient.class);
        redactor = AwsComprehendRedactor.builder()
                .comprehendClient(mockClient)
                .strategy(AwsComprehendRedactor.RedactionStrategy.ENTITY_TYPE)
                .minScoreThreshold(0.7f)
                .build();
    }

    @AfterEach
    void tearDown() {
        redactor.close();
    }

    @Test
    void testRedactPiiEntities() {
        String input = "Hello, my name is John Doe and my email is john@example.com.";

        PiiEntity nameEntity = PiiEntity.builder()
                .beginOffset(18)
                .endOffset(26)
                .type(PiiEntityType.NAME)
                .score(0.99f)
                .build();

        PiiEntity emailEntity = PiiEntity.builder()
                .beginOffset(44)
                .endOffset(60)
                .type(PiiEntityType.EMAIL)
                .score(0.95f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(nameEntity, emailEntity))
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redact(input);
        assertEquals("Hello, my name is [NAME] and my email is [EMAIL].", result);
    }
}
