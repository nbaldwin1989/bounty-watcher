```java
// src/main/java/com/edgechains/lib/aws/comprehend/AwsComprehendRedactor.java
package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.EnumSet;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.function.Function;

public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean managesClientLifecycle;
    private final LanguageCode defaultLanguageCode;
    private final float defaultMinScore;
    private final MaskingStrategy defaultStrategy;
    private final Set<PiiEntityType> includedEntityTypes;

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false, LanguageCode.EN, 0.5f, MaskingStrategy.ENTITY_TAG, null);
    }

    private AwsComprehendRedactor(
            ComprehendClient comprehendClient,
            boolean managesClientLifecycle,
            LanguageCode defaultLanguageCode,
            float defaultMinScore,
            MaskingStrategy defaultStrategy,
            Set<PiiEntityType> includedEntityTypes
    ) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.managesClientLifecycle = managesClientLifecycle;
        this.defaultLanguageCode = defaultLanguageCode != null ? defaultLanguageCode : LanguageCode.EN;
        this.defaultMinScore = defaultMinScore;
        this.defaultStrategy = defaultStrategy != null ? defaultStrategy : MaskingStrategy.ENTITY_TAG;
        this.includedEntityTypes = includedEntityTypes;
    }

    public static Builder builder() {
        return new Builder();
    }

    public String redact(String text) {
        return redact(text, this.defaultStrategy, this.defaultMinScore, this.defaultLanguageCode);
    }

    public String redact(String text, MaskingStrategy strategy) {
        return redact(text, strategy, this.defaultMinScore, this.defaultLanguageCode);
    }

    public String redact(String text, MaskingStrategy strategy, float minConfidenceScore, LanguageCode languageCode) {
        return redactDetailed(text, strategy, minConfidenceScore, languageCode, null).getRedactedText();
    }

    public PiiDetectionResult redactDetailed(String text) {
        return redactDetailed(text, this.defaultStrategy, this.defaultMinScore, this.defaultLanguageCode, null);
    }

    public PiiDetectionResult redactDetailed(
            String text,
            MaskingStrategy strategy,
            float minConfidenceScore,
            LanguageCode languageCode,
            Function<PiiEntity, String> customReplacer
    ) {
        if (text == null || text.isBlank()) {
            return new PiiDetectionResult(text, text, List.of());
        }

        List<PiiEntity> entities = detectPii(text, languageCode);
        List<PiiEntity> filteredEntities = filterAndResolveEntities(entities, minConfidenceScore);

        if (filteredEntities.isEmpty()) {
            return new PiiDetectionResult(text, text, List.of());
        }

        StringBuilder redacted = new StringBuilder(text.length());
        int lastOffset = 0;

        for (PiiEntity entity : filteredEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start > lastOffset) {
                redacted.append(text, lastOffset, start);
            }

            String replacement;
            if (customReplacer != null) {
                replacement = customReplacer.apply(entity);
            } else {
                replacement = formatMask(entity, text.substring(start, end), strategy);
            }
            redacted.append(replacement);
            lastOffset = end;
        }

        if (lastOffset < text.length()) {
            redacted.append(text, lastOffset, text.length());
        }

        return new PiiDetectionResult(text, redacted.toString(), filteredEntities);
    }

    public List<PiiEntity> detectPii(String text) {
        return detectPii(text, this.defaultLanguageCode);
    }

    public List<PiiEntity> detectPii(String text, LanguageCode languageCode) {
        if (text == null || text.isBlank()) {
            return List.of();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : this.defaultLanguageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.entities();
    }

    public boolean containsPii(String text) {
        return containsPii(text, this.defaultMinScore, this.defaultLanguageCode);
    }

    public boolean containsPii(String text, float minConfidenceScore, LanguageCode languageCode) {
        return !filterAndResolveEntities(detectPii(text, languageCode), minConfidenceScore).isEmpty();
    }

    private List<PiiEntity> filterAndResolveEntities(List<PiiEntity> entities, float minConfidenceScore) {
        if (entities == null || entities.isEmpty()) {
            return List.of();
        }

        List<PiiEntity> qualified = entities.stream()
                .filter(e -> e.score() != null && e.score() >= minConfidenceScore)
                .filter(e -> includedEntityTypes == null || includedEntityTypes.contains(e.type()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset)
                        .thenComparing(Comparator.comparingInt(PiiEntity::endOffset).reversed()))
                .toList();

        List<PiiEntity> nonOverlapping = new ArrayList<>();
        int currentEnd = -1;

        for (PiiEntity entity : qualified) {
            if (entity.beginOffset() >= currentEnd) {
                nonOverlapping.add(entity);
                currentEnd = entity.endOffset();
            }
        }

        return nonOverlapping;
    }

    private String formatMask(PiiEntity entity, String originalSpan, MaskingStrategy strategy) {
        return switch (strategy) {
            case ENTITY_TAG -> "[" + entity.typeAsString() + "]";
            case REDACTED_TAG -> "[REDACTED]";
            case ASTERISKS -> "*".repeat(Math.max(1, originalSpan.length()));
            case FIXED_MASK -> "***";
        };
    }

    @Override
    public void close() {
        if (managesClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }

    public static class Builder {
        private ComprehendClient comprehendClient;
        private Region region = Region.US_EAST_1;
        private AwsCredentialsProvider credentialsProvider;
        private LanguageCode defaultLanguageCode = LanguageCode.EN;
        private float defaultMinScore = 0.5f;
        private MaskingStrategy defaultStrategy = MaskingStrategy.ENTITY_TAG;
        private Set<PiiEntityType> includedEntityTypes;

        public Builder client(ComprehendClient client) {
            this.comprehendClient = client;
            return this;
        }

        public Builder region(Region region) {
            this.region = region;
            return this;
        }

        public Builder credentialsProvider(AwsCredentialsProvider credentialsProvider) {
            this.credentialsProvider = credentialsProvider;
            return this;
        }

        public Builder defaultLanguageCode(LanguageCode languageCode) {
            this.defaultLanguageCode = languageCode;
            return this;
        }

        public Builder defaultMinScore(float minScore) {
            this.defaultMinScore = minScore;
            return this;
        }

        public Builder defaultStrategy(MaskingStrategy strategy) {
            this.defaultStrategy = strategy;
            return this;
        }

        public Builder targetEntities(Set<PiiEntityType> entityTypes) {
            this.includedEntityTypes = entityTypes != null ? EnumSet.copyOf(entityTypes) : null;
            return this;
        }

        public AwsComprehendRedactor build() {
            boolean ownsClient = false;
            ComprehendClient client = this.comprehendClient;
            if (client == null) {
                ownsClient = true;
                var clientBuilder = ComprehendClient.builder().region(this.region);
                if (this.credentialsProvider != null) {
                    clientBuilder.credentialsProvider(this.credentialsProvider);
                } else {
                    clientBuilder.credentialsProvider(DefaultCredentialsProvider.create());
                }
                client = clientBuilder.build();
            }

            return new AwsComprehendRedactor(
                    client,
                    ownsClient,
                    this.defaultLanguageCode,
                    this.defaultMinScore,
                    this.defaultStrategy,
                    this.includedEntityTypes
            );
        }
    }
}
