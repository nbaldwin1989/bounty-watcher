```java
package com.edgechains.lib.aws.comprehend;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class AwsComprehendRedactionServiceTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactionService service;

    @BeforeEach
    void setUp() {
        service = new AwsComprehendRedactionService(comprehendClient);
    }

    @AfterEach
    void tearDown() {
        service.close();
    }

    @Test
    void redactPii_withEntityTypeMode_replacesEntitiesCorrectly() {
        String input = "My name is John Doe and my email is john.doe@example.com.";

        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(11)
                .endOffset(19)
                .score(0.99f)
                .build();

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(36)
                .endOffset(56)
                .score(0.98f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(nameEntity, emailEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = service.redactPii(input);
        assertEquals("My name is [NAME] and my email is [EMAIL].", result);
    }

    @Test
    void redactPii_withMaskCharacterMode_masksCorrectly() {
        String input = "Call me at 123-456-7890.";

        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(11)
                .endOffset(23)
                .score(0.95f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(phoneEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = service.redactPii(
                input,
                LanguageCode.EN,
                AwsComprehendRedactionService.RedactionMode.MASK_CHARACTER,
                '*',
                0.80f
        );

        assertEquals("Call me at ************.", result);
    }
}
