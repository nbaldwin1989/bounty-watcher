### 1. AWS Comprehend Data Redaction Utility (`arakoodev/EdgeChains#290`)

#### Gradle Dependency (`build.gradle.kts` / `pom.xml`)
```kotlin
implementation(platform("software.amazon.awssdk:bom:2.25.16"))
implementation("software.amazon.awssdk:comprehend")
```

#### `AwsComprehendRedactor.java`
```java
package com.arakoodev.edgechains.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;

/**
 * Utility for detecting and redacting PII data using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private static final int AWS_COMPREHEND_MAX_BYTES = 5000;
    private static final double DEFAULT_MIN_SCORE = 0.50;

    private final ComprehendClient comprehendClient;
    private final boolean autoCloseClient;

    public enum RedactionMaskType {
        GENERIC,      // Replaces with [REDACTED]
        ENTITY_TYPE,  // Replaces with [REDACTED_SSN], [REDACTED_EMAIL], etc.
        ASTERISK      // Masks matching characters with *
    }

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(Region.US_EAST_1)
                .build(), true);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .credentialsProvider(credentialsProvider)
                .region(region)
                .build(), true);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, boolean autoCloseClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.autoCloseClient = autoCloseClient;
    }

    /**
     * Redact PII entities using default settings (English, [REDACTED] mask, score >= 0.50).
     */
    public String redact(String text) {
        return redact(text, LanguageCode.EN, RedactionMaskType.GENERIC, DEFAULT_MIN_SCORE);
    }

    /**
     * Redact PII entities with custom options.
     */
    public String redact(String text, LanguageCode languageCode, RedactionMaskType maskType, double minScore) {
        if (text == null || text.isBlank()) {
            return text;
        }

        // Handle texts exceeding AWS Comprehend 5KB byte payload limit
        if (text.getBytes(StandardCharsets.UTF_8).length > AWS_COMPREHEND_MAX_BYTES) {
            return redactLargeText(text, languageCode, maskType, minScore);
        }

        return redactChunk(text, languageCode, maskType, minScore);
    }

    private String redactChunk(String text, LanguageCode languageCode, RedactionMaskType maskType, double minScore) {
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode.toString() : LanguageCode.EN.toString())
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = new ArrayList<>(response.entities());

        // Sort descending by beginOffset to safely replace substrings in-place
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder redacted = new StringBuilder(text);

        for (PiiEntity entity : entities) {
            if (entity.score() != null && entity.score() < minScore) {
                continue;
            }

            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start >= 0 && end <= redacted.length() && start < end) {
                String replacement = getReplacement(maskType, entity, end - start);
                redacted.replace(start, end, replacement);
            }
        }

        return redacted.toString();
    }

    private String redactLargeText(String text, LanguageCode languageCode, RedactionMaskType maskType, double minScore) {
        // Split text by line/paragraph to stay within 5KB limits per chunk
        String[] lines = text.split("(?<=\n)");
        StringBuilder result = new StringBuilder();
        StringBuilder chunk = new StringBuilder();

        for (String line : lines) {
            if ((chunk.toString() + line).getBytes(StandardCharsets.UTF_8).length > AWS_COMPREHEND_MAX_BYTES) {
                result.append(redactChunk(chunk.toString(), languageCode, maskType, minScore));
                chunk.setLength(0);
            }
            chunk.append(line);
        }

        if (chunk.length() > 0) {
            result.append(redactChunk(chunk.toString(), languageCode, maskType, minScore));
        }

        return result.toString();
    }

    private String getReplacement(RedactionMaskType maskType, PiiEntity entity, int length) {
        return switch (maskType) {
            case ENTITY_TYPE -> "[REDACTED_" + entity.typeAsString() + "]";
            case ASTERISK -> "*".repeat(length);
            case GENERIC -> "[REDACTED]";
        };
    }

    @Override
    public void close() {
        if (autoCloseClient && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
```

