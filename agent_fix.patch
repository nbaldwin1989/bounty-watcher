// src/test/java/com/edgechains/lib/aws/comprehend/AwsComprehendRedactorTest.java
package com.edgechains.lib.aws.comprehend;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class AwsComprehendRedactorTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        redactor = new AwsComprehendRedactor(comprehendClient);
    }

    @Test
    void testRedactWithEntityTypeLabels() {
        String input = "Contact John Doe at john.doe@example.com or 555-0199.";

        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(8)
                .endOffset(16)
                .score(0.99f)
                .build();

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(20)
                .endOffset(40)
                .score(0.98f)
                .build();

        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(44)
                .endOffset(52)
                .score(0.95f)
                .build();

        DetectPiiEntitiesResponse mockResponse = DetectPiiEntitiesResponse.builder()
                .entities(List.of(nameEntity, emailEntity, phoneEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(mockResponse);

        RedactedResult result = redactor.redact(input);

        assertTrue(result.hasPii());
        assertEquals("Contact [NAME] at [EMAIL] or [PHONE].", result.getRedactedText());
    }

    @Test
    void testRedactWithFixedAsterisks() {
        String input = "SSN is 000-12-3456.";

        PiiEntity ssnEntity = PiiEntity.builder()
                .type(PiiEntityType.SSN)
                .beginOffset(7)
                .endOffset(18)
                .score(0.99f)
                .build();

        DetectPiiEntitiesResponse mockResponse = DetectPiiEntitiesResponse.builder()
                .entities(List.of(ssnEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(mockResponse);

        RedactionConfig config = RedactionConfig.builder()
                .maskStrategy(RedactionMaskStrategy.FIXED_ASTERISKS)
                .build();

        RedactedResult result = redactor.redact(input, config);

        assertEquals("SSN is ***.", result.getRedactedText());
    }

    @Test
    void testFilterByConfidenceScore() {
        String input = "May be John Doe.";

        PiiEntity lowConfidenceEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(7)
                .endOffset(15)
                .score(0.40f)
                .build();

        DetectPiiEntitiesResponse mockResponse = DetectPiiEntitiesResponse.builder()
                .entities(List.of(lowConfidenceEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(mockResponse);

        RedactionConfig config = RedactionConfig.builder()
                .minConfidenceScore(0.85f)
                .build();

        RedactedResult result = redactor.redact(input, config);

        assertFalse(result.hasPii());
        assertEquals(input, result.getRedactedText());
    }
}
