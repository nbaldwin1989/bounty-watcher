package com.edgechain.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.stream.Collectors;

/**
 * Utility and Service class for integrating AWS Comprehend to detect and redact
 * Personally Identifiable Information (PII) from text data.
 */
public class AwsComprehendRedactionService {

    private final ComprehendClient comprehendClient;
    private final LanguageCode defaultLanguageCode;

    public enum RedactionMaskType {
        ENTITY_TYPE,    // e.g., [NAME], [EMAIL], [SSN]
        GENERIC_MASK,   // e.g., [REDACTED]
        ASTERISKS       // e.g., ********
    }

    public AwsComprehendRedactionService(ComprehendClient comprehendClient) {
        this(comprehendClient, LanguageCode.EN);
    }

    public AwsComprehendRedactionService(ComprehendClient comprehendClient, LanguageCode defaultLanguageCode) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.defaultLanguageCode = defaultLanguageCode != null ? defaultLanguageCode : LanguageCode.EN;
    }

    public static AwsComprehendRedactionService create(String accessKey, String secretKey, Region region) {
        ComprehendClient client = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(StaticCredentialsProvider.create(
                        AwsBasicCredentials.create(accessKey, secretKey)))
                .build();
        return new AwsComprehendRedactionService(client);
    }

    /**
     * Detects PII entities in the provided text using the default language code.
     */
    public List<PiiEntity> detectPiiEntities(String text) {
        return detectPiiEntities(text, this.defaultLanguageCode);
    }

    /**
     * Detects PII entities in the provided text for a specific language code.
     */
    public List<PiiEntity> detectPiiEntities(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return List.of();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : this.defaultLanguageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.entities();
    }

    /**
     * Redacts PII entities from the text replacing them with [ENTITY_TYPE] (e.g., [EMAIL]).
     */
    public String redact(String text) {
        return redact(text, RedactionMaskType.ENTITY_TYPE, null, 0.5f);
    }

    /**
     * Redacts PII entities from the text with a specified mask type and minimum confidence score threshold.
     */
    public String redact(String text, RedactionMaskType maskType, String customMask, float minScoreThreshold) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        List<PiiEntity> entities = detectPiiEntities(text);
        return applyRedaction(text, entities, maskType, customMask, minScoreThreshold);
    }

    /**
     * Applies redaction to the text given detected PII entities.
     * Replaces characters in reverse index order to preserve offsets.
     */
    public static String applyRedaction(
            String text,
            List<PiiEntity> entities,
            RedactionMaskType maskType,
            String customMask,
            float minScoreThreshold) {

        if (text == null || entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by confidence score and sort in descending order of beginOffset
        List<PiiEntity> sortedEntities = entities.stream()
                .filter(e -> e.score() == null || e.score() >= minScoreThreshold)
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder redacted = new StringBuilder(text);

        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start < 0 || end > redacted.length() || start >= end) {
                continue;
            }

            String replacement;
            if (customMask != null && !customMask.isEmpty()) {
                replacement = customMask;
            } else {
                replacement = switch (maskType != null ? maskType : RedactionMaskType.ENTITY_TYPE) {
                    case GENERIC_MASK -> "[REDACTED]";
                    case ASTERISKS -> "*".repeat(end - start);
                    case ENTITY_TYPE -> "[" + entity.typeAsString() + "]";
                };
            }

            redacted.replace(start, end, replacement);
        }

        return redacted.toString();
    }
}
