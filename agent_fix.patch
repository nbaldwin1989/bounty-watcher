```java
package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.nio.charset.StandardCharsets;
import java.util.*;
import java.util.stream.Collectors;

/**
 * Utility to detect and redact PII (Personally Identifiable Information)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private static final int MAX_BYTE_SIZE = 100_000; // AWS Comprehend payload limit
    private static final float DEFAULT_THRESHOLD = 0.5f;

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;
    private final LanguageCode languageCode;
    private final float confidenceThreshold;
    private final Set<PiiEntityType> targetEntityTypes;
    private final RedactionMaskMode maskMode;
    private final String customMask;

    public enum RedactionMaskMode {
        ENTITY_TYPE,  // Replaces with [EMAIL], [SSN], [NAME], etc.
        FIXED_STRING, // Replaces with a fixed string, e.g. [REDACTED]
        ASTERISKS     // Replaces characters with *
    }

    public static class Builder {
        private ComprehendClient comprehendClient;
        private Region region = Region.US_EAST_1;
        private AwsCredentialsProvider credentialsProvider;
        private LanguageCode languageCode = LanguageCode.EN;
        private float confidenceThreshold = DEFAULT_THRESHOLD;
        private Set<PiiEntityType> targetEntityTypes = EnumSet.allOf(PiiEntityType.class);
        private RedactionMaskMode maskMode = RedactionMaskMode.ENTITY_TYPE;
        private String customMask = "[REDACTED]";

        public Builder comprehendClient(ComprehendClient client) {
            this.comprehendClient = client;
            return this;
        }

        public Builder region(Region region) {
            this.region = region;
            return this;
        }

        public Builder credentialsProvider(AwsCredentialsProvider credentialsProvider) {
            this.credentialsProvider = credentialsProvider;
            return this;
        }

        public Builder languageCode(LanguageCode languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public Builder confidenceThreshold(float threshold) {
            this.confidenceThreshold = threshold;
            return this;
        }

        public Builder targetEntityTypes(Set<PiiEntityType> entityTypes) {
            this.targetEntityTypes = entityTypes != null ? EnumSet.copyOf(entityTypes) : EnumSet.allOf(PiiEntityType.class);
            return this;
        }

        public Builder maskMode(RedactionMaskMode maskMode) {
            this.maskMode = maskMode;
            return this;
        }

        public Builder customMask(String customMask) {
            this.customMask = customMask;
            return this;
        }

        public AwsComprehendRedactor build() {
            boolean manageLifecycle = false;
            ComprehendClient client = this.comprehendClient;
            if (client == null) {
                var clientBuilder = ComprehendClient.builder().region(this.region);
                if (this.credentialsProvider != null) {
                    clientBuilder.credentialsProvider(this.credentialsProvider);
                } else {
                    clientBuilder.credentialsProvider(DefaultCredentialsProvider.create());
                }
                client = clientBuilder.build();
                manageLifecycle = true;
            }
            return new AwsComprehendRedactor(client, manageLifecycle, this.languageCode,
                    this.confidenceThreshold, this.targetEntityTypes, this.maskMode, this.customMask);
        }
    }

    public static Builder builder() {
        return new Builder();
    }

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder().credentialsProvider(DefaultCredentialsProvider.create()).build(),
                true, LanguageCode.EN, DEFAULT_THRESHOLD, EnumSet.allOf(PiiEntityType.class),
                RedactionMaskMode.ENTITY_TYPE, "[REDACTED]");
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false, LanguageCode.EN, DEFAULT_THRESHOLD,
                EnumSet.allOf(PiiEntityType.class), RedactionMaskMode.ENTITY_TYPE, "[REDACTED]");
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, boolean manageClientLifecycle,
                                  LanguageCode languageCode, float confidenceThreshold,
                                  Set<PiiEntityType> targetEntityTypes, RedactionMaskMode maskMode,
                                  String customMask) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "ComprehendClient must not be null");
        this.manageClientLifecycle = manageClientLifecycle;
        this.languageCode = languageCode;
        this.confidenceThreshold = confidenceThreshold;
        this.targetEntityTypes = targetEntityTypes;
        this.maskMode = maskMode;
        this.customMask = customMask;
    }

    /**
     * Redacts PII entities from the input text.
     *
     * @param text The input string to redact.
     * @return RedactionResult containing redacted text and detected entities.
     */
    public RedactionResult redact(String text) {
        if (text == null || text.isEmpty()) {
            return new RedactionResult(text, Collections.emptyList());
        }

        byte[] utf8Bytes = text.getBytes(StandardCharsets.UTF_8);
        if (utf8Bytes.length <= MAX_BYTE_SIZE) {
            return redactChunk(text);
        }

        return redactLargeText(text);
    }

    private RedactionResult redactChunk(String text) {
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(this.languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);

        List<PiiEntity> filteredEntities = response.entities().stream()
                .filter(entity -> entity.score() != null && entity.score() >= this.confidenceThreshold)
                .filter(entity -> this.targetEntityTypes.contains(entity.type()))
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset))
                .collect(Collectors.toList());

        List<PiiEntity> nonOverlapping = resolveOverlaps(filteredEntities);

        StringBuilder sb = new StringBuilder(text);
        List<PiiEntity> reverseSorted = new ArrayList<>(nonOverlapping);
        reverseSorted.sort((a, b) -> Integer.compare(b.beginOffset(), a.beginOffset()));

        for (PiiEntity entity : reverseSorted) {
            int start = entity.beginOffset();
            int end = entity.endOffset();
            String replacement = getReplacement(entity, text.substring(start, end));
            sb.replace(start, end, replacement);
        }

        return new RedactionResult(sb.toString(), nonOverlapping);
    }

    private RedactionResult redactLargeText(String text) {
        List<String> chunks = splitIntoChunks(text, MAX_BYTE_SIZE);
        StringBuilder redactedFull = new StringBuilder();
        List<PiiEntity> allEntities = new ArrayList<>();

        int globalOffset = 0;
        for (String chunk : chunks) {
            RedactionResult chunkResult = redactChunk(chunk);
            redactedFull.append(chunkResult.getRedactedText());

            for (PiiEntity e : chunkResult.getDetectedEntities()) {
                allEntities.add(PiiEntity.builder()
                        .type(e.type())
                        .score(e.score())
                        .beginOffset(e.beginOffset() + globalOffset)
                        .endOffset(e.endOffset() + globalOffset)
                        .build());
            }
            globalOffset += chunk.length();
        }

        return new RedactionResult(redactedFull.toString(), allEntities);
    }

    private List<PiiEntity> resolveOverlaps(List<PiiEntity> entities) {
        List<PiiEntity> resolved = new ArrayList<>();
        PiiEntity prev = null;
        for (PiiEntity curr : entities) {
            if (prev == null) {
                resolved.add(curr);
                prev = curr;
            } else if (curr.beginOffset() >= prev.endOffset()) {
                resolved.add(curr);
                prev = curr;
            } else {
                if (curr.score() > prev.score()) {
                    resolved.remove(resolved.size() - 1);
                    resolved.add(curr);
                    prev = curr;
                }
            }
        }
        return resolved;
    }

    private String getReplacement(PiiEntity entity, String originalText) {
        switch (this.maskMode) {
            case ENTITY_TYPE:
                return "[" + entity.typeAsString() + "]";
            case FIXED_STRING:
                return this.customMask;
            case ASTERISKS:
                return "*".repeat(originalText.length());
            default:
                return "[REDACTED]";
        }
    }

    private List<String> splitIntoChunks(String text, int maxBytes) {
        List<String> chunks = new ArrayList<>();
        String[] lines = text.split("(?<=\n)");
        StringBuilder currentChunk = new StringBuilder();
        int currentBytes = 0;

        for (String line : lines) {
            int lineBytes = line.getBytes(StandardCharsets.UTF_8).length;
            if (currentBytes + lineBytes > maxBytes && currentChunk.length() > 0) {
                chunks.add(currentChunk.toString());
                currentChunk = new StringBuilder();
                currentBytes = 0;
            }
            currentChunk.append(line);
            currentBytes += lineBytes;
        }
        if (currentChunk.length() > 0) {
            chunks.add(currentChunk.toString());
        }
        return chunks;
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }

    public static class RedactionResult {
        private final String redactedText;
        private final List<PiiEntity> detectedEntities;

        public RedactionResult(String redactedText, List<PiiEntity> detectedEntities) {
            this.redactedText = redactedText;
            this.detectedEntities = detectedEntities;
        }

        public String getRedactedText() {
            return redactedText;
        }

        public List<PiiEntity> getDetectedEntities() {
            return detectedEntities;
        }
    }
}
