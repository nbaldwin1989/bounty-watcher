// src/test/java/com/edgechains/lib/aws/comprehend/AwsComprehendRedactorTest.java
package com.edgechains.lib.aws.comprehend;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;
import java.util.Set;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactorTest {

    private ComprehendClient mockClient;
    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        mockClient = Mockito.mock(ComprehendClient.class);
        redactor = new AwsComprehendRedactor(mockClient);
    }

    @Test
    void testRedactEntityTypeStrategy() {
        String input = "Contact John Doe at john.doe@example.com immediately.";

        PiiEntity nameEntity = PiiEntity.builder()
                .beginOffset(8)
                .endOffset(16)
                .type(PiiEntityType.NAME)
                .score(0.99f)
                .build();

        PiiEntity emailEntity = PiiEntity.builder()
                .beginOffset(20)
                .endOffset(40)
                .type(PiiEntityType.EMAIL)
                .score(0.95f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(nameEntity, emailEntity))
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        RedactionConfig config = RedactionConfig.builder()
                .maskStrategy(RedactionMaskStrategy.ENTITY_TYPE)
                .build();

        RedactionResult result = redactor.redact(input, config);

        assertEquals("Contact [PII: NAME] at [PII: EMAIL] immediately.", result.getRedactedText());
        assertEquals(2, result.getRedactedEntities().size());
        assertEquals("John Doe", result.getRedactedEntities().get(0).getOriginalText());
        assertEquals("john.doe@example.com", result.getRedactedEntities().get(1).getOriginalText());
    }

    @Test
    void testRedactWithScoreThresholdFilter() {
        String input = "Call 555-0199 now.";

        PiiEntity lowConfidencePhone = PiiEntity.builder()
                .beginOffset(5)
                .endOffset(13)
                .type(PiiEntityType.PHONE)
                .score(0.35f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(lowConfidencePhone))
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        RedactionConfig config = RedactionConfig.builder()
                .minScoreThreshold(0.7f)
                .build();

        RedactionResult result = redactor.redact(input, config);

        assertEquals(input, result.getRedactedText());
        assertFalse(result.hasRedactions());
    }

    @Test
    void testRedactSpecificTargetTypesOnly() {
        String input = "User Alice with SSN 123-45-6789";

        PiiEntity nameEntity = PiiEntity.builder()
                .beginOffset(5)
                .endOffset(10)
                .type(PiiEntityType.NAME)
                .score(0.95f)
                .build();

        PiiEntity ssnEntity = PiiEntity.builder()
                .beginOffset(20)
                .endOffset(31)
                .type(PiiEntityType.SSN)
                .score(0.99f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(nameEntity, ssnEntity))
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        RedactionConfig config = RedactionConfig.builder()
                .targetEntityTypes(Set.of(PiiEntityType.SSN))
                .maskStrategy(RedactionMaskStrategy.GENERIC)
                .customMask("[CONFIDENTIAL]")
                .build();

        RedactionResult result = redactor.redact(input, config);

        assertEquals("User Alice with SSN [CONFIDENTIAL]", result.getRedactedText());
        assertEquals(1, result.getRedactedEntities().size());
    }
}
