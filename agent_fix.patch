package com.edgechain.lib.aws.comprehend;

import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * from text using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    public enum MaskMode {
        /** Replaces PII with entity type placeholder, e.g. [EMAIL], [NAME] */
        ENTITY_TYPE,
        /** Replaces each character with an asterisk or masks with fixed asterisks */
        ASTERISKS,
        /** Replaces PII with a custom replacement string */
        CUSTOM
    }

    public static class RedactionConfig {
        private String languageCode = "en";
        private float minScoreThreshold = 0.5f;
        private MaskMode maskMode = MaskMode.ENTITY_TYPE;
        private String customMask = "[REDACTED]";
        private boolean matchLengthForAsterisks = true;

        public static RedactionConfig defaultConfig() {
            return new RedactionConfig();
        }

        public RedactionConfig withLanguageCode(String languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public RedactionConfig withMinScoreThreshold(float minScoreThreshold) {
            this.minScoreThreshold = minScoreThreshold;
            return this;
        }

        public RedactionConfig withMaskMode(MaskMode maskMode) {
            this.maskMode = maskMode;
            return this;
        }

        public RedactionConfig withCustomMask(String customMask) {
            this.customMask = customMask;
            return this;
        }

        public RedactionConfig withMatchLengthForAsterisks(boolean matchLengthForAsterisks) {
            this.matchLengthForAsterisks = matchLengthForAsterisks;
            return this;
        }

        public String getLanguageCode() { return languageCode; }
        public float getMinScoreThreshold() { return minScoreThreshold; }
        public MaskMode getMaskMode() { return maskMode; }
        public String getCustomMask() { return customMask; }
        public boolean isMatchLengthForAsterisks() { return matchLengthForAsterisks; }
    }

    private final ComprehendClient comprehendClient;

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(DefaultCredentialsProvider.create())
                .build());
    }

    public AwsComprehendRedactor(String accessKeyId, String secretAccessKey, Region region) {
        AwsCredentialsProvider credentialsProvider = StaticCredentialsProvider.create(
                AwsBasicCredentials.create(accessKeyId, secretAccessKey)
        );
        this.comprehendClient = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build();
    }

    /**
     * Redacts PII from the given text using default configuration.
     *
     * @param text input text
     * @return redacted text
     */
    public String redact(String text) {
        return redact(text, RedactionConfig.defaultConfig());
    }

    /**
     * Redacts PII from the given text using the specified configuration.
     *
     * @param text input text
     * @param config redaction configuration
     * @return redacted text
     */
    public String redact(String text, RedactionConfig config) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(config.getLanguageCode())
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Filter by threshold and sort by beginOffset ascending
        List<PiiEntity> sortedEntities = entities.stream()
                .filter(e -> e.score() >= config.getMinScoreThreshold())
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset)
                        .thenComparing(Comparator.comparingInt(PiiEntity::endOffset).reversed()))
                .toList();

        // Resolve overlapping entities
        List<PiiEntity> nonOverlapping = new ArrayList<>();
        int maxEnd = -1;
        for (PiiEntity entity : sortedEntities) {
            if (entity.beginOffset() >= maxEnd) {
                nonOverlapping.add(entity);
                maxEnd = entity.endOffset();
            }
        }

        StringBuilder redacted = new StringBuilder();
        int currentIndex = 0;

        for (PiiEntity entity : nonOverlapping) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start > currentIndex) {
                redacted.append(text, currentIndex, start);
            }

            redacted.append(getMaskReplacement(entity, text, config));
            currentIndex = end;
        }

        if (currentIndex < text.length()) {
            redacted.append(text.substring(currentIndex));
        }

        return redacted.toString();
    }

    private String getMaskReplacement(PiiEntity entity, String originalText, RedactionConfig config) {
        return switch (config.getMaskMode()) {
            case ENTITY_TYPE -> "[" + entity.typeAsString() + "]";
            case CUSTOM -> config.getCustomMask();
            case ASTERISKS -> {
                if (config.isMatchLengthForAsterisks()) {
                    int length = entity.endOffset() - entity.beginOffset();
                    yield "*".repeat(Math.max(1, length));
                }
                yield "***";
            }
        };
    }

    @Override
    public void close() {
        if (comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
