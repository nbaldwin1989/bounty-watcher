### 1. `arakoodev/EdgeChains/issues/290`: AWS Comprehend Data Redaction Utility

#### `pom.xml` dependency
```xml
<dependency>
    <groupId>software.amazon.awssdk</groupId>
    <artifactId>comprehend</artifactId>
    <version>2.25.16</version>
</dependency>
```

#### `AwsComprehendRedactor.java`
```java
package org.arakoodev.edgechains.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.nio.charset.StandardCharsets;
import java.util.*;

/**
 * Utility service to detect and redact Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private static final int MAX_BYTE_SIZE = 100_000;
    private static final String DEFAULT_LANGUAGE_CODE = "en";
    private static final float DEFAULT_CONFIDENCE_THRESHOLD = 0.5f;

    private final ComprehendClient comprehendClient;
    private final boolean ownsClient;

    public enum RedactionStrategy {
        ENTITY_TYPE,    // e.g. [EMAIL], [SSN], [NAME]
        FIXED_STRING,   // e.g. [REDACTED]
        MASK_CHAR       // e.g. **********
    }

    public static class RedactionConfig {
        private String languageCode = DEFAULT_LANGUAGE_CODE;
        private float confidenceThreshold = DEFAULT_CONFIDENCE_THRESHOLD;
        private RedactionStrategy strategy = RedactionStrategy.ENTITY_TYPE;
        private String fixedMask = "[REDACTED]";
        private char maskChar = '*';
        private Set<String> targetEntities = Collections.emptySet(); // empty = redact all

        public static RedactionConfig createDefault() {
            return new RedactionConfig();
        }

        public RedactionConfig withLanguageCode(String languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public RedactionConfig withConfidenceThreshold(float threshold) {
            this.confidenceThreshold = threshold;
            return this;
        }

        public RedactionConfig withStrategy(RedactionStrategy strategy) {
            this.strategy = strategy;
            return this;
        }

        public RedactionConfig withFixedMask(String fixedMask) {
            this.fixedMask = fixedMask;
            return this;
        }

        public RedactionConfig withMaskChar(char maskChar) {
            this.maskChar = maskChar;
            return this;
        }

        public RedactionConfig withTargetEntities(Set<String> targetEntities) {
            this.targetEntities = targetEntities;
            return this;
        }

        public String getLanguageCode() { return languageCode; }
        public float getConfidenceThreshold() { return confidenceThreshold; }
        public RedactionStrategy getStrategy() { return strategy; }
        public String getFixedMask() { return fixedMask; }
        public char getMaskChar() { return maskChar; }
        public Set<String> getTargetEntities() { return targetEntities; }
    }

    public AwsComprehendRedactor() {
        this(Region.US_EAST_1, DefaultCredentialsProvider.create());
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this.comprehendClient = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build();
        this.ownsClient = true;
    }

    public AwsComprehendRedactor(ComprehendClient client) {
        this.comprehendClient = Objects.requireNonNull(client, "ComprehendClient cannot be null");
        this.ownsClient = false;
    }

    /**
     * Redacts PII from text using default configuration (replaces with [ENTITY_TYPE]).
     */
    public String redact(String text) {
        return redact(text, RedactionConfig.createDefault());
    }

    /**
     * Redacts PII from text using custom configuration.
     */
    public String redact(String text, RedactionConfig config) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        byte[] utf8Bytes = text.getBytes(StandardCharsets.UTF_8);
        if (utf8Bytes.length <= MAX_BYTE_SIZE) {
            return redactChunk(text, config);
        }

        return redactLargeText(text, config);
    }

    private String redactChunk(String text, RedactionConfig config) {
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(config.getLanguageCode())
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = new ArrayList<>(response.entities());

        // Sort descending by beginOffset to replace without invalidating prior indices
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder sb = new StringBuilder(text);
        int lastBeginOffset = Integer.MAX_VALUE;

        for (PiiEntity entity : entities) {
            if (entity.score() != null && entity.score() < config.getConfidenceThreshold()) {
                continue;
            }

            String entityType = entity.typeAsString();
            if (!config.getTargetEntities().isEmpty() && !config.getTargetEntities().contains(entityType)) {
                continue;
            }

            int begin = entity.beginOffset();
            int end = entity.endOffset();

            // Prevent overlapping modifications
            if (end > lastBeginOffset) {
                end = lastBeginOffset;
            }
            if (begin >= end) {
                continue;
            }

            String replacement = getReplacement(text.substring(begin, end), entityType, config);
            sb.replace(begin, end, replacement);
            lastBeginOffset = begin;
        }

        return sb.toString();
    }

    private String redactLargeText(String text, RedactionConfig config) {
        StringBuilder result = new StringBuilder();
        String[] lines = text.split("(?<=\n)");
        StringBuilder currentChunk = new StringBuilder();

        for (String line : lines) {
            if ((currentChunk.toString() + line).getBytes(StandardCharsets.UTF_8).length > (MAX_BYTE_SIZE - 1000)) {
                result.append(redactChunk(currentChunk.toString(), config));
                currentChunk.setLength(0);
            }
            currentChunk.append(line);
        }

        if (currentChunk.length() > 0) {
            result.append(redactChunk(currentChunk.toString(), config));
        }

        return result.toString();
    }

    private String getReplacement(String original, String entityType, RedactionConfig config) {
        switch (config.getStrategy()) {
            case FIXED_STRING:
                return config.getFixedMask();
            case MASK_CHAR:
                char[] chars = new char[original.length()];
                Arrays.fill(chars, config.getMaskChar());
                return new String(chars);
            case ENTITY_TYPE:
            default:
                return "[" + entityType + "]";
        }
    }

    @Override
    public void close() {
        if (ownsClient && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
```

