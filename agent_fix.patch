// src/main/java/com/edgechains/lib/aws/comprehend/RedactionConfig.java
package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Collections;
import java.util.HashSet;
import java.util.Set;

public class RedactionConfig {

    private final LanguageCode languageCode;
    private final float minConfidenceScore;
    private final RedactionMaskStrategy maskStrategy;
    private final String fixedLabel;
    private final Set<PiiEntityType> includedEntityTypes;
    private final Set<PiiEntityType> excludedEntityTypes;

    private RedactionConfig(Builder builder) {
        this.languageCode = builder.languageCode;
        this.minConfidenceScore = builder.minConfidenceScore;
        this.maskStrategy = builder.maskStrategy;
        this.fixedLabel = builder.fixedLabel;
        this.includedEntityTypes = builder.includedEntityTypes == null 
            ? Collections.emptySet() 
            : Collections.unmodifiableSet(builder.includedEntityTypes);
        this.excludedEntityTypes = builder.excludedEntityTypes == null 
            ? Collections.emptySet() 
            : Collections.unmodifiableSet(builder.excludedEntityTypes);
    }

    public LanguageCode getLanguageCode() {
        return languageCode;
    }

    public float getMinConfidenceScore() {
        return minConfidenceScore;
    }

    public RedactionMaskStrategy getMaskStrategy() {
        return maskStrategy;
    }

    public String getFixedLabel() {
        return fixedLabel;
    }

    public Set<PiiEntityType> getIncludedEntityTypes() {
        return includedEntityTypes;
    }

    public Set<PiiEntityType> getExcludedEntityTypes() {
        return excludedEntityTypes;
    }

    public static Builder builder() {
        return new Builder();
    }

    public static RedactionConfig defaultConfig() {
        return builder().build();
    }

    public static class Builder {
        private LanguageCode languageCode = LanguageCode.EN;
        private float minConfidenceScore = 0.70f;
        private RedactionMaskStrategy maskStrategy = RedactionMaskStrategy.ENTITY_TYPE_LABEL;
        private String fixedLabel = "[REDACTED]";
        private Set<PiiEntityType> includedEntityTypes = new HashSet<>();
        private Set<PiiEntityType> excludedEntityTypes = new HashSet<>();

        public Builder languageCode(LanguageCode languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public Builder minConfidenceScore(float minConfidenceScore) {
            this.minConfidenceScore = minConfidenceScore;
            return this;
        }

        public Builder maskStrategy(RedactionMaskStrategy maskStrategy) {
            this.maskStrategy = maskStrategy;
            return this;
        }

        public Builder fixedLabel(String fixedLabel) {
            this.fixedLabel = fixedLabel;
            return this;
        }

        public Builder includeEntityType(PiiEntityType type) {
            this.includedEntityTypes.add(type);
            return this;
        }

        public Builder excludeEntityType(PiiEntityType type) {
            this.excludedEntityTypes.add(type);
            return this;
        }

        public RedactionConfig build() {
            return new RedactionConfig(this);
        }
    }
}
