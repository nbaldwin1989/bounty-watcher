package org.edgechains.lib.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.*;
import java.util.function.Function;

/**
 * Utility to detect and redact Personally Identifiable Information (PII)
 * from text using AWS Comprehend.
 */
public class AwsComprehendRedactionUtil implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean clientManagedInternally;
    private final LanguageCode languageCode;
    private final float minConfidenceThreshold;
    private final Set<PiiEntityType> targetEntityTypes;
    private final RedactionStrategy redactionStrategy;

    public enum MaskStyle {
        GENERIC_TAG,      // e.g. [REDACTED]
        ENTITY_TYPE_TAG,  // e.g. [NAME], [EMAIL]
        CHARACTER_MASK    // e.g. **********
    }

    @FunctionalInterface
    public interface RedactionStrategy {
        String formatMask(PiiEntity entity, String originalSubstring);
    }

    private AwsComprehendRedactionUtil(Builder builder) {
        if (builder.comprehendClient != null) {
            this.comprehendClient = builder.comprehendClient;
            this.clientManagedInternally = false;
        } else {
            var clientBuilder = ComprehendClient.builder();
            if (builder.region != null) {
                clientBuilder.region(builder.region);
            }
            if (builder.credentialsProvider != null) {
                clientBuilder.credentialsProvider(builder.credentialsProvider);
            } else {
                clientBuilder.credentialsProvider(DefaultCredentialsProvider.create());
            }
            this.comprehendClient = clientBuilder.build();
            this.clientManagedInternally = true;
        }

        this.languageCode = builder.languageCode != null ? builder.languageCode : LanguageCode.EN;
        this.minConfidenceThreshold = builder.minConfidenceThreshold;
        this.targetEntityTypes = builder.targetEntityTypes != null && !builder.targetEntityTypes.isEmpty()
                ? Collections.unmodifiableSet(new HashSet<>(builder.targetEntityTypes))
                : Collections.emptySet();

        if (builder.customRedactionStrategy != null) {
            this.redactionStrategy = builder.customRedactionStrategy;
        } else {
            this.redactionStrategy = switch (builder.maskStyle) {
                case GENERIC_TAG -> (entity, original) -> "[REDACTED]";
                case ENTITY_TYPE_TAG -> (entity, original) -> "[" + entity.typeAsString() + "]";
                case CHARACTER_MASK -> (entity, original) -> "*".repeat(original.length());
            };
        }
    }

    public static Builder builder() {
        return new Builder();
    }

    public static AwsComprehendRedactionUtil create() {
        return builder().build();
    }

    /**
     * Redacts PII from the provided input string.
     *
     * @param text Original raw text containing sensitive data.
     * @return Sanitized text with PII entities masked/redacted.
     */
    public String redact(String text) {
        if (text == null || text.isBlank()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(this.languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = new ArrayList<>(response.entities());

        if (entities.isEmpty()) {
            return text;
        }

        // Filter by confidence score and targeted entity types
        entities.removeIf(entity -> entity.score() < this.minConfidenceThreshold
                || (!this.targetEntityTypes.isEmpty() && !this.targetEntityTypes.contains(entity.type())));

        // Sort entities descending by beginOffset to safely replace in-place
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder sb = new StringBuilder(text);
        int lastProcessedBegin = Integer.MAX_VALUE;

        for (PiiEntity entity : entities) {
            int begin = entity.beginOffset();
            int end = entity.endOffset();

            // Validate boundaries and prevent overlapping replacements
            if (begin < 0 || end > sb.length() || begin >= end || end > lastProcessedBegin) {
                continue;
            }

            String originalSubstring = sb.substring(begin, end);
            String replacement = redactionStrategy.formatMask(entity, originalSubstring);

            sb.replace(begin, end, replacement);
            lastProcessedBegin = begin;
        }

        return sb.toString();
    }

    /**
     * Redacts a batch of texts.
     *
     * @param texts Collection of strings to redact.
     * @return List of redacted strings.
     */
    public List<String> redactBatch(Collection<String> texts) {
        if (texts == null) {
            return Collections.emptyList();
        }
        return texts.stream().map(this::redact).toList();
    }

    /**
     * Detects entities without redacting, returning raw detected entities.
     */
    public List<PiiEntity> detect(String text) {
        if (text == null || text.isBlank()) {
            return Collections.emptyList();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(this.languageCode)
                .build();

        return comprehendClient.detectPiiEntities(request).entities().stream()
                .filter(e -> e.score() >= this.minConfidenceThreshold)
                .filter(e -> this.targetEntityTypes.isEmpty() || this.targetEntityTypes.contains(e.type()))
                .toList();
    }

    @Override
    public void close() {
        if (clientManagedInternally && comprehendClient != null) {
            comprehendClient.close();
        }
    }

    public static class Builder {
        private ComprehendClient comprehendClient;
        private Region region;
        private AwsCredentialsProvider credentialsProvider;
        private LanguageCode languageCode = LanguageCode.EN;
        private float minConfidenceThreshold = 0.70f;
        private Set<PiiEntityType> targetEntityTypes = new HashSet<>();
        private MaskStyle maskStyle = MaskStyle.ENTITY_TYPE_TAG;
        private RedactionStrategy customRedactionStrategy;

        public Builder comprehendClient(ComprehendClient client) {
            this.comprehendClient = client;
            return this;
        }

        public Builder region(Region region) {
            this.region = region;
            return this;
        }

        public Builder credentialsProvider(AwsCredentialsProvider credentialsProvider) {
            this.credentialsProvider = credentialsProvider;
            return this;
        }

        public Builder languageCode(LanguageCode languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public Builder minConfidenceThreshold(float minConfidenceThreshold) {
            this.minConfidenceThreshold = minConfidenceThreshold;
            return this;
        }

        public Builder targetEntityTypes(Set<PiiEntityType> entityTypes) {
            this.targetEntityTypes = entityTypes;
            return this;
        }

        public Builder addTargetEntityType(PiiEntityType entityType) {
            this.targetEntityTypes.add(entityType);
            return this;
        }

        public Builder maskStyle(MaskStyle maskStyle) {
            this.maskStyle = maskStyle;
            return this;
        }

        public Builder customRedactionStrategy(RedactionStrategy strategy) {
            this.customRedactionStrategy = strategy;
            return this;
        }

        public AwsComprehendRedactionUtil build() {
            return new AwsComprehendRedactionUtil(this);
        }
    }
}
