package com.edgechains.lib.comprehend;

import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.stream.Collectors;

/**
 * Utility service using AWS Comprehend to detect and redact Personally
 * Identifiable Information (PII) from text data.
 */
public class AwsComprehendDataRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public enum MaskingMode {
        /** Replaces PII with fixed tag: [REDACTED] */
        FIXED_TAG,
        /** Replaces PII with its entity type tag: e.g., [EMAIL], [NAME], [PHONE] */
        ENTITY_TYPE_TAG,
        /** Masks characters with asterisks: e.g., ******* */
        ASTERISKS
    }

    public static class RedactionConfig {
        private final LanguageCode languageCode;
        private final double minConfidenceScore;
        private final MaskingMode maskingMode;
        private final String customMaskTag;
        private final Set<PiiEntityType> targetEntityTypes;

        private RedactionConfig(Builder builder) {
            this.languageCode = builder.languageCode;
            this.minConfidenceScore = builder.minConfidenceScore;
            this.maskingMode = builder.maskingMode;
            this.customMaskTag = builder.customMaskTag;
            this.targetEntityTypes = builder.targetEntityTypes;
        }

        public LanguageCode getLanguageCode() { return languageCode; }
        public double getMinConfidenceScore() { return minConfidenceScore; }
        public MaskingMode getMaskingMode() { return maskingMode; }
        public String getCustomMaskTag() { return customMaskTag; }
        public Set<PiiEntityType> getTargetEntityTypes() { return targetEntityTypes; }

        public static Builder builder() {
            return new Builder();
        }

        public static RedactionConfig defaultConfig() {
            return builder().build();
        }

        public static class Builder {
            private LanguageCode languageCode = LanguageCode.EN;
            private double minConfidenceScore = 0.75;
            private MaskingMode maskingMode = MaskingMode.ENTITY_TYPE_TAG;
            private String customMaskTag = "[REDACTED]";
            private Set<PiiEntityType> targetEntityTypes = null;

            public Builder languageCode(LanguageCode languageCode) {
                this.languageCode = Objects.requireNonNull(languageCode);
                return this;
            }

            public Builder minConfidenceScore(double minConfidenceScore) {
                if (minConfidenceScore < 0.0 || minConfidenceScore > 1.0) {
                    throw new IllegalArgumentException("Confidence score must be between 0.0 and 1.0");
                }
                this.minConfidenceScore = minConfidenceScore;
                return this;
            }

            public Builder maskingMode(MaskingMode maskingMode) {
                this.maskingMode = Objects.requireNonNull(maskingMode);
                return this;
            }

            public Builder customMaskTag(String customMaskTag) {
                this.customMaskTag = Objects.requireNonNull(customMaskTag);
                return this;
            }

            public Builder targetEntityTypes(Set<PiiEntityType> targetEntityTypes) {
                this.targetEntityTypes = targetEntityTypes;
                return this;
            }

            public RedactionConfig build() {
                return new RedactionConfig(this);
            }
        }
    }

    public AwsComprehendDataRedactor() {
        this(ComprehendClient.builder().build(), true);
    }

    public AwsComprehendDataRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), true);
    }

    public AwsComprehendDataRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendDataRedactor(ComprehendClient comprehendClient, boolean manageClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "ComprehendClient cannot be null");
        this.manageClientLifecycle = manageClientLifecycle;
    }

    /**
     * Detects all PII entities in the provided text.
     */
    public List<PiiEntity> detectPii(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.entities() != null ? response.entities() : Collections.emptyList();
    }

    /**
     * Redacts PII from text using the default configuration.
     */
    public String redact(String text) {
        return redact(text, RedactionConfig.defaultConfig());
    }

    /**
     * Redacts PII from text using a custom RedactionConfig.
     */
    public String redact(String text, RedactionConfig config) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        List<PiiEntity> detectedEntities = detectPii(text, config.getLanguageCode());
        if (detectedEntities.isEmpty()) {
            return text;
        }

        List<PiiEntity> filtered = detectedEntities.stream()
                .filter(entity -> entity.score() != null && entity.score() >= config.getMinConfidenceScore())
                .filter(entity -> config.getTargetEntityTypes() == null || config.getTargetEntityTypes().contains(entity.type()))
                .collect(Collectors.toList());

        if (filtered.isEmpty()) {
            return text;
        }

        List<MergedSpan> spans = mergeOverlappingSpans(filtered, text, config);

        // Sort descending by start offset to prevent replacement offset displacement
        spans.sort(Comparator.comparingInt(MergedSpan::getStartOffset).reversed());

        StringBuilder redacted = new StringBuilder(text);
        for (MergedSpan span : spans) {
            int start = Math.max(0, span.getStartOffset());
            int end = Math.min(redacted.length(), span.getEndOffset());
            if (start < end) {
                redacted.replace(start, end, span.getReplacement());
            }
        }

        return redacted.toString();
    }

    private static class MergedSpan {
        private final int startOffset;
        private final int endOffset;
        private final String replacement;

        public MergedSpan(int startOffset, int endOffset, String replacement) {
            this.startOffset = startOffset;
            this.endOffset = endOffset;
            this.replacement = replacement;
        }

        public int getStartOffset() { return startOffset; }
        public int getEndOffset() { return endOffset; }
        public String getReplacement() { return replacement; }
    }

    private List<MergedSpan> mergeOverlappingSpans(List<PiiEntity> entities, String text, RedactionConfig config) {
        List<PiiEntity> sorted = new ArrayList<>(entities);
        sorted.sort(Comparator.comparingInt(PiiEntity::beginOffset)
                .thenComparingInt(PiiEntity::endOffset));

        List<MergedSpan> merged = new ArrayList<>();
        int currentStart = -1;
        int currentEnd = -1;
        List<PiiEntity> currentGroup = new ArrayList<>();

        for (PiiEntity entity : sorted) {
            if (currentStart == -1) {
                currentStart = entity.beginOffset();
                currentEnd = entity.endOffset();
                currentGroup.add(entity);
            } else if (entity.beginOffset() < currentEnd) {
                // Overlapping entity
                currentEnd = Math.max(currentEnd, entity.endOffset());
                currentGroup.add(entity);
            } else {
                merged.add(new MergedSpan(currentStart, currentEnd, determineReplacement(currentGroup, text, currentStart, currentEnd, config)));
                currentStart = entity.beginOffset();
                currentEnd = entity.endOffset();
                currentGroup.clear();
                currentGroup.add(entity);
            }
        }

        if (currentStart != -1) {
            merged.add(new MergedSpan(currentStart, currentEnd, determineReplacement(currentGroup, text, currentStart, currentEnd, config)));
        }

        return merged;
    }

    private String determineReplacement(List<PiiEntity> entities, String originalText, int start, int end, RedactionConfig config) {
        switch (config.getMaskingMode()) {
            case FIXED_TAG:
                return config.getCustomMaskTag();
            case ASTERISKS:
                int length = Math.max(1, end - start);
                return "*".repeat(length);
            case ENTITY_TYPE_TAG:
            default:
                if (entities.size() == 1) {
                    return "[" + entities.get(0).typeAsString() + "]";
                } else {
                    String types = entities.stream()
                            .map(PiiEntity::typeAsString)
                            .distinct()
                            .collect(Collectors.joining("/"));
                    return "[" + types + "]";
                }
        }
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
