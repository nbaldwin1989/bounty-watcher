```java
package com.edgechains.core.utils;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.ComprehendException;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.HashSet;
import java.util.List;
import java.util.Objects;
import java.util.Set;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactionUtil implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public enum RedactionMaskMode {
        ENTITY_TYPE, // e.g. [NAME], [EMAIL], [SSN]
        GENERIC_MASK, // e.g. [REDACTED]
        CHARACTER_MASK // e.g. *******
    }

    public static class RedactionConfig {
        private String languageCode = "en";
        private float minScoreThreshold = 0.5f;
        private RedactionMaskMode maskMode = RedactionMaskMode.ENTITY_TYPE;
        private char maskChar = '*';
        private String genericMask = "[REDACTED]";
        private Set<String> targetEntityTypes = Collections.emptySet();

        public RedactionConfig() {}

        public RedactionConfig setLanguageCode(String languageCode) {
            this.languageCode = languageCode;
            return this;
        }

        public RedactionConfig setMinScoreThreshold(float minScoreThreshold) {
            this.minScoreThreshold = minScoreThreshold;
            return this;
        }

        public RedactionConfig setMaskMode(RedactionMaskMode maskMode) {
            this.maskMode = maskMode;
            return this;
        }

        public RedactionConfig setMaskChar(char maskChar) {
            this.maskChar = maskChar;
            return this;
        }

        public RedactionConfig setGenericMask(String genericMask) {
            this.genericMask = genericMask;
            return this;
        }

        public RedactionConfig setTargetEntityTypes(Set<String> targetEntityTypes) {
            this.targetEntityTypes = targetEntityTypes != null ? new HashSet<>(targetEntityTypes) : Collections.emptySet();
            return this;
        }

        public String getLanguageCode() { return languageCode; }
        public float getMinScoreThreshold() { return minScoreThreshold; }
        public RedactionMaskMode getMaskMode() { return maskMode; }
        public char getMaskChar() { return maskChar; }
        public String getGenericMask() { return genericMask; }
        public Set<String> getTargetEntityTypes() { return targetEntityTypes; }
    }

    public AwsComprehendRedactionUtil(ComprehendClient comprehendClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.manageClientLifecycle = false;
    }

    public AwsComprehendRedactionUtil(Region region) {
        this(region, DefaultCredentialsProvider.create());
    }

    public AwsComprehendRedactionUtil(Region region, AwsCredentialsProvider credentialsProvider) {
        this.comprehendClient = ComprehendClient.builder()
                .region(Objects.requireNonNull(region, "region must not be null"))
                .credentialsProvider(Objects.requireNonNull(credentialsProvider, "credentialsProvider must not be null"))
                .build();
        this.manageClientLifecycle = true;
    }

    /**
     * Detects all PII entities present in the input text.
     */
    public List<PiiEntity> detectPiiEntities(String text, String languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return Collections.emptyList();
        }

        try {
            DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                    .text(text)
                    .languageCode(languageCode != null ? languageCode : "en")
                    .build();

            DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
            return response.hasEntities() ? response.entities() : Collections.emptyList();
        } catch (ComprehendException e) {
            throw new RuntimeException("Failed to detect PII entities using AWS Comprehend: " + e.awsErrorDetails().errorMessage(), e);
        }
    }

    /**
     * Redacts PII with default configuration.
     */
    public String redactPii(String text) {
        return redactPii(text, new RedactionConfig());
    }

    /**
     * Redacts PII with default configuration in the specified language.
     */
    public String redactPii(String text, String languageCode) {
        return redactPii(text, new RedactionConfig().setLanguageCode(languageCode));
    }

    /**
     * Redacts PII from text based on provided RedactionConfig.
     */
    public String redactPii(String text, RedactionConfig config) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        RedactionConfig activeConfig = config != null ? config : new RedactionConfig();
        List<PiiEntity> entities = detectPiiEntities(text, activeConfig.getLanguageCode());
        if (entities.isEmpty()) {
            return text;
        }

        // Filter by score threshold and target entity types
        List<PiiEntity> filtered = new ArrayList<>();
        for (PiiEntity entity : entities) {
            if (entity.score() != null && entity.score() < activeConfig.getMinScoreThreshold()) {
                continue;
            }
            if (!activeConfig.getTargetEntityTypes().isEmpty() &&
                !activeConfig.getTargetEntityTypes().contains(entity.typeAsString())) {
                continue;
            }
            filtered.add(entity);
        }

        if (filtered.isEmpty()) {
            return text;
        }

        // Sort descending by beginOffset to replace from end to beginning without invalidating offsets
        filtered.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder result = new StringBuilder(text);
        int lastProcessedBeginOffset = Integer.MAX_VALUE;

        for (PiiEntity entity : filtered) {
            int begin = entity.beginOffset();
            int end = entity.endOffset();

            // Validate boundaries
            if (begin < 0 || end > text.length() || begin >= end) {
                continue;
            }

            // Handle overlapping entities (skip if overlapping with already replaced span)
            if (end > lastProcessedBeginOffset) {
                continue;
            }

            String replacement = getReplacement(entity, end - begin, activeConfig);
            result.replace(begin, end, replacement);
            lastProcessedBeginOffset = begin;
        }

        return result.toString();
    }

    private String getReplacement(PiiEntity entity, int originalLength, RedactionConfig config) {
        switch (config.getMaskMode()) {
            case CHARACTER_MASK:
                return String.join("", Collections.nCopies(Math.max(1, originalLength), String.valueOf(config.getMaskChar())));
            case GENERIC_MASK:
                return config.getGenericMask();
            case ENTITY_TYPE:
            default:
                return "[" + (entity.typeAsString() != null ? entity.typeAsString() : "PII") + "]";
        }
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
