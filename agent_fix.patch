package com.arakoodev.edgechains.utils;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.*;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactionUtilTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactionUtil redactionUtil;
    private AutoCloseable mocks;

    @BeforeEach
    void setUp() {
        mocks = MockitoAnnotations.openMocks(this);
        redactionUtil = new AwsComprehendRedactionUtil(comprehendClient);
    }

    @AfterEach
    void tearDown() throws Exception {
        if (mocks != null) {
            mocks.close();
        }
    }

    @Test
    void testRedactPiiSuccess() {
        String input = "My name is John Doe and my phone number is 123-456-7890.";

        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(11)
                .endOffset(19)
                .score(0.99f)
                .build();

        PiiEntity phoneEntity = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(43)
                .endOffset(55)
                .score(0.98f)
                .build();

        DetectPiiEntitiesResponse mockResponse = DetectPiiEntitiesResponse.builder()
                .entities(List.of(nameEntity, phoneEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(mockResponse);

        String result = redactionUtil.redactPii(input);
        assertEquals("My name is [REDACTED] and my phone number is [REDACTED].", result);
    }

    @Test
    void testRedactPiiWithTypes() {
        String input = "My email is test@example.com";

        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(12)
                .endOffset(28)
                .score(0.95f)
                .build();

        DetectPiiEntitiesResponse mockResponse = DetectPiiEntitiesResponse.builder()
                .entities(List.of(emailEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(mockResponse);

        String result = redactionUtil.redactPiiWithTypes(input);
        assertEquals("My email is [REDACTED_EMAIL]", result);
    }
}
