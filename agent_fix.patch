// src/test/java/com/edgechains/lib/aws/comprehend/AwsComprehendRedactorTest.java
package com.edgechains.lib.aws.comprehend;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

class AwsComprehendRedactorTest {

    private ComprehendClient comprehendClient;
    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        comprehendClient = mock(ComprehendClient.class);
        redactor = new AwsComprehendRedactor(comprehendClient);
    }

    @Test
    void testRedactWithEntityTags() {
        String input = "Hello, my name is John Doe and my email is john@example.com.";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(18).endOffset(26).type(PiiEntityType.NAME).score(0.99f).build(),
                PiiEntity.builder().beginOffset(43).endOffset(59).type(PiiEntityType.EMAIL).score(0.98f).build()
        );

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        String result = redactor.redact(input);
        assertEquals("Hello, my name is [NAME] and my email is [EMAIL].", result);
    }

    @Test
    void testRedactWithRedactedTag() {
        String input = "Call me at 555-1234.";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(11).endOffset(19).type(PiiEntityType.PHONE).score(0.95f).build()
        );

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        String result = redactor.redact(input, MaskingStrategy.REDACTED_TAG);
        assertEquals("Call me at [REDACTED].", result);
    }

    @Test
    void testRedactIgnoresBelowThreshold() {
        String input = "My SSN is 000-00-0000.";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(10).endOffset(21).type(PiiEntityType.SSN).score(0.30f).build()
        );

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        String result = redactor.redact(input);
        assertEquals(input, result);
    }
}
