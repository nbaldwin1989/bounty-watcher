package org.edgechains.lib.utils;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactionUtilTest {

    private ComprehendClient comprehendClientMock;
    private AwsComprehendRedactionUtil redactor;

    @BeforeEach
    void setUp() {
        comprehendClientMock = Mockito.mock(ComprehendClient.class);
        redactor = AwsComprehendRedactionUtil.builder()
                .comprehendClient(comprehendClientMock)
                .maskStyle(AwsComprehendRedactionUtil.MaskStyle.ENTITY_TYPE_TAG)
                .minConfidenceThreshold(0.80f)
                .build();
    }

    @AfterEach
    void tearDown() {
        redactor.close();
    }

    @Test
    void testRedactSinglePiiEntity() {
        String text = "Contact John Doe at john.doe@example.com";
        PiiEntity emailEntity = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(19)
                .endOffset(39)
                .score(0.99f)
                .build();

        when(comprehendClientMock.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(emailEntity).build());

        String result = redactor.redact(text);
        assertEquals("Contact John Doe at [EMAIL]", result);
    }

    @Test
    void testRedactMultiplePiiEntitiesInOrder() {
        String text = "My name is Jane and my SSN is 000-12-3456.";
        PiiEntity nameEntity = PiiEntity.builder()
                .type(PiiEntityType.NAME)
                .beginOffset(11)
                .endOffset(15)
                .score(0.95f)
                .build();
        PiiEntity ssnEntity = PiiEntity.builder()
                .type(PiiEntityType.SSN)
                .beginOffset(30)
                .endOffset(41)
                .score(0.99f)
                .build();

        when(comprehendClientMock.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(nameEntity, ssnEntity).build());

        String result = redactor.redact(text);
        assertEquals("My name is [NAME] and my SSN is [SSN].", result);
    }

    @Test
    void testFilterByConfidenceThreshold() {
        String text = "Call 555-0199";
        PiiEntity lowConfidencePhone = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(5)
                .endOffset(13)
                .score(0.50f)
                .build();

        when(comprehendClientMock.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(lowConfidencePhone).build());

        String result = redactor.redact(text);
        assertEquals("Call 555-0199", result);
    }
}
