package com.edgechains.lib.utils.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Comparator;
import java.util.List;
import java.util.stream.Collectors;

/**
 * Utility to detect and redact Personally Identifiable Information (PII)
 * from text using AWS Comprehend.
 */
public class ComprehendRedactor {

    public enum RedactionStrategy {
        REPLACE_WITH_TAG, // e.g., [EMAIL], [NAME], [PHONE]
        REPLACE_REDACTED, // e.g., [REDACTED]
        MASK_ASTERISKS    // e.g., ********
    }

    private final ComprehendClient comprehendClient;
    private final String defaultLanguageCode;
    private final float minScoreThreshold;

    public ComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, "en", 0.5f);
    }

    public ComprehendRedactor(ComprehendClient comprehendClient, String defaultLanguageCode, float minScoreThreshold) {
        this.comprehendClient = comprehendClient;
        this.defaultLanguageCode = defaultLanguageCode;
        this.minScoreThreshold = minScoreThreshold;
    }

    public static ComprehendRedactor create(Region region) {
        return new ComprehendRedactor(ComprehendClient.builder().region(region).build());
    }

    public static ComprehendRedactor create(Region region, AwsCredentialsProvider credentialsProvider) {
        return new ComprehendRedactor(
                ComprehendClient.builder()
                        .region(region)
                        .credentialsProvider(credentialsProvider)
                        .build()
        );
    }

    /**
     * Redacts PII entities in the input text using the default [TYPE] tag replacement.
     */
    public String redact(String text) {
        return redact(text, this.defaultLanguageCode, RedactionStrategy.REPLACE_WITH_TAG);
    }

    /**
     * Redacts PII entities in the input text with configurable language and masking strategy.
     */
    public String redact(String text, String languageCode, RedactionStrategy strategy) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);

        List<PiiEntity> entities = response.entities().stream()
                .filter(entity -> entity.score() >= minScoreThreshold)
                // Sort descending by start offset to avoid index displacement during replacement
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder sb = new StringBuilder(text);
        for (PiiEntity entity : entities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            String replacement;
            switch (strategy) {
                case MASK_ASTERISKS:
                    replacement = "*".repeat(end - start);
                    break;
                case REPLACE_REDACTED:
                    replacement = "[REDACTED]";
                    break;
                case REPLACE_WITH_TAG:
                default:
                    replacement = "[" + entity.typeAsString() + "]";
                    break;
            }

            sb.replace(start, end, replacement);
        }

        return sb.toString();
    }
}
