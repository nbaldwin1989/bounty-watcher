package com.arakoodev.edgechains.utils;

import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Comparator;
import java.util.List;
import java.util.stream.Collectors;

/**
 * Utility to redact sensitive / PII data using AWS Comprehend.
 */
public class ComprehendDataRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final LanguageCode defaultLanguage;
    private final boolean closeClientOnShutdown;

    public ComprehendDataRedactor() {
        this(Region.US_EAST_1, LanguageCode.EN);
    }

    public ComprehendDataRedactor(Region region, LanguageCode defaultLanguage) {
        this.comprehendClient = ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(region)
                .build();
        this.defaultLanguage = defaultLanguage;
        this.closeClientOnShutdown = true;
    }

    public ComprehendDataRedactor(ComprehendClient comprehendClient, LanguageCode defaultLanguage) {
        this.comprehendClient = comprehendClient;
        this.defaultLanguage = defaultLanguage;
        this.closeClientOnShutdown = false;
    }

    /**
     * Redacts PII entities detected in the text with a generic '[REDACTED]' placeholder.
     *
     * @param text Input text containing sensitive information.
     * @return Redacted text.
     */
    public String redact(String text) {
        return redact(text, this.defaultLanguage, "[REDACTED]");
    }

    /**
     * Redacts PII entities detected in the text with the PII type tag (e.g. '[NAME]', '[EMAIL]').
     *
     * @param text Input text containing sensitive information.
     * @return Redacted text with entity-specific tags.
     */
    public String redactWithTypeLabels(String text) {
        return redact(text, this.defaultLanguage, null);
    }

    /**
     * Redacts PII entities detected in the text.
     *
     * @param text Input text.
     * @param language Language of the text.
     * @param maskPattern Replacement mask, or null to replace with [ENTITY_TYPE].
     * @return Redacted text.
     */
    public String redact(String text, LanguageCode language, String maskPattern) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(language)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Sort entities in reverse order of start offset to preserve indices during replacement
        List<PiiEntity> sortedEntities = entities.stream()
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder sb = new StringBuilder(text);
        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();
            String replacement = (maskPattern != null) ? maskPattern : "[" + entity.typeAsString() + "]";
            sb.replace(start, end, replacement);
        }

        return sb.toString();
    }

    @Override
    public void close() {
        if (closeClientOnShutdown && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
