#### `src/main/java/com/edgechains/lib/utils/aws/AwsComprehendRedactor.java`
```java
package com.edgechains.lib.utils.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.ComprehendClientBuilder;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;

public class AwsComprehendRedactor implements AutoCloseable {

    private static final int MAX_AWS_COMPREHEND_BYTES = 100_000;
    private static final float DEFAULT_CONFIDENCE_THRESHOLD = 0.8f;
    private static final LanguageCode DEFAULT_LANGUAGE_CODE = LanguageCode.EN;

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public AwsComprehendRedactor() {
        this(ComprehendClient.create(), true);
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), true);
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build(), true);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, boolean manageClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.manageClientLifecycle = manageClientLifecycle;
    }

    /**
     * Redacts PII from text using default English language, 0.8 confidence, and ENTITY_TYPE_LABEL strategy.
     */
    public String redact(String text) {
        return redact(text, DEFAULT_LANGUAGE_CODE, DEFAULT_CONFIDENCE_THRESHOLD, RedactionStrategy.ENTITY_TYPE_LABEL);
    }

    /**
     * Redacts PII from text with full customization.
     */
    public String redact(String text, LanguageCode languageCode, float confidenceThreshold, RedactionStrategy strategy) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        // Handle text exceeding AWS Comprehend 100KB payload limit by chunking paragraphs
        if (text.getBytes(StandardCharsets.UTF_8).length > MAX_AWS_COMPREHEND_BYTES) {
            return redactLargeText(text, languageCode, confidenceThreshold, strategy);
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = new ArrayList<>(response.entities());

        // Filter by confidence threshold
        entities.removeIf(e -> e.score() == null || e.score() < confidenceThreshold);

        // Sort descending by beginOffset to safely replace without invalidating previous offsets
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder sb = new StringBuilder(text);
        int lastProcessedStart = Integer.MAX_VALUE;

        for (PiiEntity entity : entities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Skip overlapping or out-of-bounds entities
            if (end > lastProcessedStart || start < 0 || end > sb.length()) {
                continue;
            }
            lastProcessedStart = start;

            String replacement = createReplacement(entity, end - start, strategy);
            sb.replace(start, end, replacement);
        }

        return sb.toString();
    }

    private String createReplacement(PiiEntity entity, int length, RedactionStrategy strategy) {
        switch (strategy) {
            case ASTERISKS:
                StringBuilder stars = new StringBuilder();
                for (int i = 0; i < length; i++) {
                    stars.append('*');
                }
                return stars.toString();
            case GENERIC_LABEL:
                return "[REDACTED]";
            case ENTITY_TYPE_LABEL:
            default:
                String typeName = entity.typeAsString() != null ? entity.typeAsString() : "PII";
                return "[" + typeName + "]";
        }
    }

    private String redactLargeText(String text, LanguageCode languageCode, float confidenceThreshold, RedactionStrategy strategy) {
        String[] lines = text.split("(?<=\n)");
        StringBuilder currentChunk = new StringBuilder();
        StringBuilder result = new StringBuilder();

        for (String line : lines) {
            if ((currentChunk.toString() + line).getBytes(StandardCharsets.UTF_8).length >= MAX_AWS_COMPREHEND_BYTES) {
                result.append(redact(currentChunk.toString(), languageCode, confidenceThreshold, strategy));
                currentChunk.setLength(0);
            }
            currentChunk.append(line);
        }

        if (currentChunk.length() > 0) {
            result.append(redact(currentChunk.toString(), languageCode, confidenceThreshold, strategy));
        }

        return result.toString();
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
```

#### `src/test/java/com/edgechains/lib/utils/aws/AwsComprehendRedactorTest.java`
```java
package com.edgechains.lib.utils.aws;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.Arrays;
import java.util.Collections;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
class AwsComprehendRedactorTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        redactor = new AwsComprehendRedactor(comprehendClient);
    }

    @Test
    void testRedactEntityTypeLabel() {
        String input = "Hello, my name is John Doe and my phone number is 123-456-7890.";

        PiiEntity nameEntity = PiiEntity.builder()
                .beginOffset(18)
                .endOffset(26)
                .type(PiiEntityType.NAME)
                .score(0.99f)
                .build();

        PiiEntity phoneEntity = PiiEntity.builder()
                .beginOffset(50)
                .endOffset(62)
                .type(PiiEntityType.PHONE)
                .score(0.95f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(Arrays.asList(nameEntity, phoneEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redact(input, LanguageCode.EN, 0.8f, RedactionStrategy.ENTITY_TYPE_LABEL);
        assertEquals("Hello, my name is [NAME] and my phone number is [PHONE].", result);
    }

    @Test
    void testRedactGenericLabel() {
        String input = "Secret token: ABC-12345";

        PiiEntity ssnEntity = PiiEntity.builder()
                .beginOffset(14)
                .endOffset(23)
                .type(PiiEntityType.AWS_ACCESS_KEY)
                .score(0.92f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(Collections.singletonList(ssnEntity))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redact(input, LanguageCode.EN, 0.8f, RedactionStrategy.GENERIC_LABEL);
        assertEquals("Secret token: [REDACTED]", result);
    }

    @Test
    void testLowConfidenceIgnored() {
        String input = "Contact Jane Doe.";

        PiiEntity lowConfidence = PiiEntity.builder()
                .beginOffset(8)
                .endOffset(16)
                .type(PiiEntityType.NAME)
                .score(0.40f)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(Collections.singletonList(lowConfidence))
                .build();

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redact(input, LanguageCode.EN, 0.8f, RedactionStrategy.ENTITY_TYPE_LABEL);
        assertEquals("Contact Jane Doe.", result);
    }
}
