```java
package com.edgechains.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.ComprehendException;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private static final int MAX_BYTE_SIZE = 100_000; // AWS Comprehend UTF-8 byte limit
    private static final float DEFAULT_MIN_CONFIDENCE = 0.5f;

    private final ComprehendClient comprehendClient;
    private final boolean autoCloseClient;

    public enum RedactionStrategy {
        MASK_WITH_ENTITY_TYPE, // e.g. [EMAIL], [NAME]
        MASK_WITH_PLACEHOLDER,  // e.g. [REDACTED]
        MASK_WITH_ASTERISK      // e.g. *********
    }

    public static class RedactionOptions {
        private final RedactionStrategy strategy;
        private final String customPlaceholder;
        private final float minConfidenceScore;
        private final LanguageCode languageCode;
        private final Set<String> targetEntityTypes;

        private RedactionOptions(Builder builder) {
            this.strategy = builder.strategy;
            this.customPlaceholder = builder.customPlaceholder;
            this.minConfidenceScore = builder.minConfidenceScore;
            this.languageCode = builder.languageCode;
            this.targetEntityTypes = builder.targetEntityTypes;
        }

        public static Builder builder() {
            return new Builder();
        }

        public static RedactionOptions defaultOptions() {
            return builder().build();
        }

        public static class Builder {
            private RedactionStrategy strategy = RedactionStrategy.MASK_WITH_ENTITY_TYPE;
            private String customPlaceholder = "[REDACTED]";
            private float minConfidenceScore = DEFAULT_MIN_CONFIDENCE;
            private LanguageCode languageCode = LanguageCode.EN;
            private Set<String> targetEntityTypes = Collections.emptySet();

            public Builder strategy(RedactionStrategy strategy) {
                this.strategy = Objects.requireNonNull(strategy, "strategy must not be null");
                return this;
            }

            public Builder customPlaceholder(String customPlaceholder) {
                this.customPlaceholder = Objects.requireNonNull(customPlaceholder, "customPlaceholder must not be null");
                return this;
            }

            public Builder minConfidenceScore(float minConfidenceScore) {
                if (minConfidenceScore < 0.0f || minConfidenceScore > 1.0f) {
                    throw new IllegalArgumentException("Confidence score must be between 0.0 and 1.0");
                }
                this.minConfidenceScore = minConfidenceScore;
                return this;
            }

            public Builder languageCode(LanguageCode languageCode) {
                this.languageCode = Objects.requireNonNull(languageCode, "languageCode must not be null");
                return this;
            }

            public Builder targetEntityTypes(Set<String> targetEntityTypes) {
                this.targetEntityTypes = targetEntityTypes != null ? targetEntityTypes : Collections.emptySet();
                return this;
            }

            public RedactionOptions build() {
                return new RedactionOptions(this);
            }
        }

        public RedactionStrategy getStrategy() { return strategy; }
        public String getCustomPlaceholder() { return customPlaceholder; }
        public float getMinConfidenceScore() { return minConfidenceScore; }
        public LanguageCode getLanguageCode() { return languageCode; }
        public Set<String> getTargetEntityTypes() { return targetEntityTypes; }
    }

    public AwsComprehendRedactor(Region region) {
        this(region, DefaultCredentialsProvider.create());
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider) {
        this.comprehendClient = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build();
        this.autoCloseClient = true;
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.autoCloseClient = false;
    }

    /**
     * Redacts PII entities from the input text using default options.
     *
     * @param text Raw input text to redact.
     * @return Redacted text.
     */
    public String redact(String text) {
        return redact(text, RedactionOptions.defaultOptions());
    }

    /**
     * Redacts PII entities from the input text according to the provided options.
     *
     * @param text Raw input text to redact.
     * @param options Redaction configuration options.
     * @return Redacted text.
     */
    public String redact(String text, RedactionOptions options) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        Objects.requireNonNull(options, "options must not be null");

        // Split text if it exceeds AWS Comprehend byte limit
        byte[] utf8Bytes = text.getBytes(StandardCharsets.UTF_8);
        if (utf8Bytes.length <= MAX_BYTE_SIZE) {
            return redactSingleChunk(text, options);
        }

        return redactLargeText(text, options);
    }

    private String redactSingleChunk(String text, RedactionOptions options) {
        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(options.getLanguageCode())
                .build();

        DetectPiiEntitiesResponse response;
        try {
            response = comprehendClient.detectPiiEntities(request);
        } catch (ComprehendException e) {
            throw new RuntimeException("Failed to detect PII entities via AWS Comprehend: " + e.awsErrorDetails().errorMessage(), e);
        }

        if (!response.hasEntities() || response.entities().isEmpty()) {
            return text;
        }

        List<PiiEntity> entities = new ArrayList<>(response.entities());

        // Filter by confidence and allowed types
        entities.removeIf(entity ->
                entity.score() < options.getMinConfidenceScore() ||
                (!options.getTargetEntityTypes().isEmpty() &&
                 !options.getTargetEntityTypes().contains(entity.typeAsString()))
        );

        if (entities.isEmpty()) {
            return text;
        }

        // Sort descending by beginOffset so replacing from end does not affect earlier offsets
        entities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder redacted = new StringBuilder(text);
        int lastProcessedBegin = Integer.MAX_VALUE;

        for (PiiEntity entity : entities) {
            int begin = entity.beginOffset();
            int end = entity.endOffset();

            // Ignore overlapping or out-of-bounds spans
            if (end > lastProcessedBegin || begin < 0 || end > redacted.length() || begin >= end) {
                continue;
            }

            String replacement = getReplacement(entity, options);
            redacted.replace(begin, end, replacement);
            lastProcessedBegin = begin;
        }

        return redacted.toString();
    }

    private String getReplacement(PiiEntity entity, RedactionOptions options) {
        return switch (options.getStrategy()) {
            case MASK_WITH_ENTITY_TYPE -> "[" + entity.typeAsString() + "]";
            case MASK_WITH_PLACEHOLDER -> options.getCustomPlaceholder();
            case MASK_WITH_ASTERISK -> "*".repeat(Math.max(1, entity.endOffset() - entity.beginOffset()));
        };
    }

    private String redactLargeText(String text, RedactionOptions options) {
        StringBuilder result = new StringBuilder();
        String[] lines = text.split("(?<=\n)");
        StringBuilder currentChunk = new StringBuilder();

        for (String line : lines) {
            if (currentChunk.toString().getBytes(StandardCharsets.UTF_8).length + line.getBytes(StandardCharsets.UTF_8).length > MAX_BYTE_SIZE) {
                result.append(redactSingleChunk(currentChunk.toString(), options));
                currentChunk.setLength(0);
            }
            currentChunk.append(line);
        }

        if (currentChunk.length() > 0) {
            result.append(redactSingleChunk(currentChunk.toString(), options));
        }

        return result.toString();
    }

    @Override
    public void close() {
        if (autoCloseClient && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
