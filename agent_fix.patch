package com.edgechains.lib.aws.comprehend;

public enum RedactionMaskStrategy {
    /** Replaces entity with bracketed entity type, e.g. "[SSN]", "[EMAIL]" */
    ENTITY_TYPE_LABEL,
    /** Replaces entity with fixed string, e.g. "[REDACTED]" */
    FIXED_LABEL,
    /** Replaces entity characters with asterisks matching original length, e.g. "********" */
    ASTERISKS_MATCH_LENGTH,
    /** Replaces entity with static asterisks, e.g. "***" */
    FIXED_ASTERISKS
}
