package com.arakoodev.edgechains.utils;

import software.amazon.awssdk.auth.credentials.AwsBasicCredentials;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.auth.credentials.StaticCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;

/**
 * Utility class to detect and redact Personally Identifiable Information (PII)
 * from text using AWS Comprehend.
 */
public class AwsComprehendRedactionUtil implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final LanguageCode defaultLanguageCode;
    private final float defaultThreshold;

    public AwsComprehendRedactionUtil(ComprehendClient comprehendClient) {
        this(comprehendClient, LanguageCode.EN, 0.5f);
    }

    public AwsComprehendRedactionUtil(ComprehendClient comprehendClient, LanguageCode defaultLanguageCode, float defaultThreshold) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.defaultLanguageCode = Objects.requireNonNull(defaultLanguageCode, "defaultLanguageCode must not be null");
        this.defaultThreshold = defaultThreshold;
    }

    public static AwsComprehendRedactionUtil create(Region region) {
        ComprehendClient client = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(DefaultCredentialsProvider.create())
                .build();
        return new AwsComprehendRedactionUtil(client);
    }

    public static AwsComprehendRedactionUtil create(String accessKeyId, String secretAccessKey, Region region) {
        ComprehendClient client = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(StaticCredentialsProvider.create(
                        AwsBasicCredentials.create(accessKeyId, secretAccessKey)))
                .build();
        return new AwsComprehendRedactionUtil(client);
    }

    /**
     * Detects all PII entities in the provided text using default settings.
     */
    public List<PiiEntity> detectPiiEntities(String text) {
        return detectPiiEntities(text, defaultLanguageCode);
    }

    /**
     * Detects all PII entities in the provided text for a specific language.
     */
    public List<PiiEntity> detectPiiEntities(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return List.of();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return response.entities();
    }

    /**
     * Redacts PII entities in the text using "[REDACTED]" as replacement.
     */
    public String redactPii(String text) {
        return redactPii(text, "[REDACTED]", defaultThreshold, defaultLanguageCode);
    }

    /**
     * Redacts PII entities with entity type labels, e.g. "[REDACTED_SSN]", "[REDACTED_NAME]".
     */
    public String redactPiiWithTypes(String text) {
        return redactPii(text, null, defaultThreshold, defaultLanguageCode);
    }

    /**
     * Redacts PII entities in the text.
     *
     * @param text         Source text to redact
     * @param maskTemplate Replacement string. If null, replaces with "[REDACTED_<ENTITY_TYPE>]"
     * @param minScore     Confidence threshold between 0.0 and 1.0 for redacting detected entities
     * @param languageCode AWS Comprehend language code
     * @return Redacted text
     */
    public String redactPii(String text, String maskTemplate, float minScore, LanguageCode languageCode) {
        if (text == null || text.isEmpty()) {
            return text;
        }

        List<PiiEntity> entities = detectPiiEntities(text, languageCode);
        if (entities.isEmpty()) {
            return text;
        }

        // Sort descending by beginOffset to safely replace in-place without invalidating subsequent offsets
        List<PiiEntity> sortedEntities = new ArrayList<>(entities);
        sortedEntities.sort(Comparator.comparingInt(PiiEntity::beginOffset).reversed());

        StringBuilder redacted = new StringBuilder(text);
        int lastProcessedStart = text.length() + 1;

        for (PiiEntity entity : sortedEntities) {
            if (entity.score() != null && entity.score() < minScore) {
                continue;
            }

            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Guard against invalid or overlapping bounds
            if (start < 0 || end > redacted.length() || start >= end || end > lastProcessedStart) {
                continue;
            }

            String replacement = (maskTemplate != null) 
                    ? maskTemplate 
                    : String.format("[REDACTED_%s]", entity.typeAsString());

            redacted.replace(start, end, replacement);
            lastProcessedStart = start;
        }

        return redacted.toString();
    }

    @Override
    public void close() {
        if (comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
