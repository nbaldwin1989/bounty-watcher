```java
package org.arakoodev.edgechains.utils;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactorTest {

    private ComprehendClient mockClient;
    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        mockClient = Mockito.mock(ComprehendClient.class);
        redactor = new AwsComprehendRedactor(mockClient, "en");
    }

    @Test
    void testRedactEntityTypeMask() {
        String input = "Contact John Doe at john@example.com or call 555-1234.";

        PiiEntity email = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(20)
                .endOffset(36)
                .score(0.99f)
                .build();

        PiiEntity phone = PiiEntity.builder()
                .type(PiiEntityType.PHONE)
                .beginOffset(45)
                .endOffset(53)
                .score(0.99f)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(email, phone)).build());

        String result = redactor.redact(input);
        assertEquals("Contact John Doe at [EMAIL] or call [PHONE].", result);
    }

    @Test
    void testRedactWithCustomMask() {
        String input = "My email is test@test.com";

        PiiEntity email = PiiEntity.builder()
                .type(PiiEntityType.EMAIL)
                .beginOffset(12)
                .endOffset(25)
                .score(0.99f)
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(List.of(email)).build());

        String result = redactor.redactWithMask(input, "[REDACTED]");
        assertEquals("My email is [REDACTED]", result);
    }
}
