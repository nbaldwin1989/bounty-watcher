package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Collections;
import java.util.List;

public class RedactedResult {

    private final String originalText;
    private final String redactedText;
    private final List<PiiEntity> detectedEntities;

    public RedactedResult(String originalText, String redactedText, List<PiiEntity> detectedEntities) {
        this.originalText = originalText;
        this.redactedText = redactedText;
        this.detectedEntities = detectedEntities != null 
            ? Collections.unmodifiableList(detectedEntities) 
            : Collections.emptyList();
    }

    public String getOriginalText() {
        return originalText;
    }

    public String getRedactedText() {
        return redactedText;
    }

    public List<PiiEntity> getDetectedEntities() {
        return detectedEntities;
    }

    public boolean hasPii() {
        return !detectedEntities.isEmpty();
    }
}
