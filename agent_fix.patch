package com.edgechains.lib.utils;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

class AwsComprehendRedactorTest {

    private ComprehendClient mockClient;
    private AwsComprehendRedactor redactor;

    @BeforeEach
    void setUp() {
        mockClient = Mockito.mock(ComprehendClient.class);
        redactor = new AwsComprehendRedactor(mockClient, 0.5f);
    }

    @AfterEach
    void tearDown() {
        redactor.close();
    }

    @Test
    void testRedactEntityType() {
        String input = "Hello, my email is test@example.com and phone is 555-0199.";

        PiiEntity email = PiiEntity.builder()
                .beginOffset(19)
                .endOffset(35)
                .score(0.99f)
                .type(PiiEntityType.EMAIL)
                .build();

        PiiEntity phone = PiiEntity.builder()
                .beginOffset(50)
                .endOffset(58)
                .score(0.95f)
                .type(PiiEntityType.PHONE)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(email, phone))
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redact(input, LanguageCode.EN, AwsComprehendRedactor.RedactionMode.ENTITY_TYPE);
        assertEquals("Hello, my email is [EMAIL] and phone is [PHONE].", result);
    }

    @Test
    void testRedactFixedMask() {
        String input = "Contact John Doe immediately.";

        PiiEntity name = PiiEntity.builder()
                .beginOffset(8)
                .endOffset(16)
                .score(0.98f)
                .type(PiiEntityType.NAME)
                .build();

        DetectPiiEntitiesResponse response = DetectPiiEntitiesResponse.builder()
                .entities(List.of(name))
                .build();

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class))).thenReturn(response);

        String result = redactor.redact(input, LanguageCode.EN, AwsComprehendRedactor.RedactionMode.FIXED_MASK, "[CONFIDENTIAL]");
        assertEquals("Contact [CONFIDENTIAL] immediately.", result);
    }
}
