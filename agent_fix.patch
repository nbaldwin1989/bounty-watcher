### Solution 1: AWS Comprehend Data Redaction Utility (`EdgeChains/issues/290`)

#### 1. Add AWS Comprehend dependency (`build.gradle`)
```groovy
dependencies {
    implementation platform('software.amazon.awssdk:bom:2.25.16')
    implementation 'software.amazon.awssdk:comprehend'
    testImplementation 'org.junit.jupiter:junit-jupiter:5.10.2'
    testImplementation 'org.mockito:mockito-core:5.11.0'
    testImplementation 'org.mockito:mockito-junit-jupiter:5.11.0'
}
```

#### 2. Service Implementation (`AwsComprehendRedactionService.java`)
```java
package com.edgechains.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.stream.Collectors;

/**
 * Utility service using AWS Comprehend to detect and redact Personally Identifiable Information (PII).
 */
public class AwsComprehendRedactionService implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final float defaultMinScore;
    private final LanguageCode defaultLanguageCode;

    public enum RedactionStrategy {
        MASK_WITH_ENTITY_TYPE, // e.g., [NAME], [EMAIL], [SSN]
        MASK_WITH_TAG,         // e.g., [REDACTED]
        MASK_WITH_ASTERISKS    // e.g., ******* (matching length)
    }

    public AwsComprehendRedactionService(Region region) {
        this(region, DefaultCredentialsProvider.create(), 0.75f, LanguageCode.EN);
    }

    public AwsComprehendRedactionService(Region region, AwsCredentialsProvider credentialsProvider,
                                         float defaultMinScore, LanguageCode defaultLanguageCode) {
        this.comprehendClient = ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build();
        this.defaultMinScore = defaultMinScore;
        this.defaultLanguageCode = defaultLanguageCode;
    }

    public AwsComprehendRedactionService(ComprehendClient comprehendClient, float defaultMinScore, LanguageCode defaultLanguageCode) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.defaultMinScore = defaultMinScore;
        this.defaultLanguageCode = defaultLanguageCode;
    }

    public String redact(String text) {
        return redact(text, defaultLanguageCode, defaultMinScore, RedactionStrategy.MASK_WITH_TAG);
    }

    public String redact(String text, RedactionStrategy strategy) {
        return redact(text, defaultLanguageCode, defaultMinScore, strategy);
    }

    public String redact(String text, LanguageCode languageCode, float minConfidence, RedactionStrategy strategy) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : defaultLanguageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        return applyRedaction(text, response.entities(), minConfidence, strategy);
    }

    public String applyRedaction(String text, List<PiiEntity> entities, float minConfidence, RedactionStrategy strategy) {
        if (entities == null || entities.isEmpty()) {
            return text;
        }

        List<PiiEntity> validEntities = entities.stream()
                .filter(e -> e.score() >= minConfidence)
                .filter(e -> e.beginOffset() != null && e.endOffset() != null)
                .filter(e -> e.beginOffset() >= 0 && e.endOffset() <= text.length() && e.beginOffset() < e.endOffset())
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder redacted = new StringBuilder(text);
        int lastProcessedStart = Integer.MAX_VALUE;

        for (PiiEntity entity : validEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Prevent corrupted replacement on overlapping entities
            if (end <= lastProcessedStart) {
                String replacement = resolveReplacement(entity, text.substring(start, end), strategy);
                redacted.replace(start, end, replacement);
                lastProcessedStart = start;
            }
        }

        return redacted.toString();
    }

    private String resolveReplacement(PiiEntity entity, String originalSubstring, RedactionStrategy strategy) {
        switch (strategy) {
            case MASK_WITH_ENTITY_TYPE:
                String entityType = entity.typeAsString() != null ? entity.typeAsString() : "PII";
                return "[" + entityType + "]";
            case MASK_WITH_ASTERISKS:
                return "*".repeat(originalSubstring.length());
            case MASK_WITH_TAG:
            default:
                return "[REDACTED]";
        }
    }

    @Override
    public void close() {
        if (comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
```

#### 3. Unit Test (`AwsComprehendRedactionServiceTest.java`)
```java
package com.edgechains.lib.aws;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
public class AwsComprehendRedactionServiceTest {

    @Mock
    private ComprehendClient comprehendClient;

    private AwsComprehendRedactionService service;

    @BeforeEach
    void setUp() {
        service = new AwsComprehendRedactionService(comprehendClient, 0.8f, LanguageCode.EN);
    }

    @Test
    void testRedactWithTag() {
        String input = "Contact John Doe at john@example.com for info.";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(8).endOffset(16).type(PiiEntityType.NAME).score(0.99f).build(),
                PiiEntity.builder().beginOffset(20).endOffset(36).type(PiiEntityType.EMAIL).score(0.95f).build()
        );

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        String result = service.redact(input, AwsComprehendRedactionService.RedactionStrategy.MASK_WITH_TAG);
        assertEquals("Contact [REDACTED] at [REDACTED] for info.", result);
    }

    @Test
    void testRedactWithEntityType() {
        String input = "My email is test@domain.com";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(12).endOffset(27).type(PiiEntityType.EMAIL).score(0.98f).build()
        );

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        String result = service.redact(input, AwsComprehendRedactionService.RedactionStrategy.MASK_WITH_ENTITY_TYPE);
        assertEquals("My email is [EMAIL]", result);
    }

    @Test
    void testLowConfidenceIgnored() {
        String input = "My phone is 123-456-7890";
        List<PiiEntity> entities = List.of(
                PiiEntity.builder().beginOffset(12).endOffset(24).type(PiiEntityType.PHONE).score(0.50f).build()
        );

        when(comprehendClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(entities).build());

        String result = service.redact(input);
        assertEquals(input, result);
    }
}
```

