package com.edgechains.lib.aws;

import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.Set;
import java.util.stream.Collectors;

/**
 * Utility for detecting and redacting Personally Identifiable Information (PII)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactionUtil implements AutoCloseable {

    public enum RedactionStrategy {
        LABEL,       // Replaces entity with [ENTITY_TYPE], e.g. [EMAIL], [SSN]
        MASK,        // Replaces entity with [REDACTED]
        CHARACTER    // Replaces each character with a mask character (e.g. '*')
    }

    private final ComprehendClient comprehendClient;
    private final boolean ownsClient;

    public AwsComprehendRedactionUtil() {
        this(ComprehendClient.builder()
                .credentialsProvider(DefaultCredentialsProvider.create())
                .region(Region.US_EAST_1)
                .build(), true);
    }

    public AwsComprehendRedactionUtil(Region region, AwsCredentialsProvider credentialsProvider) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build(), true);
    }

    public AwsComprehendRedactionUtil(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactionUtil(ComprehendClient comprehendClient, boolean ownsClient) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.ownsClient = ownsClient;
    }

    /**
     * Redacts all PII entities using default settings (Strategy: LABEL, Lang: EN, MinScore: 0.7).
     */
    public String redactPii(String text) {
        return redactPii(text, LanguageCode.EN, RedactionStrategy.LABEL, null, 0.7f, '*');
    }

    /**
     * Redacts PII entities matching target entity types with custom strategy and score threshold.
     */
    public String redactPii(
            String text,
            LanguageCode languageCode,
            RedactionStrategy strategy,
            Set<PiiEntityType> targetTypes,
            float minConfidenceScore,
            char maskCharacter) {

        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : LanguageCode.EN)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        List<PiiEntity> filtered = entities.stream()
                .filter(e -> e.score() != null && e.score() >= minConfidenceScore)
                .filter(e -> targetTypes == null || targetTypes.isEmpty() || targetTypes.contains(e.type()))
                .collect(Collectors.toList());

        if (filtered.isEmpty()) {
            return text;
        }

        List<PiiEntity> sorted = resolveOverlapsAndSortDescending(filtered);

        StringBuilder redacted = new StringBuilder(text);
        for (PiiEntity entity : sorted) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            if (start < 0 || end > redacted.length() || start >= end) {
                continue;
            }

            String replacement;
            switch (strategy) {
                case LABEL:
                    replacement = "[" + (entity.typeAsString() != null ? entity.typeAsString() : "PII") + "]";
                    break;
                case CHARACTER:
                    int length = end - start;
                    replacement = String.valueOf(maskCharacter).repeat(length);
                    break;
                case MASK:
                default:
                    replacement = "[REDACTED]";
                    break;
            }

            redacted.replace(start, end, replacement);
        }

        return redacted.toString();
    }

    public List<PiiEntity> detectPii(String text, LanguageCode languageCode) {
        if (text == null || text.trim().isEmpty()) {
            return List.of();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(languageCode != null ? languageCode : LanguageCode.EN)
                .build();

        return comprehendClient.detectPiiEntities(request).entities();
    }

    private List<PiiEntity> resolveOverlapsAndSortDescending(List<PiiEntity> entities) {
        List<PiiEntity> sortedAsc = new ArrayList<>(entities);
        sortedAsc.sort(Comparator.comparingInt(PiiEntity::beginOffset)
                .thenComparing((a, b) -> Integer.compare(b.endOffset(), a.endOffset())));

        List<PiiEntity> nonOverlapping = new ArrayList<>();
        int lastEnd = -1;

        for (PiiEntity entity : sortedAsc) {
            if (entity.beginOffset() >= lastEnd) {
                nonOverlapping.add(entity);
                lastEnd = entity.endOffset();
            }
        }

        nonOverlapping.sort((a, b) -> Integer.compare(b.beginOffset(), a.beginOffset()));
        return nonOverlapping;
    }

    @Override
    public void close() {
        if (ownsClient && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
