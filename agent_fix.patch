### 1. arakoodev/EdgeChains #290: AWS Comprehend Data Redaction Utility

#### `src/main/java/com/edgechains/lib/aws/AwsComprehendRedactor.java`
```java
package com.edgechains.lib.aws;

import java.util.*;
import java.util.stream.Collectors;
import software.amazon.awssdk.auth.credentials.AwsCredentialsProvider;
import software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider;
import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

/**
 * Utility service integrating AWS Comprehend to detect and redact
 * Personally Identifiable Information (PII) from prompt text and logs.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    public enum MaskStrategy {
        PLACEHOLDER, // Replaces with a fixed string, e.g. [REDACTED]
        ENTITY_TAG,  // Replaces with the detected entity type, e.g. [EMAIL], [PHONE]
        ASTERISKS    // Replaces each character with '*' matching the original length
    }

    public static class RedactionConfig {
        private final MaskStrategy maskStrategy;
        private final String defaultPlaceholder;
        private final float minConfidenceScore;
        private final LanguageCode languageCode;
        private final Set<PiiEntityType> targetEntityTypes;

        private RedactionConfig(Builder builder) {
            this.maskStrategy = builder.maskStrategy;
            this.defaultPlaceholder = builder.defaultPlaceholder;
            this.minConfidenceScore = builder.minConfidenceScore;
            this.languageCode = builder.languageCode;
            this.targetEntityTypes = builder.targetEntityTypes;
        }

        public MaskStrategy getMaskStrategy() { return maskStrategy; }
        public String getDefaultPlaceholder() { return defaultPlaceholder; }
        public float getMinConfidenceScore() { return minConfidenceScore; }
        public LanguageCode getLanguageCode() { return languageCode; }
        public Set<PiiEntityType> getTargetEntityTypes() { return targetEntityTypes; }

        public static Builder builder() {
            return new Builder();
        }

        public static RedactionConfig defaultConfig() {
            return builder().build();
        }

        public static class Builder {
            private MaskStrategy maskStrategy = MaskStrategy.ENTITY_TAG;
            private String defaultPlaceholder = "[REDACTED]";
            private float minConfidenceScore = 0.5f;
            private LanguageCode languageCode = LanguageCode.EN;
            private Set<PiiEntityType> targetEntityTypes = Collections.emptySet();

            public Builder maskStrategy(MaskStrategy maskStrategy) {
                this.maskStrategy = Objects.requireNonNull(maskStrategy);
                return this;
            }

            public Builder defaultPlaceholder(String defaultPlaceholder) {
                this.defaultPlaceholder = Objects.requireNonNull(defaultPlaceholder);
                return this;
            }

            public Builder minConfidenceScore(float score) {
                this.minConfidenceScore = score;
                return this;
            }

            public Builder languageCode(LanguageCode languageCode) {
                this.languageCode = Objects.requireNonNull(languageCode);
                return this;
            }

            public Builder targetEntityTypes(Set<PiiEntityType> types) {
                this.targetEntityTypes = types != null ? types : Collections.emptySet();
                return this;
            }

            public RedactionConfig build() {
                return new RedactionConfig(this);
            }
        }
    }

    private final ComprehendClient comprehendClient;
    private final boolean ownsClient;
    private final RedactionConfig defaultConfig;

    public AwsComprehendRedactor(Region region) {
        this(region, DefaultCredentialsProvider.create(), RedactionConfig.defaultConfig());
    }

    public AwsComprehendRedactor(Region region, AwsCredentialsProvider credentialsProvider, RedactionConfig defaultConfig) {
        this(ComprehendClient.builder()
                .region(region)
                .credentialsProvider(credentialsProvider)
                .build(), true, defaultConfig);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false, RedactionConfig.defaultConfig());
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, boolean ownsClient, RedactionConfig defaultConfig) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "ComprehendClient cannot be null");
        this.ownsClient = ownsClient;
        this.defaultConfig = defaultConfig != null ? defaultConfig : RedactionConfig.defaultConfig();
    }

    /**
     * Detects all PII entities in the provided text using default configuration.
     */
    public List<PiiEntity> detectPii(String text) {
        return detectPii(text, this.defaultConfig);
    }

    /**
     * Detects PII entities matching the specified configuration criteria.
     */
    public List<PiiEntity> detectPii(String text, RedactionConfig config) {
        if (text == null || text.isBlank()) {
            return Collections.emptyList();
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(config.getLanguageCode())
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        if (response == null || !response.hasEntities()) {
            return Collections.emptyList();
        }

        return response.entities().stream()
                .filter(e -> e.score() >= config.getMinConfidenceScore())
                .filter(e -> config.getTargetEntityTypes().isEmpty() || config.getTargetEntityTypes().contains(e.type()))
                .collect(Collectors.toList());
    }

    /**
     * Redacts PII entities in the provided text using default configuration.
     */
    public String redact(String text) {
        return redact(text, this.defaultConfig);
    }

    /**
     * Redacts PII entities from the text according to the given configuration.
     */
    public String redact(String text, RedactionConfig config) {
        if (text == null || text.isBlank()) {
            return text;
        }

        List<PiiEntity> entities = detectPii(text, config);
        if (entities.isEmpty()) {
            return text;
        }

        // Sort descending by beginOffset to replace from end to beginning without altering preceding indices
        List<PiiEntity> sortedEntities = entities.stream()
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder sb = new StringBuilder(text);
        int lastProcessedStart = Integer.MAX_VALUE;

        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Validate boundaries and prevent overlapping replacements
            if (start < 0 || end > sb.length() || start >= end || end > lastProcessedStart) {
                continue;
            }

            String replacement = getReplacement(entity, end - start, config);
            sb.replace(start, end, replacement);
            lastProcessedStart = start;
        }

        return sb.toString();
    }

    private String getReplacement(PiiEntity entity, int originalLength, RedactionConfig config) {
        switch (config.getMaskStrategy()) {
            case ASTERISKS:
                return "*".repeat(originalLength);
            case PLACEHOLDER:
                return config.getDefaultPlaceholder();
            case ENTITY_TAG:
            default:
                return "[" + (entity.type() != null ? entity.type().toString() : "PII") + "]";
        }
    }

    @Override
    public void close() {
        if (ownsClient && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
