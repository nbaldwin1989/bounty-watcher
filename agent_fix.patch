```python
"""
Python alternative utility for AWS Comprehend PII redaction.
"""
from enum import Enum
from typing import Optional
import boto3


class RedactionStrategy(Enum):
    REPLACE_WITH_TAG = "REPLACE_WITH_TAG"  # [EMAIL], [NAME], etc.
    REPLACE_REDACTED = "REPLACE_REDACTED"  # [REDACTED]
    MASK_ASTERISKS = "MASK_ASTERISKS"      # ********


class ComprehendRedactor:
    def __init__(
        self,
        region_name: str = "us-east-1",
        comprehend_client=None,
        min_score_threshold: float = 0.5,
    ):
        self.client = comprehend_client or boto3.client("comprehend", region_name=region_name)
        self.min_score_threshold = min_score_threshold

    def redact(
        self,
        text: str,
        language_code: str = "en",
        strategy: RedactionStrategy = RedactionStrategy.REPLACE_WITH_TAG,
    ) -> str:
        if not text:
            return text

        response = self.client.detect_pii_entities(
            Text=text,
            LanguageCode=language_code,
        )

        entities = [
            e for e in response.get("Entities", [])
            if e.get("Score", 0) >= self.min_score_threshold
        ]

        # Sort reverse by BeginOffset so string indices remain consistent
        entities.sort(key=lambda x: x["BeginOffset"], reverse=True)

        redacted_text = text
        for entity in entities:
            start = entity["BeginOffset"]
            end = entity["EndOffset"]
            entity_type = entity.get("Type", "PII")

            if strategy == RedactionStrategy.MASK_ASTERISKS:
                replacement = "*" * (end - start)
            elif strategy == RedactionStrategy.REPLACE_REDACTED:
                replacement = "[REDACTED]"
            else:
                replacement = f"[{entity_type}]"

            redacted_text = redacted_text[:start] + replacement + redacted_text[end:]

        return redacted_text
