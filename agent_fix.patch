package com.edgechains.utils;

import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.LanguageCode;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;

import java.util.Comparator;
import java.util.List;

/**
 * Utility for detecting and redacting PII (Personally Identifiable Information)
 * using AWS Comprehend.
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private final ComprehendClient comprehendClient;
    private final LanguageCode languageCode;
    private final boolean manageClientLifecycle;

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), LanguageCode.EN, true);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, LanguageCode.EN, false);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient, LanguageCode languageCode) {
        this(comprehendClient, languageCode, false);
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, LanguageCode languageCode, boolean manageClientLifecycle) {
        this.comprehendClient = comprehendClient;
        this.languageCode = languageCode;
        this.manageClientLifecycle = manageClientLifecycle;
    }

    /**
     * Redacts detected PII entities with a default mask '[REDACTED]'.
     *
     * @param text Raw text containing potential PII.
     * @return Redacted text.
     */
    public String redactPii(String text) {
        return redactPii(text, "[REDACTED]");
    }

    /**
     * Redacts detected PII entities with the specified mask.
     * If mask is '[TYPE]', each entity is replaced with its entity type tag (e.g. '[NAME]', '[SSN]').
     *
     * @param text Raw text containing potential PII.
     * @param mask Replacement token or '[TYPE]' for entity-type specific masking.
     * @return Redacted text.
     */
    public String redactPii(String text, String mask) {
        if (text == null || text.trim().isEmpty()) {
            return text;
        }

        DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(this.languageCode)
                .build();

        DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
        List<PiiEntity> entities = response.entities();

        if (entities == null || entities.isEmpty()) {
            return text;
        }

        // Sort entities descending by beginOffset to safely replace substrings in-place
        List<PiiEntity> sortedEntities = entities.stream()
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .toList();

        StringBuilder result = new StringBuilder(text);
        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();
            String replacement = "[TYPE]".equalsIgnoreCase(mask)
                    ? "[" + entity.typeAsString() + "]"
                    : mask;
            result.replace(start, end, replacement);
        }

        return result.toString();
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
