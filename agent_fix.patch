// File: src/test/java/com/edgechains/lib/comprehend/AwsComprehendRedactorTest.java

package com.edgechains.lib.comprehend;

import org.junit.jupiter.api.Test;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class AwsComprehendRedactorTest {

    @Test
    public void testRedactPiiEntities() {
        ComprehendClient mockClient = mock(ComprehendClient.class);
        String originalText = "Contact Jane Doe at jane.doe@example.com or 555-0199.";

        List<PiiEntity> mockedEntities = List.of(
                PiiEntity.builder().type(PiiEntityType.NAME).score(0.99f).beginOffset(8).endOffset(16).build(),
                PiiEntity.builder().type(PiiEntityType.EMAIL).score(0.98f).beginOffset(20).endOffset(40).build(),
                PiiEntity.builder().type(PiiEntityType.PHONE).score(0.95f).beginOffset(44).endOffset(52).build()
        );

        when(mockClient.detectPiiEntities(any(DetectPiiEntitiesRequest.class)))
                .thenReturn(DetectPiiEntitiesResponse.builder().entities(mockedEntities).build());

        AwsComprehendRedactor redactor = new AwsComprehendRedactor(mockClient, 0.5f, software.amazon.awssdk.services.comprehend.model.LanguageCode.EN);

        String result = redactor.redact(originalText);
        assertEquals("Contact [REDACTED_NAME] at [REDACTED_EMAIL] or [REDACTED_PHONE].", result);
    }
}
