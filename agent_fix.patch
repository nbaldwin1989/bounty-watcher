// src/main/java/com/edgechains/lib/aws/comprehend/AwsComprehendRedactor.java
package com.edgechains.lib.aws.comprehend;

import software.amazon.awssdk.regions.Region;
import software.amazon.awssdk.services.comprehend.ComprehendClient;
import software.amazon.awssdk.services.comprehend.model.ContainsPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.ContainsPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesRequest;
import software.amazon.awssdk.services.comprehend.model.DetectPiiEntitiesResponse;
import software.amazon.awssdk.services.comprehend.model.PiiEntity;
import software.amazon.awssdk.services.comprehend.model.PiiEntityType;

import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Objects;
import java.util.stream.Collectors;

/**
 * Utility integrating AWS Comprehend to detect and redact Personally Identifiable Information (PII).
 */
public class AwsComprehendRedactor implements AutoCloseable {

    private static final int AWS_COMPREHEND_MAX_BYTES = 4800; // API hard limit is 5,000 UTF-8 bytes

    private final ComprehendClient comprehendClient;
    private final boolean manageClientLifecycle;

    public AwsComprehendRedactor() {
        this(ComprehendClient.builder().region(Region.US_EAST_1).build(), true);
    }

    public AwsComprehendRedactor(Region region) {
        this(ComprehendClient.builder().region(region).build(), true);
    }

    public AwsComprehendRedactor(ComprehendClient comprehendClient) {
        this(comprehendClient, false);
    }

    private AwsComprehendRedactor(ComprehendClient comprehendClient, boolean manageClientLifecycle) {
        this.comprehendClient = Objects.requireNonNull(comprehendClient, "comprehendClient must not be null");
        this.manageClientLifecycle = manageClientLifecycle;
    }

    /**
     * Checks if text contains PII entities.
     */
    public boolean containsPii(String text, RedactionConfig config) {
        if (text == null || text.isBlank()) {
            return false;
        }

        if (text.getBytes(StandardCharsets.UTF_8).length > AWS_COMPREHEND_MAX_BYTES) {
            return !detectPii(text, config).isEmpty();
        }

        ContainsPiiEntitiesRequest request = ContainsPiiEntitiesRequest.builder()
                .text(text)
                .languageCode(config.getLanguageCode())
                .build();

        ContainsPiiEntitiesResponse response = comprehendClient.containsPiiEntities(request);
        return !response.labels().isEmpty();
    }

    /**
     * Detects PII entities in the input text with filtering applied according to config.
     */
    public List<PiiEntity> detectPii(String text, RedactionConfig config) {
        if (text == null || text.isBlank()) {
            return List.of();
        }

        List<PiiEntity> rawEntities;
        if (text.getBytes(StandardCharsets.UTF_8).length > AWS_COMPREHEND_MAX_BYTES) {
            rawEntities = detectPiiChunked(text, config);
        } else {
            DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                    .text(text)
                    .languageCode(config.getLanguageCode())
                    .build();
            DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
            rawEntities = response.entities();
        }

        return rawEntities.stream()
                .filter(entity -> entity.score() == null || entity.score() >= config.getMinConfidenceScore())
                .filter(entity -> config.getIncludedEntityTypes().isEmpty()
                        || config.getIncludedEntityTypes().contains(entity.type()))
                .filter(entity -> !config.getExcludedEntityTypes().contains(entity.type()))
                .collect(Collectors.toList());
    }

    /**
     * Redacts PII using default configuration.
     */
    public RedactedResult redact(String text) {
        return redact(text, RedactionConfig.defaultConfig());
    }

    /**
     * Redacts PII from text using provided configuration.
     */
    public RedactedResult redact(String text, RedactionConfig config) {
        if (text == null || text.isEmpty()) {
            return new RedactedResult(text, text, List.of());
        }

        List<PiiEntity> filteredEntities = detectPii(text, config);
        if (filteredEntities.isEmpty()) {
            return new RedactedResult(text, text, List.of());
        }

        // Sort descending by beginOffset so replacements do not invalidate earlier offsets
        List<PiiEntity> sortedEntities = filteredEntities.stream()
                .sorted(Comparator.comparingInt(PiiEntity::beginOffset).reversed())
                .collect(Collectors.toList());

        StringBuilder redacted = new StringBuilder(text);
        int lastStart = Integer.MAX_VALUE;

        for (PiiEntity entity : sortedEntities) {
            int start = entity.beginOffset();
            int end = entity.endOffset();

            // Validate boundaries and prevent overlap collision
            if (start < 0 || end > text.length() || start >= end || end > lastStart) {
                continue;
            }
            lastStart = start;

            String replacement = createMask(entity, config, end - start);
            redacted.replace(start, end, replacement);
        }

        return new RedactedResult(text, redacted.toString(), filteredEntities);
    }

    private String createMask(PiiEntity entity, RedactionConfig config, int originalLength) {
        switch (config.getMaskStrategy()) {
            case ENTITY_TYPE_LABEL:
                PiiEntityType type = entity.type();
                return "[" + (type != null ? type.name() : "PII") + "]";
            case FIXED_LABEL:
                return config.getFixedLabel();
            case FIXED_ASTERISKS:
                return "***";
            case ASTERISKS_MATCH_LENGTH:
                return "*".repeat(Math.max(1, originalLength));
            default:
                return "[REDACTED]";
        }
    }

    private List<PiiEntity> detectPiiChunked(String text, RedactionConfig config) {
        List<PiiEntity> aggregated = new ArrayList<>();
        int chunkStart = 0;
        int textLength = text.length();

        while (chunkStart < textLength) {
            int chunkEnd = Math.min(chunkStart + 1000, textLength);
            while (chunkEnd < textLength
                    && text.substring(chunkStart, chunkEnd).getBytes(StandardCharsets.UTF_8).length < AWS_COMPREHEND_MAX_BYTES) {
                chunkEnd = Math.min(chunkEnd + 200, textLength);
            }

            // Adjust chunkEnd backwards to whitespace or punctuation if not at end of text
            if (chunkEnd < textLength) {
                int lastSpace = text.lastIndexOf(' ', chunkEnd);
                if (lastSpace > chunkStart) {
                    chunkEnd = lastSpace + 1;
                }
            }

            String chunk = text.substring(chunkStart, chunkEnd);
            DetectPiiEntitiesRequest request = DetectPiiEntitiesRequest.builder()
                    .text(chunk)
                    .languageCode(config.getLanguageCode())
                    .build();

            DetectPiiEntitiesResponse response = comprehendClient.detectPiiEntities(request);
            final int currentOffset = chunkStart;

            for (PiiEntity entity : response.entities()) {
                PiiEntity adjusted = entity.toBuilder()
                        .beginOffset(entity.beginOffset() + currentOffset)
                        .endOffset(entity.endOffset() + currentOffset)
                        .build();
                aggregated.add(adjusted);
            }

            chunkStart = chunkEnd;
        }

        return aggregated;
    }

    @Override
    public void close() {
        if (manageClientLifecycle && comprehendClient != null) {
            comprehendClient.close();
        }
    }
}
